---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import Prose from '@/components/Prose.astro';
import { SITE } from '@/config/site';

export async function getStaticPaths() {
  const entries = await getCollection('ratgeber');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'ratgeber'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, hero } = entry.data;

/** Lesezeit aus dem Rohtext: ~220 Wörter pro Minute */
const wortzahl = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const lesezeit = Math.max(1, Math.round(wortzahl / 220));

const datum = pubDate.toLocaleDateString('de-DE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const canonical = `${SITE.url}/ratgeber/${entry.id}/`;

const breadcrumbs = [
  { name: 'Ratgeber', href: '/ratgeber/' },
  { name: title, href: `/ratgeber/${entry.id}/` },
];

/** „Weiterlesen“: die zwei aktuellsten anderen Artikel */
const weiterlesen = (await getCollection('ratgeber'))
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  inLanguage: 'de-DE',
  image: hero.src,
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: canonical,
};
---

<BaseLayout
  title={entry.data.seoTitle}
  fullTitle
  description={entry.data.seoDescription}
  ogImage={hero.src}
  breadcrumbs={breadcrumbs}
  jsonLd={[articleLd]}
  hideFooterCta
>
  <!-- Seitenkopf -->
  <section class="container-site pt-12 lg:pt-16">
    <Breadcrumbs items={breadcrumbs} class="mb-10" />
    <div class="grid gap-x-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h1 class="font-display text-hero font-medium">{title}</h1>
        <p class="tnum mt-5 text-small text-muted">
          Aktualisiert am {datum} · Lesezeit ca. {lesezeit} Min.
        </p>
      </div>
    </div>
  </section>

  <!-- Hero-Bild, volle Breite -->
  <div class="mt-10 lg:mt-14">
    <Figure
      src={hero.src}
      alt={hero.alt}
      ratio="aspect-[3/2] sm:aspect-[21/9]"
      sizes="100vw"
      eager
      reveal={false}
      class="w-full"
    />
  </div>

  <!-- Artikel + Randnotiz -->
  <section class="container-site pt-14 pb-(--spacing-section) lg:pt-20">
    <div class="grid gap-x-8 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Prose>
          <Content />
        </Prose>
      </div>

      <aside class="lg:col-span-3 lg:col-start-10">
        <h2 class="text-caption font-medium text-muted">Über diesen Artikel</h2>
        <dl class="mt-4 divide-y divide-line border-y border-line">
          <div class="py-4">
            <dt class="text-caption text-muted">Geschrieben von</dt>
            <dd class="mt-1 text-small font-medium">der Bauberatung von {SITE.name}</dd>
          </div>
          <div class="py-4">
            <dt class="text-caption text-muted">Aktualisiert am</dt>
            <dd class="tnum mt-1 text-small font-medium">{datum}</dd>
          </div>
        </dl>
        <p class="mt-4 text-caption text-muted">
          Wir prüfen Zahlen und Förderkonditionen laufend und aktualisieren diesen Artikel,
          sobald sich Rechtslage oder Marktpreise ändern.
        </p>
      </aside>
    </div>
  </section>

  <!-- Weiterlesen -->
  {weiterlesen.length > 0 && (
    <section class="container-site pb-(--spacing-section)">
      <div class="border-t border-line pt-10">
        <h2 class="text-caption font-medium text-muted">Weiterlesen</h2>
        <div class="mt-6 grid gap-x-8 gap-y-10 lg:grid-cols-12">
          {weiterlesen.map((artikel, i) => (
            <a
              href={`/ratgeber/${artikel.id}/`}
              class:list={['group block', i === 0 ? 'lg:col-span-6' : 'lg:col-span-5 lg:col-start-8']}
            >
              <p class="tnum text-caption text-muted">
                {artikel.data.pubDate.toLocaleDateString('de-DE', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </p>
              <p class="mt-2 font-display text-title font-medium">
                <span class="link-line">{artikel.data.title}</span>
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Abschluss-CTA -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Vom Wissen zum konkreten Projekt
        </h2>
        <p class="reveal prose-measure mt-6 text-body text-muted">
          Zahlen lesen ist der erste Schritt – der zweite ist die Rechnung für Ihr
          Grundstück und Ihren Grundriss. Im Erstgespräch klären wir Budget, Förderung
          und Zeitplan, unverbindlich und ohne Verkaufsdruck.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 lg:col-span-4 lg:col-start-9 lg:justify-end">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/ratgeber/" class="link-line text-small font-medium">Alle Ratgeber-Artikel</a>
      </div>
    </div>
  </section>
</BaseLayout>
