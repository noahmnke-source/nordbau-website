---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';

const artikel = (await getCollection('ratgeber')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

/** Editorial-Prinzip: der neueste Artikel groß, alle weiteren als typografische Liste. */
const featured = artikel[0];
const weitere = artikel.slice(1);

const datum = (date: Date) =>
  date.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Fertighaus-Ratgeber: Förderung & Preise 2026"
  description="Fertighaus-Ratgeber mit konkreten Zahlen für 2026: Preise pro m², KfW-Förderung, Fertighaus oder Massivhaus, Ausbaustufen – geschrieben von unserer Bauberatung."
  ogImage={featured?.data.hero.src}
  breadcrumbs={[{ name: 'Ratgeber', href: '/ratgeber/' }]}
  hideFooterCta
>
  <!-- Seitenkopf -->
  <section class="container-site pt-12 lg:pt-16">
    <Breadcrumbs items={[{ name: 'Ratgeber', href: '/ratgeber/' }]} class="mb-10" />

    <div class="grid gap-x-8 gap-y-6 lg:grid-cols-12">
      <h1 class="font-display text-hero font-medium lg:col-span-7">
        Ratgeber: Wissen für Ihre Bauentscheidung
      </h1>
      <p class="prose-measure self-end text-body text-muted lg:col-span-4 lg:col-start-9">
        Preise, Förderung, Bauweise: Diese Artikel beantworten die Fragen, die vor dem
        Bauvertrag anstehen – geschrieben von unserer Bauberatung, mit konkreten Zahlen
        für 2026 und aktualisiert, sobald sich Förderkonditionen oder Rechtslage ändern.
      </p>
    </div>
  </section>

  <!-- Neuester Artikel, groß -->
  {featured && (
    <section class="container-site pt-16 lg:pt-24">
      <a
        href={`/ratgeber/${featured.id}/`}
        class="group grid gap-x-8 gap-y-6 lg:grid-cols-12 lg:items-end"
      >
        <Figure
          src={featured.data.hero.src}
          alt={featured.data.hero.alt}
          ratio="aspect-[3/2]"
          sizes="(min-width: 1024px) 62vw, 100vw"
          zoom
          class="lg:col-span-8"
        />
        <div class="lg:col-span-4">
          <p class="tnum text-caption text-muted">
            Aktualisiert am {datum(featured.data.pubDate)}
          </p>
          <h2 class="mt-3 font-display text-display font-medium">
            <span class="link-line">{featured.data.title}</span>
          </h2>
          <p class="prose-measure mt-4 text-small text-muted">{featured.data.description}</p>
        </div>
      </a>
    </section>
  )}

  <!-- Weitere Artikel: typografische Liste mit Hairlines -->
  {weitere.length > 0 && (
    <section class="container-site pt-16 pb-(--spacing-section) lg:pt-24">
      <div class="divide-y divide-line border-y border-line">
        {weitere.map((eintrag) => (
          <a
            href={`/ratgeber/${eintrag.id}/`}
            class="group grid gap-x-8 gap-y-2 py-8 lg:grid-cols-12 lg:items-baseline"
          >
            <p class="tnum text-caption text-muted lg:col-span-2">
              {datum(eintrag.data.pubDate)}
            </p>
            <div class="lg:col-span-9 lg:col-start-4">
              <h2 class="font-display text-title font-medium">
                <span class="link-line">{eintrag.data.title}</span>
              </h2>
              <p class="mt-2 line-clamp-1 text-small text-muted">{eintrag.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Abschluss: Hinweis + CTA -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Ihre Frage ist hier nicht beantwortet?
        </h2>
        <p class="reveal prose-measure mt-6 text-body text-muted">
          Manche Fragen lassen sich nur am konkreten Projekt klären – Grundstück, Budget,
          Förderung. Im Erstgespräch beantworten wir sie persönlich, unverbindlich und
          mit denselben ehrlichen Zahlen wie in diesen Artikeln.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 lg:col-span-4 lg:col-start-9 lg:justify-end">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/haustypen/" class="link-line text-small font-medium">Haustypen ansehen</a>
      </div>
    </div>
  </section>
</BaseLayout>
