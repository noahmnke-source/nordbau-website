---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import Prose from '@/components/Prose.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { SITE } from '@/config/site';
import { buildFaqJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('standorte');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'standorte'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, kurzname, hero, intro, cities, faq } = entry.data;

/**
 * Nachbar- und Eltern-Kind-Verweise nach docs/research/geo.json:
 * Bundesland ↔ zugehörige Metropolregion, dazu angrenzende Regionen.
 * Bewusst kuratiert (max. 3–4) statt Vollvernetzung aller Regionen.
 */
const verweise: Record<string, string[]> = {
  'bayern': ['muenchen', 'baden-wuerttemberg'],
  'baden-wuerttemberg': ['stuttgart', 'bayern'],
  'nordrhein-westfalen': ['hessen', 'niedersachsen', 'rhein-main'],
  'hessen': ['rhein-main', 'nordrhein-westfalen'],
  'niedersachsen': ['hamburg', 'nordrhein-westfalen', 'berlin-brandenburg'],
  'berlin-brandenburg': ['hamburg', 'niedersachsen'],
  'hamburg': ['niedersachsen', 'berlin-brandenburg'],
  'rhein-main': ['hessen', 'bayern'],
  'muenchen': ['bayern', 'stuttgart'],
  'stuttgart': ['baden-wuerttemberg', 'muenchen'],
};

const alle = await getCollection('standorte');
const nachbarn = (verweise[entry.id] ?? []).flatMap((slug) => {
  const treffer = alle.find((e) => e.id === slug);
  return treffer ? [treffer] : [];
});

const breadcrumbs = [
  { name: 'Fertighaus-Regionen', href: '/fertighaus/' },
  { name: kurzname, href: `/fertighaus/${entry.id}/` },
];

// Service-/areaServed-Schema statt LocalBusiness: kein erfundener Standort,
// nur das tatsächliche Einzugsgebiet (siehe docs/research/geo.json).
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Fertighausbau in ${kurzname}`,
  serviceType: 'Planung und Bau schlüsselfertiger Fertighäuser',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: kurzname },
  url: new URL(`/fertighaus/${entry.id}/`, SITE.url).href,
};

const jsonLd = faq.length > 0 ? [serviceLd, buildFaqJsonLd(faq)] : [serviceLd];
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  ogImage={hero.src}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <!-- Kopf: h1, Lead und Beratungs-CTA above the fold -->
  <section class="container-site pt-12 lg:pt-16">
    <Breadcrumbs items={breadcrumbs} class="mb-10" />

    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h1 class="font-display text-hero font-medium">{name}</h1>
        <p class="prose-measure mt-6 text-body text-muted">{intro}</p>
        <div class="mt-9 flex flex-wrap items-center gap-6">
          <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
          <a href="/referenzen/" class="link-line text-small font-medium">
            Gebaute Häuser ansehen
          </a>
        </div>
      </div>

      <div class="reveal self-end lg:col-span-3 lg:col-start-10">
        <p class="text-caption font-medium text-muted">Wir bauen unter anderem in</p>
        <ul class="mt-4 divide-y divide-line border-y border-line">
          {cities.map((stadt) => (
            <li class="py-3 text-small">{stadt}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Hero-Bild, volle Breite -->
  <div class="mt-10 lg:mt-14">
    <Figure
      src={hero.src}
      alt={hero.alt}
      ratio="aspect-[3/2] sm:aspect-[21/9]"
      sizes="100vw"
      eager
      reveal={false}
      class="w-full"
    />
  </div>

  <!-- Regionaler Inhalt -->
  <section class="container-site pt-14 pb-(--spacing-section) lg:pt-20">
    <div class="grid gap-x-8 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Prose>
          <Content />
        </Prose>
      </div>

      <aside class="lg:col-span-4 lg:col-start-9">
        <p class="border-y border-line py-5 text-caption text-muted">
          Preis- und Rechtsangaben auf dieser Seite dienen der Orientierung
          (Stand: 07/2026). Was auf Ihrem Grundstück konkret gilt, klären wir
          im Grundstückscheck.
        </p>
      </aside>
    </div>
  </section>

  <!-- Regionale FAQ -->
  {faq.length > 0 && (
    <section class="bg-stone py-(--spacing-section)">
      <div class="container-site">
        <SectionIntro
          title={`Häufige Fragen zum Bauen in ${kurzname}`}
          lead="Antworten mit den Zahlen von 2026 – verbindlich wird es im Grundstückscheck für Ihren Bauplatz."
        />
        <div class="mt-14 grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <FaqAccordion items={faq} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Angrenzende Regionen -->
  {nachbarn.length > 0 && (
    <section class="container-site py-(--spacing-section-sm)">
      <p class="text-caption text-muted">Angrenzende Regionen</p>
      <p class="mt-4 flex flex-wrap gap-x-10 gap-y-3 text-small font-medium">
        {nachbarn.map((nachbar) => (
          <a href={`/fertighaus/${nachbar.id}/`} class="link-line">
            {nachbar.data.name}
          </a>
        ))}
      </p>
    </section>
  )}

  <!-- Abschluss-CTA -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Beratung für Ihr Bauvorhaben in {kurzname}
        </h2>
        <p class="reveal prose-measure mt-6 text-body leading-relaxed text-paper-muted">
          30 Minuten am Telefon oder online: Wir klären Grundstück, Budget und
          Zeitplan für Ihre Gemeinde – unverbindlich und mit ehrlichen Zahlen.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 lg:col-span-4 lg:col-start-9 lg:justify-end">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/ablauf/" class="link-line text-small font-medium text-paper">
          Den Ablauf ansehen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
