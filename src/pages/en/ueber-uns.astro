---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import { IMG } from '@/data/assets';
import { SITE, YEARS_EXPERIENCE } from '@/config/site';

const zahlen = [
  {
    wert: `since ${SITE.foundingYear}`,
    label: `${YEARS_EXPERIENCE} years in construction – from the structural shell through refurbishment to the turnkey administration building.`,
  },
  {
    wert: '5 years',
    label: 'Guarantee on the building structure and statutory warranty under German law (BGB) on all other work – every essential material comes with a quality certificate.',
  },
  {
    wert: 'Family business',
    label: 'Owner-managed, second generation. Decisions are made in house, not at a corporate headquarters – and whoever signs the contract is still reachable after handover.',
  },
  {
    wert: '7 + 3',
    label: 'Delivered up to seven upper floors and three basement levels – basements in watertight concrete, above them reinforced concrete, masonry or timber.',
  },
  {
    wert: 'Solid + timber',
    label: 'Reinforced concrete and masonry on site, timber frame and cross-laminated timber (CLT) from our own production – the project decides the method.',
  },
];

const grundsaetze = [
  {
    titel: 'What is drawn is what gets built.',
    text: 'For us, a plan is not a suggestion but a promise. Whatever is set out in the design, the construction and performance specification and the selection record is built exactly that way – at the agreed price, on the agreed date. Surprises on the building site are not fate; they are the result of imprecise planning. That is why we invest our care up front, where it is inexpensive, rather than at the end, where it becomes costly.',
    cols: 'lg:col-span-6 lg:col-start-1',
  },
  {
    titel: 'Precision is a question of place.',
    text: 'Millimetre work succeeds where conditions can be controlled – not in the rain on the scaffolding. That is why we move as many work steps as possible into the factory and leave for the building site only what must be assembled there. That construction becomes faster as a result is a welcome side effect. The reason is a different one: quality that can be inspected and documented.',
    cols: 'lg:col-span-6 lg:col-start-5',
  },
  {
    titel: 'A house is only finished once it has proven itself.',
    text: 'A five-year guarantee on the building structure and the statutory warranty under German law (BGB) are not, for us, deadlines to sit out but a period during which we remain reachable: with a dedicated contact, maintenance guidance and the building documentation file that keeps every decision traceable. Anyone who builds a house to last for decades must not disappear after handover.',
    cols: 'lg:col-span-6 lg:col-start-3',
  },
];
---

<BaseLayout
  title={`About us – construction company in Hanover since ${SITE.foundingYear}`}
  description={`Family-run construction company from Hanover: structural shell in reinforced concrete, masonry and timber, with our own production for timber components. ${YEARS_EXPERIENCE} years in construction. Get to know ${SITE.name}.`}
  breadcrumbs={[{ name: 'About us', href: '/en/ueber-uns/' }]}
  hideFooterCta
>
  <!-- Kopf: Positionierung -->
  <section class="container-site pt-12 lg:pt-16">
    <Breadcrumbs items={[{ name: 'About us', href: '/en/ueber-uns/' }]} class="mb-10" />

    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h1 class="font-display text-hero font-medium">
          A construction company in its second generation
        </h1>
      </div>
      <p class="prose-measure self-end text-body text-muted lg:col-span-4 lg:col-start-9">
        {SITE.legalName} has been building since {SITE.foundingYear} – {YEARS_EXPERIENCE} years,
        owner-managed and in its second generation. Our lead service is the structural shell;
        we have built for developers, business and the public sector.
      </p>
    </div>
  </section>

  <!-- Auftaktbild: Material statt Stockfoto-Team -->
  <div class="mt-14 lg:mt-20">
    <Figure
      src={IMG.rohbauKranwald.src}
      alt={IMG.rohbauKranwald.alt}
      ratio="aspect-[3/2] sm:aspect-[21/9]"
      sizes="100vw"
      eager
      reveal={false}
      class="w-full"
    />
    <div class="container-site mt-4">
      <p class="text-caption text-muted">
        Timber and concrete – we build in both and decide by the project.
      </p>
    </div>
  </div>

  <!-- Haltung: großes Statement -->
  <section class="container-site py-(--spacing-section)">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          We choose the method to suit the project – not the plant we happen to own.
        </h2>
        <p class="reveal prose-measure mt-8 text-body text-muted">
          Most contractors can do one of the two: reinforced concrete or timber. A firm that can
          only do one ends up recommending the same thing every time. We build in both and decide
          by span, fire requirements, basements and programme. What that means in practice: the
          same steps, the same inspections, the same tolerances – on a seven-storey building in
          the city centre as on a single-storey nursery. Every project is individual. What stays
          the same is the accuracy with which it is built.
        </p>
        <p class="reveal prose-measure mt-5 text-body text-muted">
          We have worked to this principle since {SITE.foundingYear}. The structural shell has
          always been our core – foundations, structure, floor slabs – and over the years our own
          production for timber and hybrid structures was added. What has not changed: it is a
          family business in which the people responsible are known by name.
        </p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <Figure
          src={IMG.rohbauSkelett.src}
          alt={IMG.rohbauSkelett.alt}
          ratio="aspect-[4/5]"
          sizes="(min-width: 1024px) 30vw, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- Wie wir arbeiten: Baustelle statt Werkhalle -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="What carries a building is settled before the first cubic metre of concrete"
        lead="Foundations, setting-out and cast-in parts decide every trade that follows. That is why our care goes in early – in work preparation, survey and documentation."
      />

      <div class="mt-16 grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-center">
        <div class="reveal lg:col-span-5">
          <p class="prose-measure text-body text-muted">
            Work preparation comes before the first day on site: formwork and reinforcement
            drawings checked against the structural design, concrete grades and exposure
            classes fixed, cast-in parts and penetrations agreed with the specialist
            designers. What is settled here nobody has to chase out of the concrete later.
            What is missing here turns up as a variation.
          </p>
          <p class="prose-measure mt-5 text-body text-muted">
            On site everything is surveyed and recorded: foundation levels, setting-out,
            openings, concrete cover before the pour. Those records are part of the
            documentation you receive at handover. That is not an end in itself – any
            deviation that goes unnoticed in the shell costs a multiple of that in the
            fit-out.
          </p>
        </div>
        <Figure
          src={IMG.rohbauSchalung.src}
          alt={IMG.rohbauSchalung.alt}
          ratio="aspect-[4/3]"
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="lg:col-span-6 lg:col-start-7"
        />
      </div>

      <div class="mt-16 grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-center">
        <Figure
          src={IMG.rohbauBewehrung.src}
          alt={IMG.rohbauBewehrung.alt}
          ratio="aspect-[4/3]"
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="lg:col-span-6"
        />
        <p class="reveal prose-measure text-body text-muted lg:col-span-5 lg:col-start-8">
          The work is done by our own crews – the same people, working together over years,
          from excavation to whichever stage you commissioned. One site manager, one survey,
          one responsibility. That keeps responsibility where it belongs: with us.
        </p>
      </div>
    </div>
  </section>

  <!-- Wo wir bauen -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro
      title="Where we build"
      lead="Administration and site management are based in Hanover. We have built from Lower Saxony to Baden-Württemberg – and beyond."
    />

    <div class="mt-16 grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <div class="reveal lg:col-span-5">
        <dl class="divide-y divide-line border-y border-line">
          {[
            { k: 'Base', v: 'Administration and site management in Hanover' },
            { k: 'Methods', v: 'Reinforced concrete, masonry, timber frame and cross-laminated timber (CLT)' },
            { k: 'We build in', v: 'Across Europe' },
            { k: 'Scope', v: 'Groundworks, shell, shell with weathertight envelope, or turnkey' },
          ].map((z) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="text-caption text-muted">{z.k}</dt>
              <dd class="text-small leading-relaxed">{z.v}</dd>
            </div>
          ))}
        </dl>
        <p class="prose-measure mt-6 text-small leading-relaxed text-muted">
          Site logistics are part of the design for us, not a by-product of it: access,
          crane standing area, storage and delivery windows are settled before the first
          vehicle arrives. On an inner-city site that is exactly what decides whether the
          programme holds.
        </p>
      </div>

      <div class="grid content-start gap-6 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
        {[IMG.rohbauKraene, IMG.rohbauMauerwerk, IMG.rohbauDecke, IMG.rohbauNacht].map((bild, i) => (
          <Figure
            src={bild.src}
            alt={bild.alt}
            ratio={i % 3 === 0 ? 'aspect-[4/3]' : 'aspect-square'}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 45vw, 100vw"
            class={i % 3 === 0 ? 'sm:col-span-2' : ''}
            zoom
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Zahlen: Anthrazit-Drench, Register statt Stat-Karten -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site">
      <h2 class="reveal font-display text-display font-medium">
        What stands behind the name
      </h2>
      <dl class="mt-14 divide-y divide-paper/10 border-y border-paper/10">
        {zahlen.map((z) => (
          <div class="reveal grid gap-2 py-7 sm:grid-cols-[minmax(10rem,17rem)_1fr] sm:gap-8">
            <dt class="tnum font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-tight font-medium hyphens-auto break-words">{z.wert}</dt>
            <dd class="prose-measure self-center text-body leading-relaxed text-paper-muted">{z.label}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-10 max-w-2xl text-small text-paper-muted">
        Run as a mid-sized business, short distances: anyone who builds with us knows the
        people who price the job, plan it and stand on the site.
      </p>
    </div>
  </section>

  <!-- Woran wir glauben: Fließtext-Absätze, versetzt gesetzt -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro title="What we believe" />
    <div class="mt-16 grid gap-x-8 gap-y-14 lg:grid-cols-12">
      {grundsaetze.map((g) => (
        <div class:list={['reveal', g.cols]}>
          <h3 class="font-display text-title font-medium">{g.titel}</h3>
          <p class="prose-measure mt-4 text-body text-muted">{g.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Besuch + CTA -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site grid gap-x-8 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          See it for yourself before you believe us.
        </h2>
        <p class="reveal prose-measure mt-6 text-body text-muted">
          A text can claim precision – a house has to show it. Visit our show home, open the
          windows, doors and cupboards, and ask the questions that brochures do not answer.
          Or begin with an initial conversation: 30&nbsp;minutes, no obligation, with honest
          figures.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 self-end lg:col-span-4 lg:col-start-9">
        <Button href="/en/kontakt/" variant="primary">Book a consultation</Button>
      </div>
    </div>
  </section>
</BaseLayout>
