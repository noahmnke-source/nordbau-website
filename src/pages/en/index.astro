---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VideoHero from '@/components/VideoHero.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import MaterialSlider from '@/components/MaterialSlider.astro';
import { IMG } from '@/data/assets';
import { SITE, YEARS_EXPERIENCE } from '@/config/site';
import { buildFaqJsonLd } from '@/lib/seo';

const hausTeaser = [
  {
    name: 'Bungalow',
    href: '/en/haeuser/bungalow/',
    fakt: 'from 95 m² · single storey',
    img: IMG.bungalowGold,
  },
  {
    name: 'Modular house',
    href: '/en/haeuser/modulhaus/',
    fakt: 'from 75 m² · extendable',
    img: IMG.modulhaus,
  },
  {
    name: 'Tiny House',
    href: '/en/haeuser/tiny-house/',
    fakt: 'from 35 m² · compact',
    img: IMG.tinyHouse,
  },
];


/* The hero cycles through three motifs: home, commercial building, timber
   house – the three fields we work in, in three images. */
const heroBilder = [IMG.heroHome, IMG.heroGewerbe, IMG.heroFertighaus];

const zahlen = [
  { wert: `since ${SITE.foundingYear}`, label: `${YEARS_EXPERIENCE} years of experience in construction – from the timber-frame prefab home to the public building` },
  { wert: '30 years', label: 'Guarantee on the building structure, plus 5 years of statutory warranty under German law (BGB) on all other work' },
  { wert: '12 months', label: 'Fixed-price guarantee from contract signing, independent of material prices' },
  { wert: 'EH 40', label: 'Efficiency House standard ex works – a requirement for KfW funding 297/298' },
];

const faq = [
  {
    q: 'What does a prefab home from EcoBau cost?',
    a: 'That depends on the house type, living space, specification and plot. Instead of a catalogue figure, you receive an individual fixed-price offer from us after a no-obligation initial consultation – transparently calculated, with a 12-month price guarantee from contract signing. The plot and ancillary building costs are added to the house price.',
  },
  {
    q: 'How long does it take to build a prefab home?',
    a: 'A general figure in weeks would be misleading: the duration depends on the building authority, your financing, the ground conditions and the weather – factors outside our control. What prefabrication does deliver is moving the shell into the hall: on site, elements are assembled, not built. You receive a reliable programme for your own project once the site and the consent position are settled.',
  },
  {
    q: 'What exactly does “turnkey” mean?',
    a: '“Turnkey” is not a legally defined term – the scope of work is set out in the construction & specification document. For us it means: move-in ready including bathrooms, floors and interior doors. As a rule, only compare offers with an identical scope of work.',
  },
  {
    q: 'Can I plan a prefab home entirely individually?',
    a: 'Yes. Alongside our house types, we plan freely designed architect homes in timber-frame construction – floor plan, facade, roof shape and specification are created individually. Prefabrication in the factory hardly limits the design.',
  },
  {
    q: 'What KfW funding is available in 2026 for building a house?',
    a: 'Through “Climate-Friendly New Construction” (KfW 297/298) there are interest-reduced loans of up to 150,000 euros per residential unit from Efficiency House 40 standard. Families with a child and a maximum taxable income of 90,000 euros can alternatively use KfW 300 with up to 270,000 euros.',
  },
];
---

<BaseLayout
  title={`Prefab homes and buildings from Hanover – built turnkey | ${SITE.name}`}
  fullTitle
  description="Family-run construction company from Hanover: individually planned prefab homes in timber-frame construction from our own plant, plus apartment buildings, commercial buildings and facilities for education and care. Efficiency House 40 ex works."
  heroOverlay
  jsonLd={[buildFaqJsonLd(faq)]}
>
  <!-- Hero -->
  <VideoHero bilder={heroBilder} wechslerAria="Image slideshow in the page header">
    <div class="max-w-3xl">
      <!-- Two lines as separate blocks so each sentence wraps on its own
           and both rise in slightly offset. -->
      <h1 class="font-display text-hero font-medium">
        <span class="hero-line block">Your home. Individually designed.</span>
        <span class="hero-line block" style="--line-delay: 120ms">Your project. Whatever the scale.</span>
      </h1>
      <p class="hero-line prose-measure mt-6 text-body text-paper/85" style="--line-delay: 280ms">
        {SITE.legalName} from {SITE.contact.city} — turnkey prefab homes in timber-frame
        construction, plus apartment buildings, commercial buildings and facilities for
        education and care. A family business since {SITE.foundingYear}.
      </p>
      <div class="hero-line mt-10 flex flex-wrap items-center gap-6" style="--line-delay: 420ms">
        <Button href="/en/kontakt/" variant="primary">Book a consultation</Button>
        <a href="/en/haeuser/einfamilienhaus/" class="link-line text-small font-medium text-paper">
          See the designs
        </a>
      </div>
    </div>
  </VideoHero>

  <!-- Two entry points: the site serves two audiences with very different questions. -->
  <section class="container-site py-(--spacing-section-sm)">
    <div class="grid divide-y divide-line border-y border-line lg:grid-cols-2 lg:divide-x lg:divide-y-0">
      <a href="/en/haeuser/einfamilienhaus/" class="group/weg block py-8 lg:pr-10">
        <p class="text-caption tracking-wide text-muted uppercase">For private clients</p>
        <p class="mt-3 font-display text-title font-medium">
          Your home, individually designed and turnkey
        </p>
        <p class="prose-measure mt-3 text-small text-muted">
          Detached house, bungalow, modular house or tiny house – drawn for your site,
          made in our own plant. Efficiency House 40, fixed price for twelve months.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-small font-medium text-oxide">
          To the houses
          <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover/weg:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
        </span>
      </a>

      <a href="/en/wohn-und-gewerbebau/mehrfamilienhaeuser/" class="group/weg block py-8 lg:pl-10">
        <p class="text-caption tracking-wide text-muted uppercase">For developers, business and public clients</p>
        <p class="mt-3 font-display text-title font-medium">
          Residential and commercial buildings
        </p>
        <p class="prose-measure mt-3 text-small text-muted">
          Apartment buildings, offices and administration, nurseries and clinics —
          turnkey or as individual work packages. Built up to around 10,500 m² gross floor area.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-small font-medium text-oxide">
          To residential and commercial
          <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover/weg:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
        </span>
      </a>
    </div>
  </section>

  <!-- USP: Statement + Belege -->
  <section class="container-site py-(--spacing-section)">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          A house is not an off-the-shelf product. Our construction method is&nbsp;– in the best sense.
        </h2>
        <p class="reveal prose-measure mt-8 text-body text-muted">
          Every {SITE.name} house is built twice: first to the millimetre in the factory, then in
          a few days on your plot. The precision of serial manufacturing
          meets a floor plan that exists exactly once – yours. The result
          is predictable in price and schedule, without architecture becoming a bargaining chip.
        </p>
        <dl class="reveal mt-12 divide-y divide-line border-y border-line">
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="tnum font-display text-title font-medium text-oxide">12 months</dt>
            <dd class="self-center text-small text-muted">Fixed-price guarantee from contract signing – your budget stays your budget.</dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="tnum font-display text-title font-medium text-oxide">30 years</dt>
            <dd class="self-center text-small text-muted">Guarantee on the building structure, plus 5 years of statutory warranty under German law (BGB) on all other work.</dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="tnum font-display text-title font-medium text-oxide">EH 40</dt>
            <dd class="self-center text-small text-muted">Efficiency House 40 ex works: heat pump, ventilation system, PV preparation included.</dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="tnum font-display text-title font-medium text-oxide">Own plant</dt>
            <dd class="self-center text-small text-muted">Wall, floor and roof elements are produced weather-protected in our own manufacturing hall.</dd>
          </div>
        </dl>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <Figure
          src={IMG.elementmontage.src}
          alt={IMG.elementmontage.alt}
          ratio="aspect-[4/5]"
          sizes="(min-width: 1024px) 30vw, 100vw"
          parallax={0.06}
        />
      </div>
    </div>
  </section>

  <!-- Warum Holz: Materialvorteile (Fakten des Baustoffs, kein Icon-Raster) -->
  <section class="py-(--spacing-section) pt-0">
    <div class="container-site">
      <SectionIntro
        title="Why we build with timber"
        lead="Timber-frame construction is not only fast and precise. The material itself brings qualities that no other has."
      />
      <dl class="mt-16 grid gap-x-16 gap-y-12 sm:grid-cols-2">
        {[
          {
            t: 'A healthy indoor climate',
            d: 'Timber is a natural, hypoallergenic material: electrostatically neutral, it does not attract dust. The result is noticeably pure indoor air.',
          },
          {
            t: 'Moisture, naturally regulated',
            d: 'Timber walls absorb moisture when the air is humid and release it when it is dry – a balanced indoor climate entirely without additional technology.',
          },
          {
            t: 'Light and dimensionally stable',
            d: 'At around 500 kg/m³, timber is significantly lighter than concrete and at the same time elastic: the structure stays stable even under vibrations.',
          },
          {
            t: 'Renewable and low in CO₂',
            d: 'Every cubic metre of installed timber stores around one tonne of CO₂ – a material that regrows instead of consuming resources.',
          },
        ].map((b) => (
          <div class="reveal border-t border-line pt-6">
            <dt class="font-display text-title font-medium">{b.t}</dt>
            <dd class="prose-measure mt-3 text-body text-muted">{b.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Haustypen-Teaser -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="Four house forms. Countless floor plans."
        lead="From the tiny house to the multi-family house: each type is a proven basic framework – rooms, facade and details we plan anew with you."
      />

      <div class="mt-16 grid gap-8 lg:grid-cols-12">
        <!-- Featured: Einfamilienhaus -->
        <a href="/en/haeuser/einfamilienhaus/" class="group block lg:col-span-7">
          <Figure
            src={IMG.satteldach.src}
            alt={IMG.satteldach.alt}
            ratio="aspect-[4/3]"
            sizes="(min-width: 1024px) 58vw, 100vw"
            zoom
          />
          <div class="mt-5 flex items-baseline justify-between gap-4">
            <h3 class="font-display text-title font-medium">
              <span class="link-line">Detached house</span>
            </h3>
            <p class="tnum text-small text-muted">from 120 m² · pitched or flat roof</p>
          </div>
        </a>

        <!-- Drei kompakte Typen -->
        <div class="grid content-start gap-10 sm:grid-cols-3 lg:col-span-5 lg:grid-cols-1 lg:gap-8 lg:pl-8">
          {hausTeaser.map((typ) => (
            <a href={typ.href} class="group grid grid-cols-[7rem_1fr] items-center gap-5">
              <Figure
                src={typ.img.src}
                alt={typ.img.alt}
                ratio="aspect-square"
                sizes="7rem"
                zoom
                reveal={false}
              />
              <div>
                <h3 class="font-display text-title font-medium">
                  <span class="link-line">{typ.name}</span>
                </h3>
                <p class="tnum mt-1 text-small text-muted">{typ.fakt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="mt-14">
        <Button href="/en/weg-zum-traumhaus/" variant="secondary">How your house is built</Button>
      </div>
    </div>
  </section>

  <!-- Aufbau & Materialien: Wandschnitt-Slider -->
  <MaterialSlider />

  <!-- Referenz-Preview: ein entschiedenes Bild -->
  <!-- Our own plant -->
  <section class="py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="We manufacture ourselves."
        lead="Wall, floor and roof elements are made in our own hall – checked before they leave the plant. On site, elements are assembled, not built."
      />
    </div>
    <div class="mt-16">
      <Figure
        src={IMG.werkHalle.src}
        alt={IMG.werkHalle.alt}
        ratio="aspect-[3/2] sm:aspect-[21/9]"
        sizes="100vw"
        class="w-full"
        parallax={0.05}
      />
    </div>
    <div class="container-site mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {[IMG.holzMaterial, IMG.werkTeam, IMG.kranModul].map((bild, i) => (
        <Figure
          src={bild.src}
          alt={bild.alt}
          ratio="aspect-[4/3]"
          sizes="(min-width: 1024px) 31vw, (min-width: 640px) 47vw, 100vw"
          class={i === 2 ? 'sm:col-span-2 lg:col-span-1' : ''}
          zoom
        />
      ))}
    </div>
    <div class="container-site mt-10">
      <a href="/en/ueber-uns/" class="link-line text-small font-medium">The plant and the company</a>
    </div>
  </section>


  <!-- Zahlen / Trust: Anthrazit-Drench, Register statt Stat-Karten -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site">
      <h2 class="reveal font-display text-display font-medium">
        Reliability you can check for yourself.
      </h2>
      <dl class="mt-14 divide-y divide-paper/10 border-y border-paper/10">
        {zahlen.map((z) => (
          <div class="reveal grid gap-2 py-7 sm:grid-cols-[minmax(10rem,14rem)_1fr] sm:gap-8">
            <dt class="tnum font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-tight font-medium">{z.wert}</dt>
            <dd class="prose-measure self-center text-body leading-relaxed text-paper-muted">{z.label}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-10 max-w-2xl text-small text-paper-muted">
        We work under a construction contract in accordance with German law (BGB): a 30-year guarantee on the building structure,
        five years of statutory warranty from acceptance on all other work, instalment payments
        only for work performed, bonds included.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro
      title="The questions that come up now"
      lead="Honest answers with 2026 figures – in more detail in the guide."
    />
    <div class="mt-14 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <FaqAccordion items={faq} />
      </div>
      <div class="self-end lg:col-span-3 lg:col-start-10">
        <p class="text-small text-muted">Your question is not here?</p>
        <div class="mt-4">
          <Button href="/en/kontakt/" variant="primary">Book a consultation</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero-Ladechoreografie: Zeilen steigen versetzt auf */
  .hero-line {
    animation: hero-rise 0.8s var(--ease-out-expo) both;
    animation-delay: var(--line-delay, 0ms);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line {
      animation: none;
    }
  }
</style>
