---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VideoHero from '@/components/VideoHero.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { IMG } from '@/data/assets';
import { SITE, YEARS_EXPERIENCE } from '@/config/site';
import { buildFaqJsonLd } from '@/lib/seo';

const ablauf = [
  { titel: 'Foundations', text: 'Earthworks, slab and reinforcement to the structural design. What goes wrong below stays wrong above.', img: IMG.rohbauBewehrung },
  { titel: 'Formwork', text: 'Form lining, tie pattern and joint layout are agreed in advance – fair-faced concrete forgives nothing.', img: IMG.rohbauSchalung },
  { titel: 'Rising walls', text: 'Large-format precision blocks or reinforced concrete, depending on spans, fire requirements and programme.', img: IMG.rohbauMauerwerk },
  { titel: 'Floors and envelope', text: 'Floor slabs, stair cores and, if wanted, the closed, weathertight building envelope.', img: IMG.rohbauDecke },
];

const stufen = [
  { titel: 'Structural shell', text: 'Foundations, loadbearing walls, columns, floors and stair cores – surveyed and handed over with structural certification.' },
  { titel: 'Shell with envelope', text: 'Plus roof, façade, windows and doors. The building is closed and weathertight.' },
  { titel: 'Turnkey', text: 'Plus every finishing trade through to handover. One contract, one contact, one date.' },
];

const projekte = [
  { name: 'City Gate Nord office and administration complex', ort: 'Hanover-Vahrenwald', zeitraum: 'July 2023 – August 2025', leistung: 'Groundworks, shell and fit-out', kennzahl: '10,500 m² GFA · 6 storeys' },
  { name: 'Residential and commercial building Maybachstraße 20', ort: 'Stuttgart', zeitraum: 'June 2019 – October 2023', leistung: 'Shell and fit-out', kennzahl: '15,000 m² GFA · 70 dwellings' },
  { name: 'Warehouse and administration building PVU-Group', ort: 'Isernhagen', zeitraum: 'Summer 2019 – spring 2020', leistung: 'Groundworks, shell and fit-out', kennzahl: 'around 6,000 m² GFA' },
  { name: 'Municipal hospital, fit-out ground to fifth floor', ort: 'Braunschweig', zeitraum: 'March 2021 – December 2023', leistung: 'Fit-out under medical constraints', kennzahl: '6 storeys · adjacent wards in use' },
  { name: 'Day nursery Seegrasweg', ort: 'Ronnenberg-Empelde', zeitraum: 'May 2022 – September 2023', leistung: 'Shell and fit-out', kennzahl: '1,300 m² GFA · timber frame' },
];

const gebaeude = [
  { name: 'Apartment buildings', href: '/en/gebaeude/mehrfamilienhaeuser/', text: 'Acoustic and fire separation between units drive the construction – designed in, not retrofitted.', img: IMG.rohbauWohnanlage },
  { name: 'Commercial buildings', href: '/en/gebaeude/gewerbebau/', text: 'Offices and administration, halls and showrooms. Spans and imposed loads decide the structure.', img: IMG.heroGewerbe },
  { name: 'Education & care', href: '/en/gebaeude/sozial-und-bildung/', text: 'Nurseries, schools and medical facilities – hygiene, escape routes and acoustics as the design basis.', img: IMG.kitaEingang },
];


/* The hero cycles through three motifs: home, commercial building, timber
   house – the three fields we work in, in three images. */
const heroBilder = [IMG.rohbauSkelett, IMG.rohbauZeile, IMG.rohbauKranwald];

/* The three services, in the order they build on each other. */
const leistungen = [
  {
    name: 'Structural shell',
    href: '/en/leistungen/rohbau/',
    fakt: 'Concrete · masonry · timber',
    text: 'Foundations, structure, floors and stair cores – surveyed, recorded and handed over with structural certification.',
    img: IMG.rohbauWohnanlage,
  },
  {
    name: 'Turnkey construction',
    href: '/en/leistungen/schluesselfertigbau/',
    fakt: 'All trades from one hand',
    text: 'We build the loadbearing part ourselves and steer the remaining trades. One contract, one date, one contact.',
    img: IMG.rohbauInnen,
  },
  {
    name: 'Existing buildings',
    href: '/en/leistungen/bauen-im-bestand/',
    fakt: 'Also while in use',
    text: 'Conversion, extension and fit-out – with structural certification for every intervention in the frame.',
    img: IMG.bestandGeruest,
  },
];

const zahlen = [
  { wert: `since ${SITE.foundingYear}`, label: `${YEARS_EXPERIENCE} years in construction – shell, turnkey building and houses from our own plant` },
  { wert: '7 + 3', label: 'Upper floors and basement levels: the greatest number of storeys delivered so far, basements watertight' },
  { wert: '15,000 m²', label: 'Gross floor area of the largest project delivered – shell and fit-out' },
  { wert: '5 years', label: 'Guarantee on the building structure and statutory warranty under German law (BGB) on all other work' },
];

const faq = [
  {
    q: 'What does a prefab home from EcoBau cost?',
    a: 'That depends on the house type, living space, specification and plot. Instead of a catalogue figure, you receive an individual fixed-price offer from us after a no-obligation initial consultation – transparently calculated, with a 12-month price guarantee from contract signing. The plot and ancillary building costs are added to the house price.',
  },
  {
    q: 'How long does it take to build a prefab home?',
    a: 'A general figure in weeks would be misleading: the duration depends on the building authority, your financing, the ground conditions and the weather – factors outside our control. What prefabrication does deliver is moving the shell into the hall: on site, elements are assembled, not built. You receive a reliable programme for your own project once the site and the consent position are settled.',
  },
  {
    q: 'What exactly does “turnkey” mean?',
    a: '“Turnkey” is not a legally defined term – the scope of work is set out in the construction & specification document. For us it means: move-in ready including bathrooms, floors and interior doors. As a rule, only compare offers with an identical scope of work.',
  },
  {
    q: 'Can I plan a prefab home entirely individually?',
    a: 'Yes. Alongside our house types, we plan freely designed architect homes in timber-frame construction – floor plan, facade, roof shape and specification are created individually. Prefabrication in the factory hardly limits the design.',
  },
  {
    q: 'What KfW funding is available in 2026 for building a house?',
    a: 'Through “Climate-Friendly New Construction” (KfW 297/298) there are interest-reduced loans of up to 150,000 euros per residential unit from Efficiency House 40 standard. Families with a child and a maximum taxable income of 90,000 euros can alternatively use KfW 300 with up to 270,000 euros.',
  },
];
---

<BaseLayout
  title={`Structural shell contractor in Hanover – concrete, masonry, timber | ${SITE.name}`}
  fullTitle
  description="Shell construction from Hanover: foundations, structure and floors in reinforced concrete, masonry and timber – optionally with a weathertight envelope or turnkey. Apartment, commercial and education buildings up to 15,000 m² GFA. Family-run since 1994."
  heroOverlay
  jsonLd={[buildFaqJsonLd(faq)]}
>
  <!-- Hero -->
  <VideoHero bilder={heroBilder} wechslerAria="Image slideshow in the page header">
    <div class="max-w-3xl">
      <!-- Two lines as separate blocks so each sentence wraps on its own
           and both rise in slightly offset. -->
      <h1 class="font-display text-hero font-medium">
        <span class="hero-line block">Structural shell from {SITE.contact.city}.</span>
        <span class="hero-line block" style="--line-delay: 120ms">From foundations to a weathertight envelope.</span>
      </h1>
      <p class="hero-line prose-measure mt-6 text-body text-paper/85" style="--line-delay: 280ms">
        {SITE.legalName} from {SITE.contact.city} — turnkey prefab homes in timber-frame
        construction, plus apartment buildings, commercial buildings and facilities for
        education and care. A family business since {SITE.foundingYear}.
      </p>
      <div class="hero-line mt-10 flex flex-wrap items-center gap-6" style="--line-delay: 420ms">
        <Button href="/en/kontakt/" variant="primary">Book a consultation</Button>
        <a href="/en/haeuser/einfamilienhaus/" class="link-line text-small font-medium text-paper">
          See the designs
        </a>
      </div>
    </div>
  </VideoHero>

  <!-- Two entry points: the site serves two audiences with very different questions. -->
  <section class="container-site py-(--spacing-section-sm)">
    <div class="grid divide-y divide-line border-y border-line lg:grid-cols-2 lg:divide-x lg:divide-y-0">
      <a href="/en/leistungen/rohbau/" class="group/weg block py-8 lg:pr-10">
        <p class="text-caption tracking-wide text-muted uppercase">For developers, architects and business</p>
        <p class="mt-3 font-display text-title font-medium">
          Shell, envelope or turnkey
        </p>
        <p class="prose-measure mt-3 text-small text-muted">
          Reinforced concrete, masonry and timber – delivered up to seven upper floors and
          three basement levels. You decide where our work ends.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-small font-medium text-oxide">
          To the structural shell
          <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover/weg:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
        </span>
      </a>

      <a href="/en/haeuser/einfamilienhaus/" class="group/weg block py-8 lg:pl-10">
        <p class="text-caption tracking-wide text-muted uppercase">For private clients</p>
        <p class="mt-3 font-display text-title font-medium">
          Your home from our own plant
        </p>
        <p class="prose-measure mt-3 text-small text-muted">
          Detached house, bungalow, modular house or tiny house – drawn for your site,
          made in our own plant. Efficiency House 40, fixed price for twelve months.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-small font-medium text-oxide">
          To the houses
          <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover/weg:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
        </span>
      </a>
    </div>
  </section>

  <!-- Services: the shell first, the rest builds on it -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="What we build – and how far"
        lead="The structural shell is our lead service. Whether we carry on from there is your decision."
      />
      <div class="mt-14 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {leistungen.map((l, i) => (
          <a href={l.href} class="group reveal block" style={`--reveal-delay:${i * 90}ms`}>
            <Figure src={l.img.src} alt={l.img.alt} ratio="aspect-[4/3]"
              sizes="(min-width: 768px) 31vw, 100vw" zoom />
            <p class="mt-5 text-caption tracking-wide text-muted uppercase">{l.fakt}</p>
            <h3 class="mt-2 font-display text-title font-medium">{l.name}</h3>
            <p class="prose-measure mt-3 text-small leading-relaxed text-muted">{l.text}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-small font-medium text-oxide">
              Find out more
              <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How the shell is built: explanatory licence images, no project names -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro
      title="How the shell is built"
      lead="Accuracy missing here is never recovered by a finishing trade – and what is done well here, nobody ever sees."
    />
    <div class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {ablauf.map((a, i) => (
        <div class="reveal" style={`--reveal-delay:${(i % 4) * 80}ms`}>
          <Figure src={a.img.src} alt={a.img.alt} ratio="aspect-[4/3]"
            sizes="(min-width: 1024px) 23vw, (min-width: 640px) 46vw, 100vw" />
          <p class="tnum mt-5 font-display text-title font-medium text-oxide">
            {String(i + 1).padStart(2, '0')}
          </p>
          <h3 class="mt-1 font-display text-body font-medium">{a.titel}</h3>
          <p class="mt-2 text-small leading-relaxed text-muted">{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Scope: the client decides where we stop -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site">
      <div class="grid gap-x-8 gap-y-6 lg:grid-cols-12">
        <h2 class="reveal font-display text-display font-medium lg:col-span-6">
          You decide how far we build
        </h2>
        <p class="reveal prose-measure self-end text-body leading-relaxed text-paper-muted lg:col-span-5 lg:col-start-8">
          The boundary is written into the specification before contract – so the interface
          with your other trades is unambiguous and is not up for debate when things get tight.
        </p>
      </div>
      <ol class="mt-14 grid gap-x-8 gap-y-10 lg:grid-cols-3">
        {stufen.map((st, i) => (
          <li class="reveal border-t border-paper/20 pt-6" style={`--reveal-delay:${i * 110}ms`}>
            <p class="tnum font-display text-title font-medium text-oxide">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 font-display text-title font-medium">{st.titel}</h3>
            <p class="prose-measure mt-3 text-small leading-relaxed text-paper-muted">{st.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12">
        <Button href="/en/leistungen/rohbau/" variant="secondary">To the structural shell</Button>
      </div>
    </div>
  </section>

  <!-- Completed projects -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro
      title="Completed projects"
      lead="A selection from recent years – with scope of work and size."
    />
    <div class="mt-14 overflow-x-auto">
      <table class="w-full min-w-[46rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-line text-caption text-muted">
            <th scope="col" class="py-3 pr-6 font-medium">Project</th>
            <th scope="col" class="py-3 pr-6 font-medium">Scope</th>
            <th scope="col" class="py-3 font-medium">Size</th>
          </tr>
        </thead>
        <tbody>
          {projekte.map((pr) => (
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-5 pr-6 font-normal">
                <span class="block font-display text-body font-medium">{pr.name}</span>
                <span class="mt-1 block text-caption text-muted">{pr.ort} · {pr.zeitraum}</span>
              </th>
              <td class="py-5 pr-6 text-small text-muted">{pr.leistung}</td>
              <td class="tnum py-5 text-small text-muted">{pr.kennzahl}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Building types -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="The buildings we build"
        lead="The same work, different demands: acoustics in housing, spans in commercial, statutory constraints in education."
      />
      <div class="mt-14 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {gebaeude.map((g, i) => (
          <a href={g.href} class="group reveal block" style={`--reveal-delay:${i * 90}ms`}>
            <Figure src={g.img.src} alt={g.img.alt} ratio="aspect-[4/3]"
              sizes="(min-width: 768px) 31vw, 100vw" zoom />
            <h3 class="mt-5 font-display text-title font-medium">{g.name}</h3>
            <p class="prose-measure mt-3 text-small leading-relaxed text-muted">{g.text}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-small font-medium text-oxide">
              Find out more
              <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Second strand, deliberately brief -->
  <section class="container-site py-(--spacing-section)">
    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-center">
      <div class="reveal lg:col-span-5">
        <p class="text-caption tracking-wide text-muted uppercase">Second strand</p>
        <h2 class="mt-3 font-display text-display font-medium">
          And we build houses in our own plant.
        </h2>
        <p class="prose-measure mt-6 text-body leading-relaxed text-muted">
          Alongside the structural shell we build turnkey homes in timber frame –
          detached houses, bungalows, modular houses and tiny houses, drawn for your site
          and prefabricated in our own hall.
        </p>
        <div class="mt-8">
          <Button href="/en/haeuser/einfamilienhaus/" variant="primary">To the houses</Button>
        </div>
      </div>
      <Figure src={IMG.heroHome.src} alt={IMG.heroHome.alt} ratio="aspect-[3/2]"
        sizes="(min-width: 1024px) 54vw, 100vw" class="lg:col-span-6 lg:col-start-7" zoom />
    </div>
  </section>

  <!-- Zahlen / Trust: Anthrazit-Drench, Register statt Stat-Karten -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site">
      <h2 class="reveal font-display text-display font-medium">
        Reliability you can check for yourself.
      </h2>
      <dl class="mt-14 divide-y divide-paper/10 border-y border-paper/10">
        {zahlen.map((z) => (
          <div class="reveal grid gap-2 py-7 sm:grid-cols-[minmax(10rem,17rem)_1fr] sm:gap-8">
            <dt class="tnum font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-tight font-medium hyphens-auto break-words">{z.wert}</dt>
            <dd class="prose-measure self-center text-body leading-relaxed text-paper-muted">{z.label}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-10 max-w-2xl text-small text-paper-muted">
        We work under a construction contract in accordance with German law (BGB): a five-year guarantee on the building structure
        and statutory warranty from acceptance on all other work, instalment payments
        only for work performed, bonds included.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro
      title="The questions that come up now"
      lead="Honest answers with 2026 figures – in more detail in the guide."
    />
    <div class="mt-14 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <FaqAccordion items={faq} />
      </div>
      <div class="self-end lg:col-span-3 lg:col-start-10">
        <p class="text-small text-muted">Your question is not here?</p>
        <div class="mt-4">
          <Button href="/en/kontakt/" variant="primary">Book a consultation</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero-Ladechoreografie: Zeilen steigen versetzt auf */
  .hero-line {
    animation: hero-rise 0.8s var(--ease-out-expo) both;
    animation-delay: var(--line-delay, 0ms);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line {
      animation: none;
    }
  }
</style>
