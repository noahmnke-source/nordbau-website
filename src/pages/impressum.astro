---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title="Impressum"
  description={`Impressum der ${SITE.legalName}: Anbieterkennzeichnung mit Anschrift, Kontakt, Vertretungsberechtigten und Registerangaben nach § 5 DDG.`}
  breadcrumbs={[{ name: 'Impressum', href: '/impressum/' }]}
>
  <section class="container-site pt-16 pb-(--spacing-section)">
    <h1 class="font-display text-display font-medium">Impressum</h1>

    <div class="prose-measure mt-10 space-y-6 text-body">
      <h2 class="font-display text-title font-medium">Angaben gemäß § 5 DDG</h2>
      <p>
        {SITE.legalName}<br />
        {SITE.contact.street}<br />
        {SITE.contact.zip} {SITE.contact.city}<br />
        Deutschland
      </p>
      <p>
        Telefon: <a href={`tel:${SITE.contact.phone}`} class="link-line">{SITE.contact.phoneDisplay}</a><br />
        E-Mail: <a href={`mailto:${SITE.contact.email}`} class="link-line">{SITE.contact.email}</a>
      </p>
      <p>
        Handelsregister: {SITE.legal.register}<br />
        Registergericht: {SITE.legal.court}
      </p>
      <p>
        Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: {SITE.legal.vatId}<br />
        Steuernummer: {SITE.legal.taxNumber}
      </p>
      <p>
        Vertretungsberechtigter Geschäftsführer: {SITE.legal.managingDirector}<br />
        Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV: {SITE.legal.managingDirector}, {SITE.contact.street}, {SITE.contact.zip} {SITE.contact.city}
      </p>
      <p class="text-small text-muted">
        Wir sind zur Teilnahme an einem Streitbeilegungsverfahren vor einer
        Verbraucherschlichtungsstelle weder verpflichtet noch bereit.
      </p>
    </div>
  </section>
</BaseLayout>
