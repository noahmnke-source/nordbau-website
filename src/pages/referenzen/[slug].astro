---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import Prose from '@/components/Prose.astro';

export async function getStaticPaths() {
  const entries = await getCollection('referenzen');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'referenzen'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, ort, jahr, kategorie, hero, gallery, facts, zitat } = entry.data;

/** Metazeile ohne leere Felder (laufende Projekte haben z. B. keinen Ort) */
const metaLine = (e: CollectionEntry<'referenzen'>) =>
  [e.data.ort, e.data.jahr, e.data.kategorie].filter(Boolean).join(' · ');

// „Nächstes Projekt“ entlang der redaktionellen Reihenfolge (order), zyklisch
const alle = (await getCollection('referenzen')).sort((a, b) => a.data.order - b.data.order);
const index = alle.findIndex((e) => e.id === entry.id);
const next = alle.length > 1 ? alle[(index + 1) % alle.length] : undefined;

const breadcrumbs = [
  { name: 'Referenzen', href: '/referenzen/' },
  { name: title, href: `/referenzen/${entry.id}/` },
];

const factRows = [
  { label: 'Wohnfläche', value: facts.wohnflaeche },
  { label: 'Bauzeit', value: facts.bauzeit },
  { label: 'Energiestandard', value: facts.energiestandard },
].filter((row): row is { label: string; value: string } => Boolean(row.value));

/** Galerie: wechselnde Spannen und Formate statt uniformem Raster */
const galleryLayout = [
  { wrap: 'lg:col-span-7', ratio: 'aspect-[4/3]', sizes: '(min-width: 1024px) 54vw, 100vw' },
  { wrap: 'lg:col-span-5 lg:mt-24', ratio: 'aspect-[4/5]', sizes: '(min-width: 1024px) 38vw, 100vw' },
  { wrap: 'lg:col-span-8 lg:col-start-4', ratio: 'aspect-[3/2]', sizes: '(min-width: 1024px) 62vw, 100vw' },
];
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  ogImage={hero.src}
  breadcrumbs={breadcrumbs}
  hideFooterCta
>
  <!-- Seitenkopf -->
  <section class="container-site pt-12 lg:pt-16">
    <Breadcrumbs items={breadcrumbs} class="mb-10" />
    <div class="grid gap-x-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h1 class="font-display text-hero font-medium">{title}</h1>
        <p class="tnum mt-5 text-small text-muted">{metaLine(entry)}</p>
      </div>
    </div>
  </section>

  <!-- Hero-Bild, volle Breite -->
  <div class="mt-10 lg:mt-14">
    <Figure
      src={hero.src}
      alt={hero.alt}
      ratio="aspect-[3/2] sm:aspect-[21/9]"
      sizes="100vw"
      eager
      reveal={false}
      class="w-full"
    />
  </div>

  <!-- Baubericht + Fakten-Register -->
  <section class="container-site pt-14 pb-(--spacing-section) lg:pt-20">
    <div class="grid gap-x-8 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Prose>
          <Content />
        </Prose>
      </div>

      {factRows.length > 0 && (
        <aside class="lg:col-span-4 lg:col-start-9">
          <h2 class="text-caption font-medium text-muted">Das Projekt in Zahlen</h2>
          <dl class="mt-4 divide-y divide-line border-y border-line">
            {factRows.map((row) => (
              <div class="py-5">
                <dt class="text-caption text-muted">{row.label}</dt>
                <dd class="tnum mt-1 font-display text-title font-medium">{row.value}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-5 text-caption text-muted">
            Alle Angaben stammen aus der Baudokumentation dieses Projekts.
          </p>
        </aside>
      )}
    </div>
  </section>

  <!-- Galerie -->
  {gallery.length > 0 && (
    <section class="bg-stone py-(--spacing-section)">
      <div class="container-site grid gap-x-8 gap-y-12 lg:grid-cols-12">
        {gallery.map((bild, i) => {
          const l = galleryLayout[i % galleryLayout.length]!;
          return (
            <Figure
              src={bild.src}
              alt={bild.alt}
              ratio={l.ratio}
              sizes={l.sizes}
              class={l.wrap}
            />
          );
        })}
      </div>
    </section>
  )}

  <!-- Zitat der Baufamilie -->
  {zitat && (
    <section class="container-site py-(--spacing-section)">
      <figure class="reveal mx-auto max-w-3xl border-y border-line py-12 lg:py-16">
        <blockquote class="font-display text-title font-medium">
          „{zitat.text}“
        </blockquote>
        <figcaption class="mt-6 text-small text-muted">{zitat.von}</figcaption>
      </figure>
    </section>
  )}

  <!-- Nächstes Projekt -->
  {next && (
    <section class="container-site pb-(--spacing-section)">
      <a href={`/referenzen/${next.id}/`} class="group block border-t border-line pt-10">
        <p class="text-caption text-muted">Nächstes Projekt</p>
        <p class="mt-3 font-display text-display font-medium">
          <span class="link-line">{next.data.title}</span>
        </p>
        <p class="tnum mt-3 text-small text-muted">{metaLine(next)}</p>
      </a>
    </section>
  )}

  <!-- Abschluss-CTA -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Planen Sie ein vergleichbares Projekt?
        </h2>
        <p class="reveal prose-measure mt-6 text-body text-muted">
          Ob Neubau, Hanglage oder Aufstockung: Im Erstgespräch prüfen wir Grundstück,
          Budget und Zeitplan – und sagen ehrlich, was geht.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 lg:col-span-4 lg:col-start-9 lg:justify-end">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/referenzen/" class="link-line text-small font-medium">
          Alle Referenzen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
