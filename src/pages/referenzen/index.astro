---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';

const projekte = (await getCollection('referenzen')).sort(
  (a, b) => a.data.order - b.data.order
);

/**
 * Asymmetrisches Galerie-Raster: Spannweite, Versatz und Format
 * wechseln je Position – kein uniformes Karten-Grid.
 * Position 0 ist das Featured-Projekt (order 1).
 */
const layout = [
  { wrap: 'lg:col-span-8', ratio: 'aspect-[4/3]', sizes: '(min-width: 1024px) 62vw, 100vw' },
  { wrap: 'lg:col-span-4 lg:self-end', ratio: 'aspect-[4/5]', sizes: '(min-width: 1024px) 30vw, 100vw' },
  { wrap: 'lg:col-span-5 lg:col-start-2 lg:mt-8', ratio: 'aspect-[4/5]', sizes: '(min-width: 1024px) 38vw, 100vw' },
  { wrap: 'lg:col-span-6 lg:col-start-7 lg:mt-28', ratio: 'aspect-[3/2]', sizes: '(min-width: 1024px) 46vw, 100vw' },
  { wrap: 'lg:col-span-8 lg:col-start-3 lg:mt-8', ratio: 'aspect-[21/9]', sizes: '(min-width: 1024px) 62vw, 100vw' },
];
---

<BaseLayout
  title="Fertighaus-Erfahrungen – gebaute Referenzhäuser"
  description="Gebaute Fertighäuser mit Ort, Bauzeit und Wohnfläche – und ein laufendes Projekt im Bautagebuch. So bauen wir: dokumentiert statt inszeniert. Jetzt ansehen."
  breadcrumbs={[{ name: 'Referenzen', href: '/referenzen/' }]}
>
  <!-- Seitenkopf -->
  <section class="container-site pt-12 lg:pt-16">
    <Breadcrumbs items={[{ name: 'Referenzen', href: '/referenzen/' }]} class="mb-10" />

    <div class="grid gap-x-8 gap-y-6 lg:grid-cols-12">
      <h1 class="font-display text-hero font-medium lg:col-span-7">
        Fertighaus-Erfahrungen: gebaute Häuser statt Renderings
      </h1>
      <p class="prose-measure self-end text-body text-muted lg:col-span-4 lg:col-start-9">
        Jedes Projekt auf dieser Seite ist gebaut, übergeben und bewohnt. Wir dokumentieren
        Ort, Wohnfläche und Bauzeit – und die Familien erzählen mit ihrem Namen,
        wie der Bau gelaufen ist.
      </p>
    </div>
  </section>

  <!-- Galerie -->
  <section class="container-site pt-16 pb-(--spacing-section) lg:pt-24">
    <div class="grid gap-x-8 gap-y-16 lg:grid-cols-12">
      {projekte.map((projekt, i) => {
        const l = layout[i % layout.length]!;
        return (
          <a href={`/referenzen/${projekt.id}/`} class:list={['group block', l.wrap]}>
            <Figure
              src={projekt.data.hero.src}
              alt={projekt.data.hero.alt}
              ratio={l.ratio}
              sizes={l.sizes}
              zoom
            />
            <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h2 class="font-display text-title font-medium">
                <span class="link-line">{projekt.data.title}</span>
              </h2>
              <p class="tnum text-small text-muted">
                {[projekt.data.ort, projekt.data.jahr, projekt.data.facts.wohnflaeche]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Abschluss-CTA -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Ihr Projekt könnte das nächste auf dieser Seite sein.
        </h2>
        <p class="reveal prose-measure mt-6 text-body leading-relaxed text-paper-muted">
          Im Erstgespräch klären wir Grundstück, Budget und Zeitplan –
          unverbindlich, mit ehrlichen Zahlen und ohne Verkaufsdruck.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 lg:col-span-4 lg:col-start-9 lg:justify-end">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/haustypen/" class="link-line text-small font-medium text-paper">
          Haustypen ansehen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
