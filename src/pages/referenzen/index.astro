---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';

/**
 * Realisierte Projekte aus dem Nordbau-Verbund (Holzbau-Portfolio + übernommene
 * Kompetenzen der Eco Bau GmbH → Hannover Nordbau GmbH). Ort-genau, ohne
 * Straßenangabe. Fotos aus den Projektunterlagen unter public/referenzen/.
 */
const wohnhaeuser = [
  {
    ort: 'Freising', typ: 'Einfamilienhaus', img: '/referenzen/freising-efh.webp',
    fakt: '180 m² · Satteldach, Garage, kontrollierte Wohnraumlüftung',
    beschreibung: 'Zweigeschossiges Einfamilienhaus mit 180 m² Wohnfläche: ein traditionelles Satteldach in moderner Ausführung, mit hellem Wohnraum, funktionaler Küche samt Essbereich, Hauswirtschaftsraum, Arbeitsplatz, drei Schlafzimmern und Garage. Eine Lüftungsanlage sorgt für frische Luft und hohe Energieeffizienz.',
  },
  {
    ort: 'Northeim', typ: 'Einfamilienhaus', img: '/referenzen/northeim-efh.webp',
    fakt: '160 m² · zwei Geschosse, Holz- und HPL-Fassade',
    beschreibung: 'Modernes Einfamilienhaus über zwei Ebenen, 160 m². Im Erdgeschoss Wohnen, Küche, Büro, Bad und Technik; im Obergeschoss zwei Terrassen, Eltern- und ein weiteres Schlafzimmer sowie ein Bad. Die Fassade aus HPL und Holz ergibt eine elegante, langlebige Hülle.',
  },
  {
    ort: 'Uslar', typ: 'Einfamilienhaus', img: '/referenzen/uslar-efh.webp',
    fakt: '220 m² · zwei Geschosse, drei Schlafzimmer, Garage',
    beschreibung: 'Einfamilienhaus mit 220 m² Nutzfläche auf zwei Ebenen. Das Erdgeschoss vereint Wohn- und Esszimmer, Küche, Hauswirtschaftsraum, Büro und Garage; im Obergeschoss liegen drei Schlafzimmer inklusive Elternzimmer, ein Bad und eine Terrasse. Materialien und Farben fügen sich harmonisch in die Umgebung ein.',
  },
  {
    ort: 'Nieder-Winkling', typ: 'Einfamilienhaus', img: '/referenzen/niederwinkling-efh.webp',
    fakt: '160 m² · Satteldach, energieeffizient in Holzbauweise',
    beschreibung: 'Zweigeschossiges Einfamilienhaus mit 160 m², traditionellem Satteldach und moderner Anmutung. Effiziente Materialien für den Holzbau und eine natürliche Dämmung sorgen für stabile Innentemperaturen über das ganze Jahr und einen niedrigen Energieverbrauch.',
  },
  {
    ort: 'Regensburg', typ: 'Modulhaus', img: '/referenzen/regensburg-modulhaus.webp',
    fakt: '45 m² · Brettsperrholz (CLT), werkseitig vorgefertigt',
    beschreibung: 'Kompaktes Modulhaus mit 45 m² für Wohnraum, Essbereich, Küche, Bad und ein Schlafzimmer. Gebaut in Brettsperrholz (CLT): hohe Langlebigkeit, schnelle Montage und Energieeffizienz. Alle Bauteile entstehen werkseitig – für kontrollierte Qualität und minimale Bauzeit vor Ort.',
  },
  {
    ort: 'Göteborg (SE)', typ: 'Einfamilienhaus', img: '/referenzen/goeteborg-efh.webp',
    fakt: '91 m² · gedämmt für kaltes Klima, Holzbauweise',
    beschreibung: 'Funktionales Einfamilienhaus mit 91 m², ausgelegt auch für kaltes Klima wie in Schweden. Heller Wohnraum mit großen Fenstern, offen verbunden mit Ess- und Küchenbereich, dazu zwei Schlafzimmer und ein praktisches Bad. Sehr gute Dämmung und nachhaltiger Holzbau für Komfort und Langlebigkeit.',
  },
  {
    ort: 'Zürich (CH)', typ: 'Hotel', img: '/referenzen/zuerich-hotel.webp',
    fakt: '650 m² · drei Ebenen, 16 Zimmer, Holz- und HPL-Fassade',
    beschreibung: 'Luxushotel über drei Ebenen mit 16 Zimmern und 650 m² Gesamtfläche. Großzügige Terrassen und weite Ausblicke in die Natur; die Fassade aus HPL (Fundermax) und Holz gibt dem Gebäude ein elegantes, natürliches Erscheinungsbild und hohe Witterungsbeständigkeit.',
  },
];

const bauten = [
  {
    ort: 'Ronnenberg', typ: 'Kindertagesstätte', img: '/referenzen/ronnenberg-kita.webp',
    fakt: 'Holzrahmenbau, fünf Gruppen · 2022–2023',
    beschreibung: 'Neubau einer Kindertagesstätte in Holzrahmenbauweise in Empelde für die Stadt Ronnenberg. Eingeschossig, mit fünf Gruppenbereichen, Ruheräumen, Kinderbädern und großzügigen Spielfluren; eine nachhaltige, energieeffiziente Gebäudehülle sorgt für angenehmes Raumklima. Rohbau und Innenausbau, 2022–2023.',
  },
  {
    ort: 'Sulzbach-Rosenberg', typ: 'Kindergarten', img: '/referenzen/sulzbach-kindergarten.webp',
    fakt: '1.200 m² · Neubau in Holzbauweise',
    beschreibung: 'Moderner Kindergarten mit rund 1.200 m² Fläche in Holzbauweise. Sichere, flexible Räume für Lernen und Spiel fördern die soziale, kognitive und motorische Entwicklung der Kinder; natürliche Materialien und offene Bereiche stärken das Wohlbefinden.',
  },
  {
    ort: 'Hannover', typ: 'Büro- und Verwaltungsgebäude', img: '/referenzen/hannover-citygate.webp',
    fakt: 'City Gate Nord · 10.500 m² BGF · 2023–2025',
    beschreibung: 'Zweiter Bauabschnitt des Büro- und Verwaltungskomplexes City Gate Nord in Vahrenwald – rund 10.500 m² BGF über sechs Geschosse. Ein energieeffizienter, flexibel nutzbarer Verwaltungsbau nach DGNB-Standards; Tiefbau, Rohbau und Innenausbau bei laufendem Betrieb des ersten Bauabschnitts. 2023–2025.',
  },
  {
    ort: 'Stuttgart', typ: 'Wohn- und Geschäftshaus', img: '/referenzen/stuttgart-maybach.webp',
    fakt: '70 Wohneinheiten · 7 OG + 3 UG Tiefgarage · 2019–2023',
    beschreibung: 'Wohn- und Geschäftshaus mit dreigeschossiger Tiefgarage und sieben Obergeschossen. 70 Wohneinheiten inklusive Penthäusern, darunter Gewerbe- und Büroflächen; hohe Anforderungen an Schall- und Brandschutz. Rohbau und Innenausbau in innerstädtischer Lage, 2019–2023.',
  },
  {
    ort: 'Braunschweig', typ: 'Städtisches Klinikum', img: '/referenzen/braunschweig-klinikum.webp',
    fakt: 'Innenausbau EG–5. OG, medizinischer Hochbau · 2021–2023',
    beschreibung: 'Innenausbau eines medizinischen Großprojekts am Städtischen Klinikum Braunschweig – vom Erdgeschoss bis zum fünften Obergeschoss samt Technikbereichen. Trockenbau, Installationswände, hygienische Oberflächen und Brandschutz unter strengen medizinischen Auflagen, eng getaktet mit Medizintechnik, HKLS und Elektro. 2021–2023.',
  },
];

---

<BaseLayout
  title="Referenzen – Projekte von Nordbau"
  description="Projekte von Nordbau: realisierte Wohnhäuser, Kitas und Gewerbebauten in Holzbauweise aus über einem Jahrzehnt Erfahrung – dokumentiert auch mitten im Bau."
  breadcrumbs={[{ name: 'Referenzen', href: '/referenzen/' }]}
  hideFooterCta
>
  <!-- Seitenkopf -->
  <section class="container-site pt-12 lg:pt-16">
    <Breadcrumbs items={[{ name: 'Referenzen', href: '/referenzen/' }]} class="mb-10" />

    <div class="grid gap-x-8 gap-y-6 lg:grid-cols-12">
      <h1 class="font-display text-hero font-medium lg:col-span-7">
        Unsere Projekte – auch mitten im Bau
      </h1>
    </div>
  </section>

  <!-- München-Projekt: Fotos + Bezeichnung, bewusst ohne Link/Detailseite -->
  <section class="container-site pt-16 pb-(--spacing-section) lg:pt-24">
    <article>
      <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <Figure
            src="/projekte/muenchen-einfamilienhaus-1-1600.webp"
            alt="Einfamilienhaus im Bau: Giebelseite mit neuer Holzfassade, offener Dachstuhl und Baugerüst, Kran an der Straßenseite"
            ratio="aspect-[16/9]"
            sizes="(min-width: 1024px) 56vw, 100vw"
            eager
            reveal={false}
            zoom
          />
        </div>
        <div class="lg:col-span-5 lg:mt-20">
          <Figure
            src="/projekte/muenchen-einfamilienhaus-2-1600.webp"
            alt="Luftaufnahme der Baustelle: neue Dachkonstruktion mit Lattung, Holzfassade am Anbau, Gerüst rundum"
            ratio="aspect-[4/3]"
            sizes="(min-width: 1024px) 40vw, 100vw"
            zoom
          />
        </div>
      </div>
      <p class="mt-7 font-display text-title font-medium">München: Einfamilienhaus im Bau</p>
    </article>
  </section>

  <!-- Realisierte Projekte: Foto + Text, aus den Projektunterlagen -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <div class="grid gap-x-8 gap-y-6 lg:grid-cols-12">
        <h2 class="reveal font-display text-display font-medium lg:col-span-7">
          Realisierte Projekte aus über einem Jahrzehnt Holzbau
        </h2>
        <p class="reveal prose-measure self-end text-body text-muted lg:col-span-4 lg:col-start-9">
          Vom Einfamilienhaus bis zum öffentlichen Gebäude – eine Auswahl gebauter
          Projekte aus dem Nordbau-Verbund, dokumentiert auch mitten im Bau.
        </p>
      </div>

      <h3 class="reveal mt-16 text-caption tracking-wide text-muted uppercase">Wohnhäuser in Holzbauweise</h3>
      <div class="mt-10 grid gap-y-(--spacing-section-sm)">
        {wohnhaeuser.map((p) => (
          <article class="grid gap-x-8 gap-y-6 lg:grid-cols-12 lg:items-center">
            <Figure
              src={p.img}
              alt={`${p.typ} in ${p.ort}`}
              ratio="aspect-[4/3]"
              sizes="(min-width: 1024px) 56vw, 100vw"
              reveal
              zoom
              class="lg:col-span-7"
            />
            <div class="reveal lg:col-span-4 lg:col-start-9">
              <p class="font-display text-title font-medium">
                {p.ort} <span class="text-muted">· {p.typ}</span>
              </p>
              <p class="prose-measure mt-4 text-body text-muted">{p.beschreibung}</p>
              <p class="mt-4 text-small text-muted">{p.fakt}</p>
            </div>
          </article>
        ))}
      </div>

      <h3 class="reveal mt-24 text-caption tracking-wide text-muted uppercase">Öffentliche &amp; gewerbliche Bauten</h3>
      <div class="mt-10 grid gap-y-(--spacing-section-sm)">
        {bauten.map((p) => (
          <article class="grid gap-x-8 gap-y-6 lg:grid-cols-12 lg:items-center">
            <Figure
              src={p.img}
              alt={`${p.typ} in ${p.ort}`}
              ratio="aspect-[4/3]"
              sizes="(min-width: 1024px) 56vw, 100vw"
              reveal
              zoom
              class="lg:col-span-7"
            />
            <div class="reveal lg:col-span-4 lg:col-start-9">
              <p class="font-display text-title font-medium">
                {p.ort} <span class="text-muted">· {p.typ}</span>
              </p>
              <p class="prose-measure mt-4 text-body text-muted">{p.beschreibung}</p>
              <p class="mt-4 text-small text-muted">{p.fakt}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Abschluss-CTA (der Footer-CTA ist auf dieser Seite ausgeblendet) -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Ihr Projekt könnte das nächste auf dieser Seite sein.
        </h2>
        <p class="reveal prose-measure mt-6 text-body leading-relaxed text-paper-muted">
          Im Erstgespräch klären wir Grundstück, Budget und Zeitplan – unverbindlich,
          mit ehrlichen Zahlen und ohne Verkaufsdruck.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 lg:col-span-4 lg:col-start-9 lg:justify-end">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/haustypen/" class="link-line text-small font-medium text-paper">
          Haustypen ansehen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
