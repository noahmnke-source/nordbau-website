---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import { IMG } from '@/data/assets';
import { SITE, YEARS_EXPERIENCE } from '@/config/site';

const zahlen = [
  {
    wert: `seit ${SITE.foundingYear}`,
    label: `${YEARS_EXPERIENCE} Jahre am Bau – vom Rohbau über die Sanierung bis zum schlüsselfertigen Verwaltungsgebäude.`,
  },
  {
    wert: 'Familienbetrieb',
    label: 'Inhabergeführt in zweiter Generation. Entscheidungen fallen im Haus, nicht in einer Konzernzentrale – und wer den Vertrag unterschreibt, ist auch nach der Übergabe noch erreichbar.',
  },
  {
    wert: '5 Jahre',
    label: 'Garantie auf die Baukonstruktion und Gewährleistung nach BGB auf alle übrigen Leistungen – alle wesentlichen Materialien mit Qualitätszertifikat.',
  },
  {
    wert: '7 + 3',
    label: 'Bis sieben Obergeschosse und drei Untergeschosse ausgeführt – Untergeschosse in wasserundurchlässiger Bauweise, oben Stahlbeton, Mauerwerk oder Holz.',
  },
  {
    wert: 'Massiv + Holz',
    label: 'Stahlbeton und Mauerwerk auf der Baustelle, Holzrahmen und Brettsperrholz (CLT) aus eigener Fertigung – die Bauweise entscheidet das Projekt.',
  },
];

const grundsaetze = [
  {
    titel: 'Gebaut wird, was gezeichnet ist.',
    text: 'Ein Plan ist bei uns kein Vorschlag, sondern ein Versprechen. Was in Entwurf, Bau- und Leistungsbeschreibung und Bemusterungsprotokoll steht, wird so gebaut – zum vereinbarten Preis, zum vereinbarten Termin. Überraschungen auf der Baustelle sind kein Schicksal, sondern das Ergebnis unpräziser Planung. Deshalb investieren wir die Sorgfalt vorn, wo sie günstig ist, statt hinten, wo sie teuer wird.',
    cols: 'lg:col-span-6 lg:col-start-1',
  },
  {
    titel: 'Präzision ist eine Frage des Ortes.',
    text: 'Millimeterarbeit gelingt dort, wo die Bedingungen kontrollierbar sind – nicht bei Regen auf dem Gerüst. Darum verlagern wir so viele Arbeitsschritte wie möglich ins Werk und lassen auf der Baustelle nur montieren, was dort montiert werden muss. Dass der Bau dadurch schneller wird, ist ein angenehmer Nebeneffekt. Der Grund ist ein anderer: Qualität, die man prüfen und dokumentieren kann.',
    cols: 'lg:col-span-6 lg:col-start-5',
  },
  {
    titel: 'Ein Haus ist erst fertig, wenn es sich bewährt hat.',
    text: 'Fünf Jahre Garantie auf die Baukonstruktion und Gewährleistung nach BGB sind für uns keine Frist, die man aussitzt, sondern ein Zeitraum, in dem wir erreichbar bleiben: mit festem Ansprechpartner, Wartungshinweisen und der Hausakte, die jede Entscheidung nachvollziehbar macht. Wer ein Haus für Jahrzehnte baut, darf nach der Übergabe nicht verschwinden.',
    cols: 'lg:col-span-6 lg:col-start-3',
  },
];
---

<BaseLayout
  title={`Über uns – Bauunternehmen aus Hannover seit ${SITE.foundingYear}`}
  description={`Familiengeführtes Bauunternehmen aus Hannover: Rohbau in Stahlbeton, Mauerwerk und Holz, dazu eigene Fertigung für Holzbauteile. ${YEARS_EXPERIENCE} Jahre am Bau. Lernen Sie ${SITE.name} kennen.`}
  breadcrumbs={[{ name: 'Über uns', href: '/ueber-uns/' }]}
  heroOverlay
  hideFooterCta
>
  <!-- Hero: Bild vollflaechig, Text darauf – wie auf den Leistungsseiten -->
  <section class="relative flex min-h-[62svh] flex-col justify-end bg-graphite text-paper lg:min-h-[72svh]">
    <div class="absolute inset-0 overflow-hidden">
      <img
        src={IMG.rohbauKranwald.src}
        alt={IMG.rohbauKranwald.alt}
        sizes="100vw"
        class="h-full w-full object-cover"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-graphite/90 via-graphite/50 to-graphite/38"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="container-site relative pt-36 pb-14 lg:pb-20">
      <div class="grid gap-x-8 lg:grid-cols-12">
        <div class="lg:col-span-9">
          <h1 class="hero-line font-display text-hero font-medium">
            Ein Bauunternehmen in zweiter Generation
          </h1>
          <p
            class="hero-line prose-measure mt-5 font-display text-title font-medium text-paper/85"
            style="--line-delay: 140ms"
          >
            Seit {SITE.foundingYear} am Bau. Massiv und in Holz – die Bauweise entscheidet
            das Projekt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Einordnung unter dem Hero -->
  <section class="container-site pt-16 lg:pt-24">
    <p class="prose-measure text-body text-muted">
      {SITE.legalName} ist seit {SITE.foundingYear} am Bau – {YEARS_EXPERIENCE} Jahre,
      inhabergeführt und in zweiter Generation. Unsere Leitleistung ist der Rohbau;
      gebaut haben wir für Bauträger, Gewerbe und die öffentliche Hand.
    </p>
  </section>

  <!-- Haltung: großes Statement -->
  <section class="container-site py-(--spacing-section)">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Wir wählen die Bauweise nach dem Projekt – nicht nach dem Maschinenpark, den wir zufällig besitzen.
        </h2>
        <p class="reveal prose-measure mt-8 text-body text-muted">
          Die meisten Bauunternehmen können eines von beiden: Stahlbeton oder Holz. Wer nur
          eines kann, empfiehlt am Ende immer dasselbe. Wir führen beides aus und entscheiden
          nach Spannweite, Brandschutz, Untergeschossen und Terminplan. Was das in der Praxis
          heißt: gleiche Handgriffe, gleiche Prüfungen, gleiche Toleranzen – bei einem
          Siebengeschosser in der Innenstadt wie bei einer eingeschossigen Kita. Individuell
          ist jedes Projekt. Gleich bleibt die Genauigkeit, mit der es gebaut wird.
        </p>
        <p class="reveal prose-measure mt-5 text-body text-muted">
          Seit {SITE.foundingYear} arbeiten wir nach diesem Prinzip. Den Schwerpunkt bildet
          seit jeher der Rohbau – Gründung, Tragwerk, Decken – dazu kam über die Jahre die
          eigene Fertigung für Holz- und Hybridtragwerke. Was gleich geblieben ist: Es ist
          ein Familienbetrieb, in dem die Verantwortlichen mit Namen bekannt sind.
        </p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <Figure
          src={IMG.rohbauSkelett.src}
          alt={IMG.rohbauSkelett.alt}
          ratio="aspect-[4/5]"
          sizes="(min-width: 1024px) 30vw, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- Wie wir arbeiten: Baustelle statt Werkhalle -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="Was einen Rohbau trägt, entsteht vor dem ersten Kubikmeter Beton"
      />

      <div class="mt-16 grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-center">
        <div class="reveal lg:col-span-5">
          <p class="prose-measure text-body text-muted">
            Vor dem ersten Arbeitstag steht die Arbeitsvorbereitung: Schal- und
            Bewehrungspläne gegen die Statik geprüft, Betonsorten und Expositionsklassen
            festgelegt, Einbauteile und Durchdringungen mit den Fachplanern abgestimmt.
            Was hier geklärt ist, muss später niemand aufstemmen. Was hier fehlt, findet
            sich im Nachtrag wieder.
          </p>
          <p class="prose-measure mt-5 text-body text-muted">
            Auf der Baustelle wird eingemessen und protokolliert: Gründungshöhen,
            Achsmaße, Öffnungen, Betondeckung vor dem Betonieren. Diese Protokolle
            gehören zur Dokumentation, die Sie bei der Abnahme erhalten. Das ist kein
            Selbstzweck – jede Abweichung, die im Rohbau unentdeckt bleibt, kostet im
            Ausbau ein Vielfaches.
          </p>
        </div>
        <Figure
          src={IMG.rohbauSchalung.src}
          alt={IMG.rohbauSchalung.alt}
          ratio="aspect-[4/3]"
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="lg:col-span-6 lg:col-start-7"
        />
      </div>

      <div class="mt-16 grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-center">
        <Figure
          src={IMG.rohbauBewehrung.src}
          alt={IMG.rohbauBewehrung.alt}
          ratio="aspect-[4/3]"
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="lg:col-span-6"
        />
        <p class="reveal prose-measure text-body text-muted lg:col-span-5 lg:col-start-8">
          Gearbeitet wird mit eigenen Kolonnen – dieselben Leute, eingespielt über Jahre,
          vom Erdaushub bis zu der Stufe, die Sie beauftragt haben. Ein Bauleiter, ein
          Aufmaß, eine Verantwortung. So bleibt die Verantwortung dort, wo sie hingehört:
          bei uns.
        </p>
      </div>
    </div>
  </section>

  <!-- Wo wir bauen -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro
      title="Wo wir bauen"
    />

    <div class="mt-16 grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <div class="reveal lg:col-span-5">
        <dl class="divide-y divide-line border-y border-line">
          {[
            { k: 'Sitz', v: 'Verwaltung und Bauleitung in Hannover' },
            { k: 'Bauweisen', v: 'Stahlbeton, Mauerwerk, Holzrahmenbau und Brettsperrholz (CLT)' },
            { k: 'Gebaut wird in', v: 'Ganz Europa' },
            { k: 'Leistungstiefe', v: 'Tiefbau, Rohbau, Rohbau mit geschlossener Gebäudehülle oder schlüsselfertig' },
          ].map((z) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="text-caption text-muted">{z.k}</dt>
              <dd class="text-small leading-relaxed">{z.v}</dd>
            </div>
          ))}
        </dl>
        <p class="prose-measure mt-6 text-small leading-relaxed text-muted">
          Baustellenlogistik ist bei uns Teil der Planung, nicht ihr Nebenprodukt:
          Zufahrt, Kranstellfläche, Lagerplatz und Anlieferzeiten klären wir, bevor das
          erste Fahrzeug kommt. In innerstädtischer Lage entscheidet genau das darüber,
          ob der Terminplan hält.
        </p>
      </div>

      <div class="grid content-start gap-6 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
        {[IMG.rohbauKraene, IMG.rohbauMauerwerk, IMG.rohbauDecke, IMG.rohbauNacht].map((bild, i) => (
          <Figure
            src={bild.src}
            alt={bild.alt}
            ratio={i % 3 === 0 ? 'aspect-[4/3]' : 'aspect-square'}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 45vw, 100vw"
            class={i % 3 === 0 ? 'sm:col-span-2' : ''}
            zoom
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Zahlen: Anthrazit-Drench, Register statt Stat-Karten -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site">
      <h2 class="reveal font-display text-display font-medium">
        Was hinter dem Namen steht
      </h2>
      <dl class="mt-14 divide-y divide-paper/10 border-y border-paper/10">
        {zahlen.map((z) => (
          <div class="reveal grid gap-2 py-7 sm:grid-cols-[minmax(10rem,17rem)_1fr] sm:gap-8">
            <dt class="tnum font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-tight font-medium hyphens-auto break-words">{z.wert}</dt>
            <dd class="prose-measure self-center text-body leading-relaxed text-paper-muted">{z.label}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-10 max-w-2xl text-small text-paper-muted">
        Mittelständisch geführt, kurze Wege: Wer bei uns baut, kennt die Menschen, die
        kalkulieren, planen und auf der Baustelle stehen.
      </p>
    </div>
  </section>

  <!-- Woran wir glauben: Fließtext-Absätze, versetzt gesetzt -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro title="Woran wir glauben" />
    <div class="mt-16 grid gap-x-8 gap-y-14 lg:grid-cols-12">
      {grundsaetze.map((g) => (
        <div class:list={['reveal', g.cols]}>
          <h3 class="font-display text-title font-medium">{g.titel}</h3>
          <p class="prose-measure mt-4 text-body text-muted">{g.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Besuch + CTA -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site grid gap-x-8 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Sehen Sie es sich an, bevor Sie uns glauben.
        </h2>
        <p class="reveal prose-measure mt-6 text-body text-muted">
          Ein Text kann Präzision behaupten – ein Haus muss sie zeigen. Besuchen Sie
          unser Musterhaus, öffnen Sie Fenster, Türen und Schränke, und stellen Sie
          die Fragen, die Prospekte nicht beantworten. Oder beginnen Sie mit einem
          Erstgespräch: 30&nbsp;Minuten, unverbindlich, mit ehrlichen Zahlen.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 self-end lg:col-span-4 lg:col-start-9">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero-Zeilen laufen beim Laden von unten ein – gleiche Bewegung wie auf den
     Leistungsseiten. */
  .hero-line {
    animation: hero-rise 0.8s var(--ease-out-expo) both;
    animation-delay: var(--line-delay, 0ms);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line {
      animation: none;
    }
  }
</style>
