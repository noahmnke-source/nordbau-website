---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VideoHero from '@/components/VideoHero.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import MaterialSlider from '@/components/MaterialSlider.astro';
import { IMG } from '@/data/assets';
import { SITE, YEARS_EXPERIENCE } from '@/config/site';
import { buildFaqJsonLd } from '@/lib/seo';

const hausTeaser = [
  {
    name: 'Bungalow',
    href: '/haeuser/bungalow/',
    fakt: 'ab 95 m² · eine Ebene',
    img: IMG.bungalowGold,
  },
  {
    name: 'Modulhaus',
    href: '/haeuser/modulhaus/',
    fakt: 'ab 75 m² · erweiterbar',
    img: IMG.modulhaus,
  },
  {
    name: 'Tiny Haus',
    href: '/haeuser/tiny-haus/',
    fakt: 'ab 35 m² · kompakt',
    img: IMG.fassadeRot,
  },
];


const zahlen = [
  { wert: `seit ${SITE.foundingYear}`, label: `${YEARS_EXPERIENCE} Jahre Erfahrung am Bau – vom Fertighaus in Holztafelbauweise bis zum öffentlichen Gebäude` },
  { wert: '30 Jahre', label: 'Garantie auf die Baukonstruktion, dazu 5 Jahre Gewährleistung nach BGB auf alle übrigen Leistungen' },
  { wert: '12 Monate', label: 'Festpreisgarantie ab Vertragsabschluss, unabhängig von Materialpreisen' },
  { wert: 'EH 40', label: 'Effizienzhaus-Standard ab Werk – Voraussetzung für die KfW-Förderung 297/298' },
];

const faq = [
  {
    /* Bewusst als erste Frage und bewusst definitorisch formuliert: Der Absatz
       beantwortet „Was macht die EcoBau GmbH?" vollstaendig und ohne Kontext
       davor. Genau solche in sich geschlossenen Absaetze zitieren
       KI-Antwortsysteme und Googles Uebersicht mit KI. */
    q: 'Was macht die EcoBau GmbH?',
    a: 'Die EcoBau GmbH ist ein familiengeführtes Bauunternehmen und Fertighaus-Hersteller aus Hannover, seit 1994 am Bau. Wir planen und bauen schlüsselfertige, individuell entworfene Häuser in Holztafelbauweise: Einfamilienhäuser mit Satteldach oder Flachdach, Bungalows, Modulhäuser und Tiny Häuser. Die Wand-, Decken- und Dachelemente entstehen witterungsunabhängig in unserem eigenen Werk und werden auf dem Grundstück montiert. Jedes Haus erfüllt ab Werk den Effizienzhaus-40-Standard und ist damit KfW-förderfähig; dazu kommen eine Festpreisgarantie über zwölf Monate ab Vertragsabschluss und 30 Jahre Garantie auf die Baukonstruktion. Neben Wohnhäusern errichten wir größere Gebäude: Mehrfamilienhäuser, Büro- und Verwaltungsgebäude, Hotels sowie Kindertagesstätten, Schulen und Kliniken – schlüsselfertig für eigene Auftraggeber oder als abgegrenztes Leistungspaket für Generalunternehmer.',
  },
  {
    q: 'Was kostet ein Fertighaus von EcoBau?',
    a: 'Das hängt von Haustyp, Wohnfläche, Ausstattung und Grundstück ab. Statt einer Katalogzahl erhalten Sie bei uns nach einem unverbindlichen Erstgespräch ein individuelles Festpreisangebot – transparent kalkuliert, mit 12 Monaten Preisgarantie ab Vertragsabschluss. Grundstück und Baunebenkosten kommen zum Hauspreis hinzu.',
  },
  {
    q: 'Wie lange dauert der Bau eines Fertighauses?',
    a: 'Eine allgemeine Wochenzahl wäre unseriös: Die Dauer hängt an der Bearbeitungszeit der Bauaufsicht, an Ihrer Finanzierung, am Baugrund und am Witterungsverlauf – Faktoren, die nicht in unserer Hand liegen. Was die Vorfertigung leistet, ist die Verlagerung des Rohbaus in die Halle: Auf der Baustelle wird montiert, nicht gebaut. Einen belastbaren Terminplan für Ihr Vorhaben bekommen Sie, sobald Grundstück und Genehmigungslage geklärt sind.',
  },
  {
    q: 'Was bedeutet „schlüsselfertig“ genau?',
    a: '„Schlüsselfertig“ ist kein gesetzlich definierter Begriff – den Leistungsumfang legt die Bau- und Leistungsbeschreibung fest. Bei uns heißt es: bezugsfertig inklusive Bädern, Böden und Innentüren. Vergleichen Sie Angebote grundsätzlich nur bei identischem Leistungsumfang.',
  },
  {
    q: 'Kann ich ein Fertighaus komplett individuell planen?',
    a: 'Ja – das ist bei uns der Normalfall. Die Entwürfe auf dieser Website sind Anschauung, kein Bestellkatalog: Jedes Haus wird von einem Architekten für sein Grundstück neu gezeichnet, mit eigenem Grundriss, eigener Fassade und eigener Dachform. Die Vorfertigung im Werk schränkt die Gestaltung kaum ein. Sie können auch mit einem eigenen Architekten kommen – dann übernehmen wir ab der Werkplanung.',
  },
  {
    q: 'Welche KfW-Förderung gibt es 2026 für den Hausbau?',
    a: 'Über „Klimafreundlicher Neubau“ (KfW 297/298) gibt es zinsverbilligte Kredite bis 150.000 Euro pro Wohneinheit ab Effizienzhaus-40-Standard. Familien mit Kind und maximal 90.000 Euro zu versteuerndem Einkommen können alternativ KfW 300 mit bis zu 270.000 Euro nutzen.',
  },
];
---

<BaseLayout
  title={`Fertighäuser und Gebäude aus Hannover – schlüsselfertig gebaut | ${SITE.name}`}
  fullTitle
  description="Familiengeführtes Bauunternehmen aus Hannover: individuell geplante Fertighäuser in Holztafelbauweise aus eigener Fertigung, dazu Mehrfamilienhäuser, Gewerbebauten sowie Gebäude für Bildung und Soziales. Effizienzhaus 40 ab Werk."
  heroOverlay
  jsonLd={[buildFaqJsonLd(faq)]}
>
  <!-- Hero -->
  <VideoHero poster={IMG.heroHome}>
    <div class="max-w-3xl">
      <h1 class="hero-line font-display text-hero font-medium">
        Wir bauen Häuser. Und Gebäude.
      </h1>
      <p class="hero-line prose-measure mt-6 text-body text-paper/85" style="--line-delay: 180ms">
        {SITE.legalName} aus {SITE.contact.city} — schlüsselfertige Fertighäuser in
        Holztafelbauweise, dazu Mehrfamilienhäuser, Gewerbebauten und Gebäude für
        Bildung und Soziales. Familienbetrieb seit {SITE.foundingYear}.
      </p>
      <div class="hero-line mt-10 flex flex-wrap items-center gap-6" style="--line-delay: 320ms">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/haeuser/einfamilienhaus/" class="link-line text-small font-medium text-paper">
          Entwürfe ansehen
        </a>
      </div>
    </div>
  </VideoHero>

  <!-- Zwei Einstiege: Die Seite bedient zwei Zielgruppen mit sehr
       unterschiedlichen Fragen. Wer als Bauunternehmen kommt, soll sich im
       ersten Bildschirm einsortieren koennen und nicht sechs Abschnitte
       ueber Grundrisse durchscrollen muessen. -->
  <section class="container-site py-(--spacing-section-sm)">
    <div class="grid divide-y divide-line border-y border-line lg:grid-cols-2 lg:divide-x lg:divide-y-0">
      <a href="/haeuser/einfamilienhaus/" class="group/weg block py-8 lg:pr-10">
        <p class="text-caption tracking-wide text-muted uppercase">Für private Bauherren</p>
        <p class="mt-3 font-display text-title font-medium">
          Ihr Haus, individuell geplant und schlüsselfertig
        </p>
        <p class="prose-measure mt-3 text-small text-muted">
          Einfamilienhaus, Bungalow, Modulhaus oder Tiny Haus – gezeichnet für Ihr
          Grundstück, gefertigt im eigenen Werk. Effizienzhaus 40, Festpreis über zwölf Monate.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-small font-medium text-oxide">
          Zu den Häusern
          <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover/weg:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
        </span>
      </a>

      <a href="/wohn-und-gewerbebau/mehrfamilienhaeuser/" class="group/weg block py-8 lg:pl-10">
        <p class="text-caption tracking-wide text-muted uppercase">Für Bauherren, Gewerbe und Kommunen</p>
        <p class="mt-3 font-display text-title font-medium">
          Wohn- und Gewerbebau
        </p>
        <p class="prose-measure mt-3 text-small text-muted">
          Mehrfamilienhäuser, Büro- und Verwaltungsgebäude, Kitas und Kliniken —
          schlüsselfertig oder in einzelnen Leistungsphasen. Gebaut bis rund 10.500 m² BGF.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-small font-medium text-oxide">
          Zum Wohn- und Gewerbebau
          <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover/weg:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
        </span>
      </a>
    </div>
  </section>

  <!-- USP: Statement + Belege -->
  <section class="container-site py-(--spacing-section)">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Ein Haus ist kein Produkt von der Stange. Unsere Bauweise schon&nbsp;– im besten Sinn.
        </h2>
        <p class="reveal prose-measure mt-8 text-body text-muted">
          Jedes Haus von {SITE.name} entsteht zweimal: zuerst millimetergenau im Werk, dann
          auf Ihrem Grundstück. Die Präzision der seriellen Fertigung trifft auf einen
          Grundriss, den es genau einmal gibt – Ihren. Das Ergebnis ist planbar in Preis
          und Termin, ohne dass Architektur zur Verhandlungsmasse wird.
        </p>
        <dl class="reveal mt-12 divide-y divide-line border-y border-line">
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="tnum font-display text-title font-medium text-oxide">12 Monate</dt>
            <dd class="self-center text-small text-muted">Festpreisgarantie ab Vertragsabschluss – Ihr Budget bleibt Ihr Budget.</dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="tnum font-display text-title font-medium text-oxide">30 Jahre</dt>
            <dd class="self-center text-small text-muted">Garantie auf die Baukonstruktion, dazu 5 Jahre Gewährleistung nach BGB auf alle übrigen Leistungen.</dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="tnum font-display text-title font-medium text-oxide">EH 40</dt>
            <dd class="self-center text-small text-muted">Effizienzhaus 40 ab Werk: Wärmepumpe, Lüftungsanlage, PV-Vorbereitung inklusive.</dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="tnum font-display text-title font-medium text-oxide">Eigenes Werk</dt>
            <dd class="self-center text-small text-muted">Wand-, Decken- und Dachelemente entstehen witterungsgeschützt in unserer eigenen Fertigung.</dd>
          </div>
        </dl>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <Figure
          src={IMG.elementmontage.src}
          alt={IMG.elementmontage.alt}
          ratio="aspect-[4/5]"
          sizes="(min-width: 1024px) 30vw, 100vw"
          parallax={0.06}
        />
      </div>
    </div>
  </section>

  <!-- Warum Holz: Materialvorteile (Fakten des Baustoffs, kein Icon-Raster) -->
  <section class="py-(--spacing-section) pt-0">
    <div class="container-site">
      <SectionIntro
        title="Warum wir in Holz bauen"
        lead="Holztafelbau ist nicht nur schnell und präzise. Der Baustoff selbst bringt Eigenschaften mit, die kein anderer hat."
      />
      <dl class="mt-16 grid gap-x-16 gap-y-12 sm:grid-cols-2">
        {[
          {
            t: 'Gesundes Raumklima',
            d: 'Holz ist ein natürlicher, hypoallergener Baustoff: elektrostatisch neutral, es zieht keinen Staub an. Das Ergebnis ist eine spürbar reine Raumluft.',
          },
          {
            t: 'Feuchte, natürlich reguliert',
            d: 'Holzwände nehmen Feuchtigkeit auf, wenn die Luft feucht ist, und geben sie ab, wenn sie trocken ist – ein ausgeglichenes Raumklima ganz ohne zusätzliche Technik.',
          },
          {
            t: 'Leicht und formstabil',
            d: 'Mit rund 500 kg/m³ ist Holz deutlich leichter als Beton und zugleich elastisch: Die Konstruktion bleibt auch bei Erschütterungen stabil.',
          },
          {
            t: 'Nachwachsend und CO₂-arm',
            d: 'Jeder Kubikmeter verbautes Holz bindet rund eine Tonne CO₂ – ein Baustoff, der nachwächst, statt Ressourcen zu verbrauchen.',
          },
        ].map((b) => (
          <div class="reveal border-t border-line pt-6">
            <dt class="font-display text-title font-medium">{b.t}</dt>
            <dd class="prose-measure mt-3 text-body text-muted">{b.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Zweites Standbein: Hoch- und Tiefbau -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-center">
        <Figure
          src="/referenzen/hannover-citygate.webp"
          alt="Büro- und Verwaltungskomplex City Gate Nord in Hannover, sechs Geschosse in Stahlbetonbauweise"
          ratio="aspect-[4/3]"
          sizes="(min-width: 1024px) 50vw, 100vw"
          reveal
          zoom
          class="lg:col-span-6"
        />
        <div class="reveal lg:col-span-5 lg:col-start-8">
          <h2 class="font-display text-display font-medium">
            Und wir bauen nicht nur Einfamilienhäuser.
          </h2>
          <div class="prose-measure mt-6 space-y-5 text-body text-muted">
            <p>
              Mehrfamilienhäuser, Büro- und Verwaltungsgebäude, Kindertagesstätten und
              Kliniken gehören ebenso zu unserer Arbeit — schlüsselfertig für eigene
              Auftraggeber oder als abgegrenztes Leistungspaket für Generalunternehmer.
            </p>
            <p>
              Zuletzt entstanden so ein Verwaltungsbau mit rund 10.500 m²
              Bruttogrundfläche in Hannover, ein Wohn- und Geschäftshaus mit 70
              Wohneinheiten in Stuttgart und der Innenausbau am Städtischen Klinikum
              Braunschweig.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href="/wohn-und-gewerbebau/gewerbebau/" variant="secondary">Zum Gewerbebau</Button>
            <Button href="/wohn-und-gewerbebau/mehrfamilienhaeuser/" variant="secondary">Mehrfamilienhäuser</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Haustypen-Teaser -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="Vier Hausarten. Unendlich viele Grundrisse."
        lead="Vom Tiny Haus bis zum Einfamilienhaus mit zwei Vollgeschossen: Jede Bauform ist ein erprobtes Grundgerüst – Räume, Fassade und Details zeichnen wir mit Ihnen neu."
      />

      <div class="mt-16 grid gap-8 lg:grid-cols-12">
        <!-- Featured: Satteldachhaus -->
        <a href="/haeuser/einfamilienhaus/" class="group block lg:col-span-7">
          <Figure
            src={IMG.satteldach.src}
            alt={IMG.satteldach.alt}
            ratio="aspect-[4/3]"
            sizes="(min-width: 1024px) 58vw, 100vw"
            zoom
          />
          <div class="mt-5 flex items-baseline justify-between gap-4">
            <h3 class="font-display text-title font-medium">
              <span class="link-line">Einfamilienhaus</span>
            </h3>
            <p class="tnum text-small text-muted">ab 120 m² · Satteldach oder Flachdach</p>
          </div>
        </a>

        <!-- Drei kompakte Typen -->
        <div class="grid content-start gap-10 sm:grid-cols-3 lg:col-span-5 lg:grid-cols-1 lg:gap-8 lg:pl-8">
          {hausTeaser.map((typ) => (
            <a href={typ.href} class="group grid grid-cols-[7rem_1fr] items-center gap-5">
              <Figure
                src={typ.img.src}
                alt={typ.img.alt}
                ratio="aspect-square"
                sizes="7rem"
                zoom
                reveal={false}
              />
              <div>
                <h3 class="font-display text-title font-medium">
                  <span class="link-line">{typ.name}</span>
                </h3>
                <p class="tnum mt-1 text-small text-muted">{typ.fakt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="mt-14">
        <Button href="/weg-zum-traumhaus/" variant="secondary">So entsteht Ihr Haus</Button>
      </div>
    </div>
  </section>

  <!-- Aufbau & Materialien: Wandschnitt-Slider -->
  <MaterialSlider />

  <!-- Eigenes Werk: der Beleg dafuer, dass Fertigung und Bau in einer Hand liegen -->
  <section class="py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="Wir fertigen selbst."
        lead="Wand-, Decken- und Dachelemente entstehen in unserer eigenen Halle – geprüft, bevor sie das Werk verlassen. Auf der Baustelle wird montiert, nicht gebaut."
      />
    </div>
    <div class="mt-16">
      <Figure
        src={IMG.werkHalle.src}
        alt={IMG.werkHalle.alt}
        ratio="aspect-[3/2] sm:aspect-[21/9]"
        sizes="100vw"
        class="w-full"
        parallax={0.05}
      />
    </div>
    <div class="container-site mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {[IMG.holzMaterial, IMG.werkTeam, IMG.kranModul].map((bild, i) => (
        <Figure
          src={bild.src}
          alt={bild.alt}
          ratio="aspect-[4/3]"
          sizes="(min-width: 1024px) 31vw, (min-width: 640px) 47vw, 100vw"
          class={i === 2 ? 'sm:col-span-2 lg:col-span-1' : ''}
          zoom
        />
      ))}
    </div>
    <div class="container-site mt-10">
      <a href="/ueber-uns/" class="link-line text-small font-medium">Das Werk und der Betrieb</a>
    </div>
  </section>


  
  <!-- Zahlen / Trust: Anthrazit-Drench, Register statt Stat-Karten -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site">
      <h2 class="reveal font-display text-display font-medium">
        Verlässlichkeit können Sie nachrechnen.
      </h2>
      <dl class="mt-14 divide-y divide-paper/10 border-y border-paper/10">
        {zahlen.map((z) => (
          <div class="reveal grid gap-2 py-7 sm:grid-cols-[minmax(10rem,14rem)_1fr] sm:gap-8">
            <dt class="tnum font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-tight font-medium">{z.wert}</dt>
            <dd class="prose-measure self-center text-body leading-relaxed text-paper-muted">{z.label}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-10 max-w-2xl text-small text-paper-muted">
        Wir arbeiten nach Bauvertrag gemäß BGB: 30 Jahre Garantie auf die Baukonstruktion,
        fünf Jahre Gewährleistung ab Abnahme auf alle übrigen Leistungen, Abschlagszahlungen
        nur nach erbrachter Leistung, Bürgschaften inklusive.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro
      title="Die Fragen, die jetzt anstehen"
      lead="Ehrliche Antworten mit Zahlen von 2026 – ausführlicher im Ratgeber."
    />
    <div class="mt-14 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <FaqAccordion items={faq} />
      </div>
      <div class="self-end lg:col-span-3 lg:col-start-10">
        <p class="text-small text-muted">Ihre Frage ist nicht dabei?</p>
        <div class="mt-4">
          <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero-Ladechoreografie: Zeilen steigen versetzt auf */
  .hero-line {
    animation: hero-rise 0.8s var(--ease-out-expo) both;
    animation-delay: var(--line-delay, 0ms);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line {
      animation: none;
    }
  }
</style>
