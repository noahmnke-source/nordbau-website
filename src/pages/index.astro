---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VideoHero from '@/components/VideoHero.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { IMG } from '@/data/assets';
import { SITE, YEARS_EXPERIENCE } from '@/config/site';
import { buildFaqJsonLd } from '@/lib/seo';

/* Die vier Schritte des Rohbaus. Die Bilder erklären die Bauweise und
   tragen bewusst keinen Projektnamen – eigene Projekte stehen in der
   Tabelle darunter, mit Ort und Zahlen. */
const ablauf = [
  {
    titel: 'Gründung',
    text: 'Erdarbeiten, Sohle und Bewehrung nach Statik. Was unten schiefgeht, bleibt oben schief.',
    img: IMG.rohbauBewehrung,
  },
  {
    titel: 'Schalung',
    text: 'Schalhaut, Ankerraster und Fugenbild werden vorher festgelegt – Sichtbeton verzeiht nichts.',
    img: IMG.rohbauSchalung,
  },
  {
    titel: 'Aufgehendes Mauerwerk',
    text: 'Großformatige Planelemente oder Stahlbeton, je nach Spannweite, Brandschutz und Termin.',
    img: IMG.rohbauMauerwerk,
  },
  {
    titel: 'Decken und Hülle',
    text: 'Geschossdecken, Treppenhäuser und auf Wunsch die geschlossene, regendichte Gebäudehülle.',
    img: IMG.rohbauDecke,
  },
];

/* Die drei Leistungstiefen – gleicher Wortlaut wie auf den Leistungsseiten. */
const stufen = [
  {
    titel: 'Rohbau',
    text: 'Gründung, tragende Wände, Stützen, Decken und Treppenhäuser – eingemessen und mit statischem Nachweis übergeben.',
  },
  {
    titel: 'Rohbau mit Gebäudehülle',
    text: 'Zusätzlich Dach, Fassade, Fenster und Türen. Das Gebäude ist geschlossen und regendicht.',
  },
  {
    titel: 'Schlüsselfertig',
    text: 'Zusätzlich sämtliche Ausbaugewerke bis zur Übergabe. Ein Vertrag, ein Ansprechpartner, ein Termin.',
  },
];

/* Auszug aus dem Referenzbuch – nur eigene, belegbare Projekte. */
const projekte = [
  {
    name: 'Büro- und Verwaltungskomplex City Gate Nord',
    ort: 'Hannover-Vahrenwald',
    zeitraum: 'Juli 2023 – August 2025',
    leistung: 'Tiefbau, Rohbau und Innenausbau',
    kennzahl: '10.500 m² BGF · 6 Geschosse',
  },
  {
    name: 'Wohn- und Geschäftshaus Maybachstraße 20',
    ort: 'Stuttgart',
    zeitraum: 'Juni 2019 – Oktober 2023',
    leistung: 'Rohbau und Innenausbau',
    kennzahl: '15.000 m² BGF · 70 Wohneinheiten',
  },
  {
    name: 'Lagerhalle und Verwaltungsgebäude PVU-Group',
    ort: 'Isernhagen',
    zeitraum: 'Sommer 2019 – Frühjahr 2020',
    leistung: 'Tiefbau, Rohbau und Innenausbau',
    kennzahl: 'rund 6.000 m² BGF',
  },
  {
    name: 'Städtisches Klinikum, Innenausbau EG bis 5. OG',
    ort: 'Braunschweig',
    zeitraum: 'März 2021 – Dezember 2023',
    leistung: 'Innenausbau unter medizinischen Auflagen',
    kennzahl: '6 Geschosse · Parallelbetrieb',
  },
  {
    name: 'Kindertagesstätte Seegrasweg',
    ort: 'Ronnenberg-Empelde',
    zeitraum: 'Mai 2022 – September 2023',
    leistung: 'Rohbau und Innenausbau',
    kennzahl: '1.300 m² BGF · Holzrahmenbau',
  },
];

/* Gebäudearten, die auf derselben Leistung aufbauen. */
const gebaeude = [
  {
    name: 'Mehrfamilienhäuser',
    href: '/gebaeude/mehrfamilienhaeuser/',
    text: 'Schall- und Brandschutz zwischen den Einheiten bestimmen die Konstruktion – geplant, nicht nachgerüstet.',
    img: IMG.rohbauWohnanlage,
  },
  {
    name: 'Gewerbebau',
    href: '/gebaeude/gewerbebau/',
    text: 'Büro- und Verwaltungsgebäude, Hallen und Showrooms. Spannweiten und Nutzlasten bestimmen das Tragwerk.',
    img: IMG.heroGewerbe,
  },
  {
    name: 'Sozial & Bildung',
    href: '/gebaeude/sozial-und-bildung/',
    text: 'Kitas, Schulen und medizinische Einrichtungen – Hygiene, Fluchtwege und Akustik als Planungsgrundlage.',
    img: IMG.kitaEingang,
  },
];


/* Der Hero wechselt zwischen drei Motiven. Zwei zeigen den Rohbau, eines das
   Fertighaus – in dieser Gewichtung liegt auch das Geschaeft. */
const heroBilder = [IMG.rohbauSkelett, IMG.rohbauZeile, IMG.rohbauKranwald];

/* Die drei Leistungen, in der Reihenfolge, in der sie aufeinander aufbauen. */
const leistungen = [
  {
    name: 'Rohbau',
    href: '/leistungen/rohbau/',
    fakt: 'Stahlbeton · Mauerwerk · Holz',
    text: 'Gründung, Tragwerk, Decken und Treppenhäuser – eingemessen, protokolliert und mit statischem Nachweis übergeben.',
    img: IMG.rohbauWohnanlage,
  },
  {
    name: 'Schlüsselfertigbau',
    href: '/leistungen/schluesselfertigbau/',
    fakt: 'Alle Gewerke aus einer Hand',
    text: 'Den tragenden Teil bauen wir selbst, die übrigen Gewerke steuern wir dazu. Ein Vertrag, ein Termin, ein Ansprechpartner.',
    img: IMG.rohbauInnen,
  },
  {
    name: 'Bauen im Bestand',
    href: '/leistungen/bauen-im-bestand/',
    fakt: 'Auch bei laufendem Betrieb',
    text: 'Umbau, Erweiterung und Innenausbau – mit statischem Nachweis für jeden Eingriff ins Tragwerk.',
    img: IMG.bestandGeruest,
  },
];

const zahlen = [
  { wert: `seit ${SITE.foundingYear}`, label: `${YEARS_EXPERIENCE} Jahre am Bau – Rohbau, Schlüsselfertigbau und Häuser aus eigener Fertigung` },
  { wert: '7 + 3', label: 'Obergeschosse und Untergeschosse: die größte bisher ausgeführte Geschossigkeit, Untergeschosse wasserundurchlässig' },
  { wert: '15.000 m²', label: 'Bruttogrundfläche des größten ausgeführten Bauvorhabens – Rohbau und Innenausbau' },
  { wert: '5 Jahre', label: 'Garantie auf die Baukonstruktion und Gewährleistung nach BGB auf alle übrigen Leistungen' },
];

const faq = [
  {
    /* Bewusst als erste Frage und bewusst definitorisch formuliert: Der Absatz
       beantwortet „Was macht die EcoBau GmbH?" vollstaendig und ohne Kontext
       davor. Genau solche in sich geschlossenen Absaetze zitieren
       KI-Antwortsysteme und Googles Uebersicht mit KI. */
    q: 'Was macht die EcoBau GmbH?',
    a: 'Die EcoBau GmbH ist ein familiengeführtes Bauunternehmen aus Hannover, seit 1994 am Bau. Unsere Leitleistung ist der Rohbau: Gründung, Tragwerk, Decken und Treppenhäuser in Stahlbeton, Mauerwerk und Holz – ausgeführt bis sieben Obergeschosse und drei Untergeschosse. Auf Wunsch bauen wir weiter bis zur geschlossenen Gebäudehülle oder schlüsselfertig bis zur Übergabe, und wir bauen im Bestand um, erweitern und bauen aus. Als zweites Standbein fertigen wir Häuser im eigenen Werk: Einfamilienhäuser mit Satteldach oder Flachdach, Bungalows, Modulhäuser und Tiny Houses. Die Wand-, Decken- und Dachelemente entstehen witterungsunabhängig in unserem eigenen Werk und werden auf dem Grundstück montiert. Jedes Haus erfüllt ab Werk den Effizienzhaus-40-Standard und ist damit KfW-förderfähig; dazu kommen eine Festpreisgarantie über zwölf Monate ab Vertragsabschluss und 5 Jahre Garantie auf die Baukonstruktion. Neben Wohnhäusern errichten wir größere Gebäude: Mehrfamilienhäuser, Büro- und Verwaltungsgebäude, Hotels sowie Kindertagesstätten, Schulen und Kliniken – vom Rohbau bis zur schlüsselfertigen Übergabe.',
  },
  {
    q: 'Können wir bei Ihnen nur den Rohbau beauftragen?',
    a: 'Ja. Der Rohbau ist bei uns eine eigenständige Leistung, kein Anhängsel. Sie erhalten Gründung, Tragwerk, Decken und Treppenhäuser als abgeschlossenes Paket mit Aufmaß und statischem Nachweis. Wo unsere Leistung endet und Ihre Gewerke beginnen, steht vor Vertragsschluss in der Leistungsbeschreibung. Ebenso möglich: der Rohbau mit geschlossener, regendichter Gebäudehülle oder das Gebäude schlüsselfertig bis zur Übergabe.',
  },
  {
    q: 'Bauen Sie Rohbau nur in Holz?',
    a: 'Nein. Holztafelbau und Brettsperrholz sind unsere Stärke im Wohnungsbau, der größere Teil unserer Rohbauleistungen entsteht aber in Stahlbeton und Mauerwerk. Beim Wohn- und Geschäftshaus in der Stuttgarter Maybachstraße waren es drei Tiefgeschosse in wasserundurchlässiger Bauweise unter sieben Obergeschossen in Stahlbeton, bei der Lagerhalle in Isernhagen Spannbetonbinder für stützenfreie Hallenbereiche. Welche Bauweise trägt, entscheiden Spannweiten, Brandschutz und Untergeschosse – nicht die Gewohnheit.',
  },
  {
    q: 'Was bedeutet „schlüsselfertig“ genau?',
    a: '„Schlüsselfertig“ ist kein gesetzlich definierter Begriff – den Leistungsumfang legt die Bau- und Leistungsbeschreibung fest. Bei uns heißt es: bezugsfertig inklusive Bädern, Böden und Innentüren. Vergleichen Sie Angebote grundsätzlich nur bei identischem Leistungsumfang.',
  },
  {
    q: 'Kann ich ein Fertighaus komplett individuell planen?',
    a: 'Ja – das ist bei uns der Normalfall. Die Entwürfe auf dieser Website sind Anschauung, kein Bestellkatalog: Jedes Haus wird von einem Architekten für sein Grundstück neu gezeichnet, mit eigenem Grundriss, eigener Fassade und eigener Dachform. Die Vorfertigung im Werk schränkt die Gestaltung kaum ein. Sie können auch mit einem eigenen Architekten kommen – dann übernehmen wir ab der Werkplanung.',
  },
  {
    q: 'Welche KfW-Förderung gibt es 2026 für den Hausbau?',
    a: 'Über „Klimafreundlicher Neubau“ (KfW 297/298) gibt es zinsverbilligte Kredite bis 150.000 Euro pro Wohneinheit ab Effizienzhaus-40-Standard. Familien mit Kind und maximal 90.000 Euro zu versteuerndem Einkommen können alternativ KfW 300 mit bis zu 270.000 Euro nutzen.',
  },
];
---

<BaseLayout
  title={`Rohbau aus Hannover – Stahlbeton, Mauerwerk und Holz | ${SITE.name}`}
  fullTitle
  description="Rohbauunternehmen aus Hannover: Gründung, Tragwerk und Decken in Stahlbeton, Mauerwerk und Holz – wahlweise mit geschlossener Gebäudehülle oder schlüsselfertig. Mehrfamilienhäuser, Gewerbebau und Bildungsbauten bis 15.000 m² BGF. Familienbetrieb seit 1994."
  heroOverlay
  jsonLd={[buildFaqJsonLd(faq)]}
>
  <!-- Hero -->
  <VideoHero bilder={heroBilder}>
    <div class="max-w-3xl">
      <!-- Zwei Zeilen als eigene Bloecke: so bricht jeder Satz fuer sich um
           und beide laufen leicht versetzt ein. -->
      <h1 class="font-display text-hero font-medium">
        <span class="hero-line block">Rohbau aus {SITE.contact.city}.</span>
        <span class="hero-line block" style="--line-delay: 120ms">Vom Fundament bis zur dichten Hülle.</span>
      </h1>
      <p class="hero-line prose-measure mt-6 text-body text-paper/85" style="--line-delay: 280ms">
        {SITE.legalName} — Rohbau in Stahlbeton, Mauerwerk und Holz, auf Wunsch
        schlüsselfertig bis zur Übergabe. Dazu Fertighäuser aus eigener Fertigung.
        Familienbetrieb seit {SITE.foundingYear}.
      </p>
      <div class="hero-line mt-10 flex flex-wrap items-center gap-6" style="--line-delay: 420ms">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/leistungen/rohbau/" class="link-line text-small font-medium text-paper">
          Rohbauleistungen ansehen
        </a>
      </div>
    </div>
  </VideoHero>

  <!-- Zwei Einstiege: Die Seite bedient zwei Zielgruppen mit sehr
       unterschiedlichen Fragen. Wer als Bauunternehmen kommt, soll sich im
       ersten Bildschirm einsortieren koennen und nicht sechs Abschnitte
       ueber Grundrisse durchscrollen muessen. -->
  <section class="container-site py-(--spacing-section-sm)">
    <div class="grid divide-y divide-line border-y border-line lg:grid-cols-2 lg:divide-x lg:divide-y-0">
      <a href="/leistungen/rohbau/" class="group/weg block py-8 lg:pr-10">
        <p class="text-caption tracking-wide text-muted uppercase">Für Bauträger, Architekten und Gewerbe</p>
        <p class="mt-3 font-display text-title font-medium">
          Rohbau, Gebäudehülle oder schlüsselfertig
        </p>
        <p class="prose-measure mt-3 text-small text-muted">
          Stahlbeton, Mauerwerk und Holz – ausgeführt bis sieben Obergeschosse und drei
          Untergeschosse. Sie entscheiden, wo unsere Leistung endet.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-small font-medium text-oxide">
          Zum Rohbau
          <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover/weg:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
        </span>
      </a>

      <a href="/haeuser/einfamilienhaus/" class="group/weg block py-8 lg:pl-10">
        <p class="text-caption tracking-wide text-muted uppercase">Für private Bauherren</p>
        <p class="mt-3 font-display text-title font-medium">
          Ihr Haus aus eigener Fertigung
        </p>
        <p class="prose-measure mt-3 text-small text-muted">
          Einfamilienhaus, Bungalow, Modulhaus oder Tiny House – gezeichnet für Ihr
          Grundstück, gefertigt im eigenen Werk. Effizienzhaus 40, Festpreis über zwölf Monate.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-small font-medium text-oxide">
          Zu den Häusern
          <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover/weg:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
        </span>
      </a>
    </div>
  </section>

  <!-- Leistungen: Rohbau zuerst, die uebrigen bauen darauf auf -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="Was wir bauen – und wie weit"
        lead="Der Rohbau ist unsere Leitleistung. Ob wir danach weiterbauen, entscheiden Sie."
      />
      <div class="mt-14 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {leistungen.map((l, i) => (
          <a href={l.href} class="group reveal block" style={`--reveal-delay:${i * 90}ms`}>
            <Figure
              src={l.img.src}
              alt={l.img.alt}
              ratio="aspect-[4/3]"
              sizes="(min-width: 768px) 31vw, 100vw"
              zoom
            />
            <p class="mt-5 text-caption tracking-wide text-muted uppercase">{l.fakt}</p>
            <h3 class="mt-2 font-display text-title font-medium">{l.name}</h3>
            <p class="prose-measure mt-3 text-small leading-relaxed text-muted">{l.text}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-small font-medium text-oxide">
              Mehr dazu
              <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- So entsteht der Rohbau: die Schritte, die ueber die Qualitaet des
       ganzen Gebaeudes entscheiden. Erklaerende Lizenzbilder, bewusst ohne
       Projektbezug - eigene Projekte stehen weiter unten mit Namen. -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro
      title="So entsteht der Rohbau"
      lead="Was hier an Genauigkeit fehlt, holt kein Ausbaugewerk mehr auf – und was hier gut gemacht ist, sieht später niemand."
    />
    <div class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {ablauf.map((a, i) => (
        <div class="reveal" style={`--reveal-delay:${(i % 4) * 80}ms`}>
          <Figure
            src={a.img.src}
            alt={a.img.alt}
            ratio="aspect-[4/3]"
            sizes="(min-width: 1024px) 23vw, (min-width: 640px) 46vw, 100vw"
          />
          <p class="tnum mt-5 font-display text-title font-medium text-oxide">
            {String(i + 1).padStart(2, '0')}
          </p>
          <h3 class="mt-1 font-display text-body font-medium">{a.titel}</h3>
          <p class="mt-2 text-small leading-relaxed text-muted">{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Leistungstiefe: Der Bauherr entscheidet, wo wir aufhoeren -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site">
      <div class="grid gap-x-8 gap-y-6 lg:grid-cols-12">
        <h2 class="reveal font-display text-display font-medium lg:col-span-6">
          Wie weit wir bauen, entscheiden Sie
        </h2>
        <p class="reveal prose-measure self-end text-body leading-relaxed text-paper-muted lg:col-span-5 lg:col-start-8">
          Die Grenze steht vor Vertragsschluss in der Leistungsbeschreibung – damit die
          Schnittstelle zu Ihren übrigen Gewerken eindeutig ist und nicht zur Diskussion
          steht, wenn es eng wird.
        </p>
      </div>
      <ol class="mt-14 grid gap-x-8 gap-y-10 lg:grid-cols-3">
        {stufen.map((st, i) => (
          <li class="reveal border-t border-paper/20 pt-6" style={`--reveal-delay:${i * 110}ms`}>
            <p class="tnum font-display text-title font-medium text-oxide">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 font-display text-title font-medium">{st.titel}</h3>
            <p class="prose-measure mt-3 text-small leading-relaxed text-paper-muted">{st.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12">
        <Button href="/leistungen/rohbau/" variant="secondary">Zum Rohbau</Button>
      </div>
    </div>
  </section>

  <!-- Ausgefuehrte Projekte: echte Referenzen mit Zahlen, als Beleg -->
  <section class="container-site py-(--spacing-section)">
    <SectionIntro
      title="Ausgeführte Projekte"
      lead="Auszug aus den Bauvorhaben der letzten Jahre – mit Leistungsumfang und Größenordnung."
    />
    <div class="mt-14 overflow-x-auto">
      <table class="w-full min-w-[46rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-line text-caption text-muted">
            <th scope="col" class="py-3 pr-6 font-medium">Projekt</th>
            <th scope="col" class="py-3 pr-6 font-medium">Leistung</th>
            <th scope="col" class="py-3 font-medium">Umfang</th>
          </tr>
        </thead>
        <tbody>
          {projekte.map((pr) => (
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-5 pr-6 font-normal">
                <span class="block font-display text-body font-medium">{pr.name}</span>
                <span class="mt-1 block text-caption text-muted">{pr.ort} · {pr.zeitraum}</span>
              </th>
              <td class="py-5 pr-6 text-small text-muted">{pr.leistung}</td>
              <td class="tnum py-5 text-small text-muted">{pr.kennzahl}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Gebaeudearten: was auf dem Rohbau aufbaut -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="Gebäude, die wir bauen"
        lead="Dieselbe Leistung, andere Anforderungen: Schallschutz im Wohnungsbau, Spannweiten im Gewerbe, Auflagen im Bildungsbau."
      />
      <div class="mt-14 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {gebaeude.map((g, i) => (
          <a href={g.href} class="group reveal block" style={`--reveal-delay:${i * 90}ms`}>
            <Figure
              src={g.img.src}
              alt={g.img.alt}
              ratio="aspect-[4/3]"
              sizes="(min-width: 768px) 31vw, 100vw"
              zoom
            />
            <h3 class="mt-5 font-display text-title font-medium">{g.name}</h3>
            <p class="prose-measure mt-3 text-small leading-relaxed text-muted">{g.text}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-small font-medium text-oxide">
              Mehr dazu
              <svg class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Zweites Standbein, bewusst knapp gehalten: ein Absatz, ein Bild,
       ein Knopf auf die Haeuser-Seite. -->
  <section class="container-site py-(--spacing-section)">
    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-center">
      <div class="reveal lg:col-span-5">
        <p class="text-caption tracking-wide text-muted uppercase">Zweites Standbein</p>
        <h2 class="mt-3 font-display text-display font-medium">
          Und wir fertigen Häuser im eigenen Werk.
        </h2>
        <p class="prose-measure mt-6 text-body leading-relaxed text-muted">
          Neben dem Rohbau bauen wir schlüsselfertige Häuser in Holztafelbauweise –
          Einfamilienhäuser, Bungalows, Modulhäuser und Tiny Houses, gezeichnet für Ihr
          Grundstück und vorgefertigt in der eigenen Halle.
        </p>
        <div class="mt-8">
          <Button href="/haeuser/einfamilienhaus/" variant="primary">Zu den Häusern</Button>
        </div>
      </div>
      <Figure
        src={IMG.heroHome.src}
        alt={IMG.heroHome.alt}
        ratio="aspect-[3/2]"
        sizes="(min-width: 1024px) 54vw, 100vw"
        class="lg:col-span-6 lg:col-start-7"
        zoom
      />
    </div>
  </section>

  <!-- Zahlen / Trust: Anthrazit-Drench, Register statt Stat-Karten -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
