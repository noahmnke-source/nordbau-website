---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import SectionIntro from '@/components/SectionIntro.astro';

const typen = (await getCollection('haustypen')).sort((a, b) => a.data.order - b.data.order);

// Filtergruppen in fester Reihenfolge, nur die tatsächlich belegten anzeigen.
const gruppen = ['Eine Ebene', 'Mit Dach', 'Modern & Modular', 'Mehrfamilien'] as const;
const filter = [
  { label: 'Alle', value: 'alle', count: typen.length },
  ...gruppen
    .map((g) => ({
      label: g,
      value: g,
      count: typen.filter((t) => t.data.kategorie === g).length,
    }))
    .filter((f) => f.count > 0),
];
---

<BaseLayout
  title="Haustypen: Fertighäuser individuell geplant"
  description="Sechs Haustypen als Fertighaus: Bungalow, Flachdachhaus, Satteldachhaus, Modulhaus, Tiny House, Mehrfamilienhaus. Effizienzhaus 40, ab 89.000 €. Jetzt beraten lassen."
  breadcrumbs={[{ name: 'Haustypen', href: '/haustypen/' }]}
>
  <!-- Seitenkopf -->
  <section class="container-site pt-12 lg:pt-16">
    <Breadcrumbs items={[{ name: 'Haustypen', href: '/haustypen/' }]} class="mb-10" />

    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h1 class="font-display text-hero font-medium">
          Haustypen: sechs Wege, Ihr Fertighaus individuell zu planen
        </h1>
        <p class="prose-measure mt-6 text-body text-muted">
          Ein Haustyp ist bei uns kein Katalogmodell, sondern ein erprobtes Grundgerüst:
          Statik, Proportion und Energiekonzept stehen – Grundriss, Fassade und Details
          entwerfen unsere Architekten für Ihr Grundstück neu. So entsteht das
          Architektenhaus als Fertighaus: individuell geplant, werkseitig vorgefertigt,
          ab Werk im Effizienzhaus-40-Standard.
        </p>
      </div>
      <p class="prose-measure self-end text-small text-muted lg:col-span-4 lg:col-start-9">
        Vom Tiny House bis zum Mehrfamilienhaus – alle Typen bauen wir schlüsselfertig,
        2026 ab 89.000 €, mit 12 Monaten Festpreisgarantie und fünf Jahren
        Gewährleistung nach BGB.
      </p>
    </div>
  </section>

  <!-- Katalog: Filterleiste + Grid -->
  <section class="container-site pt-14 pb-(--spacing-section) lg:pt-20">
    <!-- Filterleiste (Enhancement; ohne JS bleiben alle Typen sichtbar) -->
    <div
      id="typ-filter"
      role="group"
      aria-label="Haustypen filtern"
      class="flex flex-wrap items-baseline gap-x-7 gap-y-3 border-b border-line pb-6"
    >
      {filter.map((f, i) => (
        <button
          type="button"
          class="filter-chip"
          data-filter={f.value}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {f.label}
          <span class="tnum ml-1 text-caption text-muted">{f.count}</span>
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div id="typ-grid" class="mt-14 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {typen.map((typ, i) => (
        <a
          href={`/haustypen/${typ.id}/`}
          class="catalog-item group flex flex-col"
          data-kategorie={typ.data.kategorie}
        >
          <div class="card-lift">
            <Figure
              src={typ.data.hero.src}
              alt={typ.data.hero.alt}
              ratio="aspect-[4/3]"
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
              eager={i < 3}
              zoom
              reveal={false}
            />
          </div>
          <p class="mt-5 text-caption text-muted">{typ.data.kategorie}</p>
          <h2 class="mt-1 font-display text-title font-medium">
            <span class="link-line">{typ.data.name}</span>
          </h2>
          <p class="mt-2 text-small text-muted">{typ.data.tagline}</p>
          <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-1 border-t border-line pt-4 text-small">
            <div>
              <dt class="text-caption text-muted">Wohnfläche</dt>
              <dd class="tnum font-medium">{typ.data.facts.wohnflaeche}</dd>
            </div>
            <div>
              <dt class="text-caption text-muted">Preis ab</dt>
              <dd class="tnum font-medium">{typ.data.facts.preisAb}</dd>
            </div>
          </dl>
        </a>
      ))}
    </div>

    <p id="typ-empty" hidden class="mt-10 text-body text-muted">
      In dieser Gruppe ist aktuell kein Haustyp hinterlegt.
    </p>
  </section>

  <!-- Abschluss-CTA -->
  <section class="bg-stone py-(--spacing-section)">
    <div class="container-site">
      <SectionIntro
        title="Welcher Typ passt auf Ihr Grundstück?"
        lead="Der Bebauungsplan entscheidet mit – im Erstgespräch prüfen wir Festsetzungen, Budget und Zeitplan. Unverbindlich, mit ehrlichen Zahlen."
      />
      <div class="reveal mt-12 flex flex-wrap items-center gap-6">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/referenzen/" class="link-line text-small font-medium">
          Gebaute Häuser ansehen
        </a>
      </div>
    </div>
  </section>

  <script>
    // Filterbarer Katalog – adaptiert von der Isotope-Filterung auf
    // treehouse-ks.eu, hier als leichtgewichtiges Fade/Reflow ohne Bibliothek.
    const bar = document.getElementById('typ-filter');
    const items = Array.from(
      document.querySelectorAll<HTMLElement>('#typ-grid .catalog-item')
    );
    const empty = document.getElementById('typ-empty');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    bar?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-chip');
      if (!btn) return;
      const value = btn.dataset.filter!;

      bar.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((b) =>
        b.setAttribute('aria-pressed', String(b === btn))
      );

      let visible = 0;
      items.forEach((item) => {
        const match = value === 'alle' || item.dataset.kategorie === value;
        if (match) visible++;

        if (reduce) {
          item.hidden = !match;
          return;
        }
        if (match) {
          item.hidden = false;
          item.classList.add('is-filtering');
          requestAnimationFrame(() =>
            requestAnimationFrame(() => item.classList.remove('is-filtering'))
          );
        } else {
          item.classList.add('is-filtering');
          window.setTimeout(() => {
            if (item.classList.contains('is-filtering')) item.hidden = true;
          }, 400);
        }
      });

      if (empty) empty.hidden = visible > 0;
    });
  </script>
</BaseLayout>
