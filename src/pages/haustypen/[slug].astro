---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Figure from '@/components/Figure.astro';
import Prose from '@/components/Prose.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { buildFaqJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('haustypen');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'haustypen'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, tagline, hero, gallery, facts, faq } = entry.data;

// „Weitere Haustypen": die beiden Nachbarn der redaktionellen Reihenfolge (order), zyklisch
const alle = (await getCollection('haustypen')).sort((a, b) => a.data.order - b.data.order);
const index = alle.findIndex((e) => e.id === entry.id);
const weitere =
  alle.length > 2
    ? [alle[(index + alle.length - 1) % alle.length]!, alle[(index + 1) % alle.length]!]
    : alle.filter((e) => e.id !== entry.id);

const breadcrumbs = [
  { name: 'Haustypen', href: '/haustypen/' },
  { name, href: `/haustypen/${entry.id}/` },
];

// Preis wird auf der Website bewusst nicht ausgewiesen (auf Anfrage).
const factRows = [
  { label: 'Wohnfläche', value: facts.wohnflaeche },
  { label: 'Geschosse', value: facts.geschosse },
  { label: 'Dachform', value: facts.dachform },
  { label: 'Bauweise', value: facts.bauweise },
  { label: 'Energiestandard', value: facts.energiestandard },
].filter((r): r is { label: string; value: string } => Boolean(r.value));

/** Galerie: wechselnde Spannen und Formate statt uniformem Raster */
const galleryLayout = [
  { wrap: 'lg:col-span-7', ratio: 'aspect-[4/3]', sizes: '(min-width: 1024px) 54vw, 100vw' },
  { wrap: 'lg:col-span-5 lg:mt-24', ratio: 'aspect-[4/5]', sizes: '(min-width: 1024px) 38vw, 100vw' },
  { wrap: 'lg:col-span-8 lg:col-start-4', ratio: 'aspect-[3/2]', sizes: '(min-width: 1024px) 62vw, 100vw' },
];
---

<BaseLayout
  title={entry.data.seoTitle}
  fullTitle
  description={entry.data.seoDescription}
  ogImage={hero.src}
  breadcrumbs={breadcrumbs}
  jsonLd={faq.length > 0 ? [buildFaqJsonLd(faq)] : []}
>
  <!-- Seitenkopf -->
  <section class="container-site pt-12 lg:pt-16">
    <Breadcrumbs items={breadcrumbs} class="mb-10" />
    <div class="grid gap-x-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h1 class="font-display text-hero font-medium">{name}</h1>
        <p class="mt-5 font-display text-title font-medium text-muted">{tagline}</p>
      </div>
    </div>
  </section>

  <!-- Hero-Bild, volle Breite -->
  <div class="mt-10 lg:mt-14">
    <Figure
      src={hero.src}
      alt={hero.alt}
      ratio="aspect-[3/2] sm:aspect-[21/9]"
      sizes="100vw"
      eager
      reveal={false}
      parallax={0.05}
      class="w-full"
    />
  </div>

  <!-- Beschreibung + Fakten-Register -->
  <section class="container-site pt-14 pb-(--spacing-section) lg:pt-20">
    <div class="grid gap-x-8 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Prose>
          <Content />
        </Prose>
      </div>

      <aside class="lg:col-span-4 lg:col-start-9">
        <h2 class="text-caption font-medium text-muted">Der Haustyp in Zahlen</h2>
        <dl class="mt-4 divide-y divide-line border-y border-line">
          {factRows.map((row) => (
            <div class="flex items-baseline justify-between gap-6 py-4">
              <dt class="text-caption text-muted">{row.label}</dt>
              <dd class="tnum text-right font-display text-title font-medium">{row.value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-5 text-caption text-muted">
          Basiswerte der Typenplanung, Stand 2026 – Größe, Grundriss und Ausstattung
          planen wir individuell für Ihr Grundstück.
        </p>
      </aside>
    </div>
  </section>

  <!-- Galerie -->
  {gallery.length > 0 && (
    <section class="bg-stone py-(--spacing-section)">
      <div class="container-site grid gap-x-8 gap-y-12 lg:grid-cols-12">
        {gallery.map((bild, i) => {
          const l = galleryLayout[i % galleryLayout.length]!;
          return (
            <Figure
              src={bild.src}
              alt={bild.alt}
              ratio={l.ratio}
              sizes={l.sizes}
              class={l.wrap}
            />
          );
        })}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {faq.length > 0 && (
    <section class="container-site py-(--spacing-section)">
      <SectionIntro
        title="Häufige Fragen zu diesem Haustyp"
        lead="Antworten mit den Zahlen, die 2026 gelten – vertieft im persönlichen Gespräch."
      />
      <div class="mt-14 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <FaqAccordion items={faq} />
        </div>
      </div>
    </section>
  )}

  <!-- Weitere Haustypen -->
  <section class="container-site pb-(--spacing-section)">
    <div class="border-t border-line pt-10">
      <p class="text-caption text-muted">Weitere Haustypen</p>
      <div class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-12">
        {weitere.map((typ, i) => (
          <a
            href={`/haustypen/${typ.id}/`}
            class:list={[
              'group grid grid-cols-[7rem_1fr] items-center gap-6',
              i === 0 ? 'lg:col-span-5' : 'lg:col-span-5 lg:col-start-8',
            ]}
          >
            <Figure
              src={typ.data.hero.src}
              alt={typ.data.hero.alt}
              ratio="aspect-square"
              sizes="7rem"
              zoom
              reveal={false}
            />
            <div>
              <p class="font-display text-title font-medium">
                <span class="link-line">{typ.data.name}</span>
              </p>
              <p class="tnum mt-1 text-small text-muted">
                {typ.data.facts.wohnflaeche} · {typ.data.facts.dachform}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Abschluss-CTA -->
  <section class="bg-graphite py-(--spacing-section) text-paper">
    <div class="container-site grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">
          Vom Haustyp zu Ihrem Haus ist es ein Gespräch.
        </h2>
        <p class="reveal prose-measure mt-6 text-body leading-relaxed text-paper-muted">
          Im Erstgespräch prüfen wir, ob der Typ zu Ihrem Grundstück passt –
          Bebauungsplan, Budget, Zeitplan. Unverbindlich, mit ehrlichen Zahlen
          und ohne Verkaufsdruck.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 lg:col-span-4 lg:col-start-9 lg:justify-end">
        <Button href="/kontakt/" variant="primary">Beratung vereinbaren</Button>
        <a href="/haustypen/" class="link-line text-small font-medium text-paper">
          Alle Haustypen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
