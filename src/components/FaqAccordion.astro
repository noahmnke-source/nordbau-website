---
/**
 * FAQ-Akkordeon auf <details>-Basis: tastaturbedienbar, ohne JS funktionsfähig.
 * Das zugehörige FAQPage-JSON-LD erzeugt die Seite über `buildFaqJsonLd()`.
 */
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class:list={['divide-y divide-line border-y border-line', className]}>
  {items.map((item) => (
    <details class="group py-1">
      <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-5 text-title font-medium [&::-webkit-details-marker]:hidden">
        <span class="text-balance">{item.q}</span>
        <span
          aria-hidden="true"
          class="relative top-[-2px] block h-4 w-4 shrink-0 transition-transform duration-300 ease-[var(--ease-out-quart)] group-open:rotate-45"
        >
          <span class="absolute top-1/2 left-0 h-px w-full bg-oxide"></span>
          <span class="absolute top-0 left-1/2 h-full w-px -translate-x-1/2 bg-oxide transition-opacity duration-300 group-open:opacity-0"></span>
        </span>
      </summary>
      <p class="prose-measure pb-6 text-body text-muted">{item.a}</p>
    </details>
  ))}
</div>
