---
/**
 * Sektionskopf: nur die Ueberschrift, ueber die volle Breite des Inhalts
 * darunter. Bewusst ohne Eyebrow-Label und ohne Vorlauftext — die
 * Ueberschrift traegt selbst, der Abschnitt darunter erklaert sich.
 */
interface Props {
  title: string;
  /** Ueberschrift auf dunklem Grund */
  onDark?: boolean;
  /** h2 (Default) oder h1 fuer Seitenkoepfe */
  as?: 'h1' | 'h2';
  class?: string;
}

const { title, onDark = false, as: Tag = 'h2', class: className = '' } = Astro.props;
---

<Tag
  class:list={[
    'reveal font-display text-display font-medium',
    onDark ? 'text-paper' : 'text-ink',
    className,
  ]}
>
  {title}
</Tag>
