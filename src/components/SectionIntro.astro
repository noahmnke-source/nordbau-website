---
/**
 * Sektionskopf: H2 + optionaler Vorlauf, asymmetrisch im 12er-Raster.
 * Bewusst ohne Eyebrow-Label — die Überschrift trägt selbst.
 */
interface Props {
  title: string;
  /** max. 2 Sätze Vorlauf */
  lead?: string;
  /** Überschrift auf dunklem Grund */
  onDark?: boolean;
  /** h2 (Default) oder h1 für Seitenköpfe */
  as?: 'h1' | 'h2';
  class?: string;
}

const { title, lead, onDark = false, as: Tag = 'h2', class: className = '' } = Astro.props;
---

<div class:list={['grid gap-6 lg:grid-cols-12', className]}>
  <Tag
    class:list={[
      'reveal font-display text-display font-medium lg:col-span-7',
      onDark ? 'text-paper' : 'text-ink',
    ]}
  >
    {title}
  </Tag>
  {lead && (
    <p
      class:list={[
        'reveal prose-measure self-end text-body lg:col-span-4 lg:col-start-9',
        onDark ? 'text-paper-muted' : 'text-muted',
      ]}
    >
      {lead}
    </p>
  )}
</div>
