---
/**
 * Vollbild-Hero mit Bildwechsler und Video-Slot.
 *
 * Werden mehrere Bilder uebergeben, blenden sie langsam ineinander ueber.
 * Nur das erste Bild wird sofort geladen – es ist das LCP-Element. Die
 * uebrigen holt das Skript erst nach `load` nach, damit der Wechsler die
 * Ladezeit der Startseite nicht verlaengert.
 *
 * Das Video liegt unter public/videos/hero.mp4 (liefert der Kunde nach,
 * siehe ASSETS.md: H.264, 1920×1080, ≤ 8 MB, ohne Ton). Solange die Datei
 * fehlt, rendert die Komponente die Bilder.
 */
import fs from 'node:fs';
import { isProjektBild, projektSrcset } from '@/lib/img';

interface Bild {
  src: string;
  alt: string;
}

interface Props {
  /** Ein Bild oder mehrere; ab zwei Bildern wechselt der Hero. */
  bilder: Bild[];
  /** Beschriftung des Wechslers fuer Screenreader */
  wechslerAria?: string;
}

const { bilder, wechslerAria = 'Bildwechsel im Seitenkopf' } = Astro.props;
const hasVideo = fs.existsSync(new URL('../../public/videos/hero.mp4', import.meta.url));

const aufbereitet = bilder.map((b) => ({
  ...b,
  srcset: isProjektBild(b.src) ? projektSrcset(b.src) : undefined,
}));
const erstes = aufbereitet[0]!;
const wechselt = aufbereitet.length > 1;
---

<section class="relative flex min-h-svh flex-col justify-end bg-graphite text-paper">
  <div class="absolute inset-0 isolate overflow-hidden">
    {hasVideo ? (
      <video
        class="h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={erstes.src}
        aria-hidden="true"
        tabindex="-1"
      >
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
    ) : (
      <div class="hero-wechsler absolute inset-0" data-hero-wechsler>
        {aufbereitet.map((b, i) => (
          <img
            src={i === 0 ? b.src : undefined}
            data-src={i === 0 ? undefined : b.src}
            srcset={i === 0 ? b.srcset : undefined}
            data-srcset={i === 0 ? undefined : b.srcset}
            sizes="100vw"
            alt={i === 0 ? b.alt : ''}
            aria-hidden={i === 0 ? undefined : 'true'}
            class:list={['hero-bild absolute inset-0 h-full w-full object-cover', i === 0 && 'is-aktiv']}
            loading="eager"
            decoding={i === 0 ? 'sync' : 'async'}
            fetchpriority={i === 0 ? 'high' : 'low'}
          />
        ))}
      </div>
    )}
    <!-- Scrim: Lesbarkeit der Headline, unten dichter -->
    <div
      class="absolute inset-0 z-[3] bg-gradient-to-t from-graphite/88 via-graphite/45 to-graphite/35"
      aria-hidden="true"
    >
    </div>
  </div>

  <div class="container-site relative z-10 pt-40 pb-16 lg:pb-24">
    <slot />
  </div>

  {wechselt && !hasVideo && (
    <div
      class="container-site relative z-10 pb-10 lg:pb-14"
      role="group"
      aria-label={wechslerAria}
    >
      <div class="flex gap-2.5" data-hero-punkte>
        {aufbereitet.map((_, i) => (
          <button
            type="button"
            class:list={['hero-punkt', i === 0 && 'is-aktiv']}
            aria-label={`${wechslerAria} – ${i + 1}`}
            aria-current={i === 0 ? 'true' : undefined}
          ></button>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  /* ── Bildwechsel ─────────────────────────────────────────────
     Ohne JavaScript bleibt das erste Bild sichtbar; die uebrigen
     liegen darunter und werden nie geladen.

     Echte Ueberblendung statt Aus- und Einblenden: Das neue Bild legt
     sich deckend ueber das alte und wird eingeblendet, das alte bleibt
     darunter voll sichtbar, bis der Wechsel durch ist. Wuerden beide
     gleichzeitig halbtransparent sein, schiene der dunkle Grund durch
     und die Mitte des Uebergangs wuerde sichtbar abdunkeln. */
  .hero-bild {
    opacity: 0;
    z-index: 0;
    transition: opacity 1.8s cubic-bezier(0.45, 0, 0.55, 1);
  }
  .hero-bild.is-aktiv {
    opacity: 1;
    z-index: 2;
  }
  /* Das abgehende Bild bleibt deckend und liegt eine Ebene tiefer. */
  .hero-bild.is-abgehend {
    opacity: 1;
    z-index: 1;
    transition: none;
  }

  /* Sehr langsames Heranfahren gibt dem Standbild Leben. Der Zoom laeuft
     auch im abgehenden Bild weiter – sonst springt es beim Wechsel
     schlagartig auf die Ausgangsgroesse zurueck. */
  .hero-wechsler.laeuft .hero-bild.is-aktiv,
  .hero-wechsler.laeuft .hero-bild.is-abgehend {
    animation: hero-zoom 11s linear both;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.055);
    }
  }

  /* ── Fortschrittsbalken ──────────────────────────────────── */
  .hero-punkt {
    position: relative;
    width: 2.75rem;
    height: 2px;
    background: color-mix(in oklab, var(--color-paper) 32%, transparent);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  .hero-punkt:hover {
    background: color-mix(in oklab, var(--color-paper) 55%, transparent);
  }
  .hero-punkt::after {
    content: '';
    position: absolute;
    inset: 0;
    transform-origin: left;
    transform: scaleX(0);
    background: var(--color-paper);
  }
  .hero-punkt.is-aktiv::after {
    transform: scaleX(1);
  }
  /* Der aktive Balken laeuft ueber die Standzeit mit. */
  .hero-punkt.is-aktiv.laeuft::after {
    animation: hero-fortschritt 7s linear both;
  }

  @keyframes hero-fortschritt {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bild {
      transition: none;
    }
    .hero-wechsler.laeuft .hero-bild.is-aktiv,
    .hero-wechsler.laeuft .hero-bild.is-abgehend,
    .hero-punkt.is-aktiv.laeuft::after {
      animation: none;
    }
    .hero-punkt.is-aktiv::after {
      transform: scaleX(1);
    }
  }
</style>

<script>
  // Autoplay respektiert reduzierte Bewegung
  const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (wenigerBewegung.matches) {
    document.querySelectorAll<HTMLVideoElement>('section video[autoplay]').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  }

  // ── Bildwechsel im Hero ───────────────────────────────────────
  const wechsler = document.querySelector<HTMLElement>('[data-hero-wechsler]');
  const punkte = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-hero-punkte] .hero-punkt')
  );

  if (wechsler) {
    const bilder = Array.from(wechsler.querySelectorAll<HTMLImageElement>('.hero-bild'));
    const STANDZEIT = 7000;

    if (bilder.length > 1 && !wenigerBewegung.matches) {
      const UEBERBLENDUNG = 1800;
      let aktuell = 0;
      let timer = 0;
      let aufraeumer = 0;

      // Die uebrigen Bilder erst nach dem Laden der Seite holen – sonst
      // konkurrieren sie mit dem LCP-Bild um Bandbreite.
      const nachladen = () => {
        for (const bild of bilder.slice(1)) {
          if (bild.dataset.srcset) bild.srcset = bild.dataset.srcset;
          if (bild.dataset.src) bild.src = bild.dataset.src;
        }
        wechsler.classList.add('laeuft');
        punkte[0]?.classList.add('laeuft');
        starten();
      };

      const zeigen = (n: number) => {
        const ziel = (n + bilder.length) % bilder.length;
        if (ziel === aktuell) return;

        const altes = bilder[aktuell];
        const neues = bilder[ziel];
        window.clearTimeout(aufraeumer);

        // Das bisherige Bild bleibt deckend liegen, bis die Ueberblendung
        // durch ist – erst danach wird es ausgeblendet.
        if (altes) {
          altes.classList.remove('is-aktiv');
          altes.classList.add('is-abgehend');
        }

        punkte[aktuell]?.classList.remove('is-aktiv', 'laeuft');
        aktuell = ziel;

        if (neues) {
          // Zoom neu anstossen, damit er bei jedem Bild von vorn laeuft.
          neues.style.animation = 'none';
          void neues.offsetWidth;
          neues.style.animation = '';
          neues.classList.add('is-aktiv');
        }

        const punkt = punkte[aktuell];
        if (punkt) {
          punkt.classList.add('is-aktiv');
          void punkt.offsetWidth;
          punkt.classList.add('laeuft');
        }

        aufraeumer = window.setTimeout(() => {
          for (const b of bilder) {
            if (!b.classList.contains('is-aktiv')) b.classList.remove('is-abgehend');
          }
        }, UEBERBLENDUNG);
      };

      const starten = () => {
        window.clearInterval(timer);
        timer = window.setInterval(() => zeigen(aktuell + 1), STANDZEIT);
      };

      punkte.forEach((p, i) =>
        p.addEventListener('click', () => {
          zeigen(i);
          starten();
        })
      );

      // Im Hintergrundtab nicht weiterlaufen lassen.
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) window.clearInterval(timer);
        else starten();
      });

      if (document.readyState === 'complete') nachladen();
      else window.addEventListener('load', nachladen, { once: true });
    }
  }
</script>
