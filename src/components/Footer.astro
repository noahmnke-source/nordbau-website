---
import { getCollection } from 'astro:content';
import Button from '@/components/Button.astro';
import { SITE } from '@/config/site';
import { getLang, localize, useT } from '@/i18n';

interface Props {
  /** Abschluss-CTA im Footer zeigen (aus, wenn die Seite bereits einen eigenen hat) */
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
const lang = getLang(Astro.url.pathname);
const t = useT(lang);

const haustypen = (
  lang === 'en' ? await getCollection('haustypenEn') : await getCollection('haustypen')
).sort((a, b) => a.data.order - b.data.order);

const year = new Date().getFullYear();

const navDefs: { key: Parameters<typeof t>[0]; path: string }[] = [
  { key: 'nav.haustypen', path: '/haustypen/' },
  ...(lang === 'de' ? [{ key: 'nav.bauleistungen' as const, path: '/bauleistungen/' }] : []),
  { key: 'nav.referenzen', path: '/referenzen/' },
  { key: 'nav.ablauf', path: '/ablauf/' },
  { key: 'nav.ueberuns', path: '/ueber-uns/' },
  ...(lang === 'de' ? [{ key: 'nav.ratgeber' as const, path: '/ratgeber/' }] : []),
  { key: 'nav.kontakt', path: '/kontakt/' },
];
const nav = navDefs.map((n) => ({ label: t(n.key), href: localize(n.path, lang) }));
---

<footer class="bg-graphite text-paper">
  {showCta && (
    <!-- Abschluss-CTA (auf Seiten mit eigenem CTA über showCta={false} ausgeblendet) -->
    <div class="container-site border-b border-paper/10 py-(--spacing-section-sm)">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="font-display text-display leading-[1.13] font-medium">
            {t('footer.ctaHeadline')}
          </p>
        </div>
        <div class="flex flex-col items-start gap-4 lg:col-span-4 lg:items-end">
          <Button href={localize('/kontakt/', lang)} variant="primary">{t('cta')}</Button>
          <a href={`tel:${SITE.contact.phone}`} class="link-line text-small text-paper-muted">
            {t('footer.callDirect')} {SITE.contact.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- Linkspalten -->
  <div class="container-site grid gap-x-8 gap-y-12 py-16 sm:grid-cols-2 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <a href={localize('/', lang)} aria-label={`${SITE.legalName} – ${t('logo.aria')}`} class="inline-block">
        <img src="/logo-on-dark.png" width="403" height="300" alt={SITE.legalName} class="h-16 w-auto" />
      </a>
      <p class="prose-measure mt-6 max-w-xs text-small leading-relaxed text-paper-muted">
        {SITE.claim} {t('footer.claim')}
      </p>
    </div>

    <nav aria-label={t('nav.footer')} class="lg:col-span-2">
      <h2 class="mb-4 text-caption font-medium text-paper-muted">{t('footer.nav')}</h2>
      <ul class="space-y-2.5">
        {nav.map((item) => (
          <li><a href={item.href} class="link-line text-small">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label={t('nav.haustypen')} class="lg:col-span-3">
      <h2 class="mb-4 text-caption font-medium text-paper-muted">{t('nav.haustypen')}</h2>
      <ul class="space-y-2.5">
        {haustypen.map((h) => (
          <li><a href={localize(`/haustypen/${h.id}/`, lang)} class="link-line text-small">{h.data.name}</a></li>
        ))}
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h2 class="mb-4 text-caption font-medium text-paper-muted">{t('footer.contact')}</h2>
      <address class="space-y-2.5 text-small not-italic">
        <p>{SITE.legalName}<br />{SITE.contact.street}<br />{SITE.contact.zip} {SITE.contact.city}</p>
        <p><a href={`tel:${SITE.contact.phone}`} class="link-line">{SITE.contact.phoneDisplay}</a></p>
        <p><a href={`mailto:${SITE.contact.email}`} class="link-line">{SITE.contact.email}</a></p>
      </address>
    </div>
  </div>

  <!-- Rechtliches (Impressum/Datenschutz bleiben rechtlich auf Deutsch) -->
  <div class="border-t border-paper/10">
    <div class="container-site flex flex-wrap items-center justify-between gap-4 py-6 text-caption text-paper-muted">
      <p>© {year} {SITE.legalName}. {t('footer.rights')}</p>
      <ul class="flex flex-wrap gap-6">
        <li><a href="/impressum/" class="link-line">{t('footer.imprint')}</a></li>
        <li><a href="/datenschutz/" class="link-line">{t('footer.privacy')}</a></li>
        <li>
          <button type="button" data-consent-open class="link-line cursor-pointer">
            {t('footer.cookies')}
          </button>
        </li>
      </ul>
    </div>
  </div>
</footer>

<script is:inline>
  // Widerruf/Nachtraegliche Zustimmung: oeffnet das Einwilligungsbanner erneut.
  document.querySelectorAll('[data-consent-open]').forEach((el) =>
    el.addEventListener('click', () => window.ecobauConsent?.open())
  );
</script>
