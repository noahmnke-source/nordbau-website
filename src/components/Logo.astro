---
/**
 * Nordbau-Wortbildmarke als transparentes Inline-SVG + Wortmarke.
 *
 * Nachgebaut aus der übergebenen Logo-Grafik (N-Monogramm mit rotem
 * Satteldach, Schriftzug NORDBAU / GMBH). Als Inline-SVG nativ
 * transparent und gestochen scharf in jeder Größe. Farben adaptiv:
 * die anthrazitfarbenen Teile nutzen currentColor (dunkel auf hell,
 * hell auf dunkel), das Dach den Marken-Akzent (--color-oxide).
 */
interface Props {
  /** header: einzeilig mit Icon; footer: zusätzlich „GMBH“-Zeile */
  variant?: 'header' | 'footer';
  class?: string;
}

const { variant = 'header', class: className = '' } = Astro.props;
const showGmbh = variant === 'footer';
---

<span class:list={['inline-flex items-center gap-2.5 leading-none', className]}>
  <svg
    viewBox="0 0 58 56"
    class:list={['w-auto shrink-0', variant === 'footer' ? 'h-9' : 'h-8']}
    fill="none"
    aria-hidden="true"
  >
    <!-- N-Monogramm -->
    <path d="M4 4 H15 L43 38 V4 H54 V52 H43 L15 18 V52 H4 Z" fill="currentColor" />
    <!-- Rotes Satteldach über der unteren Mitte -->
    <path d="M9 44 L29 18 L49 44 H40 L29 26 L18 44 Z" fill="var(--color-oxide)" />
  </svg>

  <span class="flex flex-col">
    <span class="font-sans text-[1.2rem] font-bold tracking-[-0.01em]">
      NORD<span class="text-oxide">BAU</span>
    </span>
    {showGmbh && (
      <span class="mt-1 flex items-center gap-1.5 text-[0.62rem] font-medium tracking-[0.28em]">
        <span class="h-px w-4 bg-oxide"></span>
        <span class="text-muted">GMBH</span>
        <span class="h-px w-4 bg-oxide"></span>
      </span>
    )}
  </span>
</span>
