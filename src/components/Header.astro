---
import Button from '@/components/Button.astro';
import { SITE } from '@/config/site';
import { getLang, localize, altPath, isBilingual, useT } from '@/i18n';

interface Props {
  /** true: startet transparent über dunklem Hero, wird beim Scrollen fest */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const lang = getLang(path);
const t = useT(lang);

const home = localize('/', lang);

// Navigation je Sprache (EN ohne Ratgeber – der bleibt deutsch).
const navDefs: { key: Parameters<typeof t>[0]; path: string }[] = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.haustypen', path: '/haustypen/' },
  ...(lang === 'de' ? [{ key: 'nav.bauleistungen' as const, path: '/bauleistungen/' }] : []),
  { key: 'nav.referenzen', path: '/referenzen/' },
  { key: 'nav.ablauf', path: '/ablauf/' },
  { key: 'nav.ueberuns', path: '/ueber-uns/' },
  ...(lang === 'de' ? [{ key: 'nav.ratgeber' as const, path: '/ratgeber/' }] : []),
];
const nav = navDefs.map((n) => ({ label: t(n.key), href: localize(n.path, lang) }));

// "/" (bzw. "/en/") darf nur exakt matchen, sonst wäre die Startseite überall aktiv.
const isActive = (href: string) => path === href || (href !== home && path.startsWith(href));

// Sprachumschalter nur auf zweisprachigen Seiten.
const showLangSwitch = isBilingual(path);
const otherLang = lang === 'de' ? 'en' : 'de';
const switchHref = altPath(path, otherLang);
const kontaktHref = localize('/kontakt/', lang);
---

<header
  id="site-header"
  data-overlay={overlay ? 'true' : undefined}
  class:list={[
    'top-0 right-0 left-0 z-[var(--z-sticky)] transition-colors duration-300',
    overlay ? 'fixed text-paper' : 'sticky border-b border-line bg-bg text-ink',
  ]}
>
  <div class="container-site flex h-20 items-center justify-between gap-8">
    <a href={home} class="site-logo block shrink-0" aria-label={`${SITE.legalName} – ${t('logo.aria')}`}>
      <img
        src="/logo-on-light.png"
        width="403"
        height="300"
        alt={SITE.legalName}
        class="logo-light h-14 w-auto"
      />
      <img
        src="/logo-on-dark.png"
        width="403"
        height="300"
        alt=""
        aria-hidden="true"
        class="logo-dark h-14 w-auto"
      />
    </a>

    <nav aria-label={t('nav.main')} class="hidden lg:block">
      <ul class="flex items-center gap-6 xl:gap-8">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'link-line text-small font-medium',
                isActive(item.href) && 'bg-[length:100%_1px]',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-6 lg:flex">
      {showLangSwitch && (
        <a
          href={switchHref}
          class="lang-switch link-line text-small font-medium tracking-wide uppercase"
          aria-label={t('lang.switchAria')}
        >
          {otherLang}
        </a>
      )}
      <!-- Immer der gefüllte Akzent-Button: bleibt sichtbar, egal ob der
           Header transparent über dem Hero oder weiß nach dem Scrollen ist. -->
      <Button href={kontaktHref} variant="primary" arrow={false} class="header-cta h-11 px-5">
        {t('cta')}
      </Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-2 flex h-12 w-12 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t('menu.open')}
      data-label-open={t('menu.open')}
      data-label-close={t('menu.close')}
    >
      <span class="menu-icon relative block h-3 w-6">
        <span class="absolute top-0 left-0 h-px w-full bg-current transition-transform duration-300"></span>
        <span class="absolute bottom-0 left-0 h-px w-full bg-current transition-transform duration-300"></span>
      </span>
    </button>
  </div>
</header>

<!-- Mobile-Menü: Vollbild in Graphite -->
<div
  id="mobile-menu"
  class="pointer-events-none fixed inset-0 z-[var(--z-overlay)] bg-graphite text-paper opacity-0 transition-opacity duration-300 lg:hidden"
  tabindex="-1"
  hidden
>
  <!-- h-full + overflow-y-auto: passt der Inhalt nicht (kleine Displays),
       wird gescrollt statt gestaucht. shrink-0 verhindert, dass Flexbox das
       Nav zusammendrückt und der CTA-Block sich über die Links legt. -->
  <div class="container-site flex h-full flex-col overflow-y-auto overscroll-contain pt-28 pb-10">
    <nav aria-label={t('nav.mobile')} class="shrink-0">
      <ul class="space-y-2">
        {nav.map((item, i) => (
          <li
            class="mobile-nav-item translate-y-4 opacity-0 transition-all duration-500 ease-[var(--ease-out-expo)]"
            style={`transition-delay: ${80 + i * 50}ms`}
          >
            <a
              href={item.href}
              class:list={[
                'mobile-nav-link font-display text-[2.25rem] leading-tight font-medium',
                isActive(item.href) && 'is-current',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-auto shrink-0 space-y-6 pt-12">
      <Button href={kontaktHref} variant="primary" class="w-full justify-center">
        {t('cta')}
      </Button>
      <div class="flex flex-col gap-1 text-small text-paper-muted">
        <a href={`tel:${SITE.contact.phone}`} class="link-line self-start">{SITE.contact.phoneDisplay}</a>
        <a href={`mailto:${SITE.contact.email}`} class="link-line self-start">{SITE.contact.email}</a>
        {showLangSwitch && (
          <a href={switchHref} class="link-line mt-3 self-start uppercase" aria-label={t('lang.switchAria')}>
            {otherLang === 'en' ? 'English' : 'Deutsch'}
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  /* Overlay-Header wird nach dem ersten Scroll fest und hell */
  #site-header[data-overlay].is-scrolled {
    background: var(--color-bg);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }

  /* Logo-Umschaltung: dunkles Logo auf hellem Grund, helles Logo auf dunklem.
     Standard (weißer Header) zeigt die dunkle Variante. */
  .site-logo .logo-dark {
    display: none;
  }
  /* Über dem Hero (transparent, noch nicht gescrollt): helle Variante */
  #site-header[data-overlay]:not(.is-scrolled) .site-logo .logo-light {
    display: none;
  }
  #site-header[data-overlay]:not(.is-scrolled) .site-logo .logo-dark {
    display: block;
  }
  /* Bei geöffnetem Mobile-Menü ist der Grund dunkel: helle Variante */
  :global(html.menu-open) #site-header .site-logo .logo-light {
    display: none;
  }
  :global(html.menu-open) #site-header .site-logo .logo-dark {
    display: block;
  }

  /* Menü offen: Icon wird zum X */
  #menu-toggle[aria-expanded='true'] .menu-icon span:first-child {
    transform: translateY(5.5px) rotate(45deg);
  }
  #menu-toggle[aria-expanded='true'] .menu-icon span:last-child {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* Aktuelle Seite im Mobile-Menü: Unterstreichung im roten Akzent.
     Sie wächst beim Aufklappen ein (mit der Staffelung der Links) und
     ist ohne Motion einfach sofort da. */
  .mobile-nav-link.is-current {
    background-image: linear-gradient(var(--color-oxide), var(--color-oxide));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 3px;
    padding-bottom: 6px;
    transition: background-size 0.5s var(--ease-out-expo);
    transition-delay: inherit;
  }
  #mobile-menu.is-open .mobile-nav-link.is-current {
    background-size: 100% 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-link.is-current {
      background-size: 100% 3px;
      transition: none;
    }
  }

  #mobile-menu.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  #mobile-menu.is-open .mobile-nav-item {
    transform: none;
    opacity: 1;
  }

  /* Das Menü selbst bekommt beim Öffnen den Fokus (für Screenreader/Tastatur).
     Es ist per tabindex="-1" nicht antippbar, daher hier bewusst kein
     Fokusring – sonst läge ein roter Rahmen um den Container. */
  #mobile-menu:focus,
  #mobile-menu:focus-visible {
    outline: none;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
  /* Menü offen: Header wird transparent, damit der dunkle Menü-Grund
     durchscheint und das helle Logo sichtbar bleibt. Der zweite Selektor
     hat höhere Spezifität als `#site-header[data-overlay].is-scrolled` und
     überschreibt so den weißen Scroll-Hintergrund (sonst weißes Logo auf
     Weiß). Der Menü-Button bleibt über dem Overlay bedienbar. */
  :global(html.menu-open) #site-header,
  :global(html.menu-open) #site-header[data-overlay].is-scrolled {
    z-index: var(--z-modal);
    background: transparent;
    color: var(--color-paper);
    border-color: transparent;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Overlay-Header: fest + hell nach 24px Scroll
  if (header?.dataset.overlay) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Mobile-Menü
  if (toggle && menu) {
    const labelOpen = toggle.dataset.labelOpen || 'Menü öffnen';
    const labelClose = toggle.dataset.labelClose || 'Menü schließen';
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? labelClose : labelOpen);
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
        // Fokus auf den Menü-Container statt auf den ersten Link: Screenreader
        // und Tastatur landen weiterhin im Menü, aber kein Link bekommt einen
        // sichtbaren Fokusring (der sonst als rotes Rechteck erschien).
        menu.focus({ preventScroll: true });
      } else {
        menu.classList.remove('is-open');
        window.setTimeout(() => {
          menu.hidden = true;
        }, 300);
        toggle.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>
