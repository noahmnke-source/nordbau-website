---
import Button from '@/components/Button.astro';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import { getLang, localize, altPath, isBilingual, useT } from '@/i18n';

interface Props {
  /** true: startet transparent über dunklem Hero, wird beim Scrollen fest */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const lang = getLang(path);
const t = useT(lang);

const home = localize('/', lang);

// Die beiden Klappmenüs speisen sich direkt aus den Inhaltsordnern – neue
// Häuser oder Bauaufgaben erscheinen ohne Änderung an dieser Datei.
const haeuser = (
  lang === 'en' ? await getCollection('haeuserEn') : await getCollection('haeuser')
).sort((a, b) => a.data.order - b.data.order);
const bauten = (
  lang === 'en' ? await getCollection('bautenEn') : await getCollection('bauten')
).sort((a, b) => a.data.order - b.data.order);

type NavEintrag =
  | { art: 'link'; label: string; href: string }
  | { art: 'gruppe'; id: string; label: string; basis: string; punkte: { label: string; href: string; hinweis: string }[] };

const nav: NavEintrag[] = [
  {
    art: 'gruppe',
    id: 'haeuser',
    label: t('nav.haeuser'),
    basis: localize('/haeuser/', lang),
    punkte: haeuser.map((e) => ({
      label: e.data.name,
      href: localize(`/haeuser/${e.id}/`, lang),
      hinweis: e.data.tagline,
    })),
  },
  {
    art: 'gruppe',
    id: 'bauten',
    label: t('nav.wohnGewerbe'),
    basis: localize('/wohn-und-gewerbebau/', lang),
    punkte: bauten.map((e) => ({
      label: e.data.name,
      href: localize(`/wohn-und-gewerbebau/${e.id}/`, lang),
      hinweis: e.data.tagline,
    })),
  },
  { art: 'link', label: t('nav.weg'), href: localize('/weg-zum-traumhaus/', lang) },
  { art: 'link', label: t('nav.ueberuns'), href: localize('/ueber-uns/', lang) },
  ...(lang === 'de'
    ? [{ art: 'link' as const, label: t('nav.ratgeber'), href: '/ratgeber/' }]
    : []),
];

const isActive = (href: string) => path === href || (href !== home && path.startsWith(href));
const gruppeAktiv = (basis: string) => path.startsWith(basis);

const showLangSwitch = isBilingual(path);
const otherLang = lang === 'de' ? 'en' : 'de';
const switchHref = altPath(path, otherLang);
const kontaktHref = localize('/kontakt/', lang);
---

<header
  id="site-header"
  data-overlay={overlay ? 'true' : undefined}
  class:list={[
    'top-0 right-0 left-0 z-[var(--z-sticky)] transition-colors duration-300',
    overlay ? 'fixed text-paper' : 'sticky border-b border-line bg-bg text-ink',
  ]}
>
  <div class="container-site flex h-20 items-center justify-between gap-6">
    <a href={home} class="site-logo block shrink-0" aria-label={`${SITE.legalName} – ${t('logo.aria')}`}>
      <img
        src="/logo-on-light.png"
        width="403"
        height="300"
        alt={SITE.legalName}
        class="logo-light h-14 w-auto"
      />
      <img
        src="/logo-on-dark.png"
        width="403"
        height="300"
        alt=""
        aria-hidden="true"
        class="logo-dark h-14 w-auto"
      />
    </a>

    <nav aria-label={t('nav.main')} class="hidden lg:block">
      <ul class="flex items-center gap-5 xl:gap-7">
        {nav.map((item) =>
          item.art === 'link' ? (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'link-line text-small font-medium whitespace-nowrap',
                  isActive(item.href) && 'bg-[length:100%_1px]',
                ]}
              >
                {item.label}
              </a>
            </li>
          ) : (
            <li class="menu-gruppe relative" data-menu={item.id}>
              <button
                type="button"
                class:list={[
                  'menu-knopf flex items-center gap-1.5 text-small font-medium whitespace-nowrap',
                  gruppeAktiv(item.basis) && 'is-current',
                ]}
                aria-expanded="false"
                aria-controls={`menu-${item.id}`}
              >
                <span class="menu-knopf-text">{item.label}</span>
                <svg class="menu-pfeil h-2.5 w-2.5" viewBox="0 0 10 6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </button>

              <div
                id={`menu-${item.id}`}
                class="menu-panel absolute top-full left-1/2 z-10 w-[22rem] -translate-x-1/2 pt-4"
                hidden
              >
                <ul class="border border-line bg-bg p-2 text-ink shadow-[0_18px_48px_-24px_rgb(0_0_0/0.35)]">
                  {item.punkte.map((p, i) => (
                    <li>
                      <a
                        href={p.href}
                        class:list={[
                          'menu-eintrag block px-4 py-3 transition-colors duration-200',
                          isActive(p.href) && 'is-current',
                        ]}
                        style={`--eintrag-delay:${i * 35}ms`}
                        aria-current={isActive(p.href) ? 'page' : undefined}
                      >
                        <span class="block font-display text-body font-medium">{p.label}</span>
                        <span class="mt-0.5 block text-caption leading-snug text-muted">
                          {p.hinweis}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      {showLangSwitch && (
        <a
          href={switchHref}
          class="lang-switch link-line text-small font-medium tracking-wide uppercase"
          aria-label={t('lang.switchAria')}
        >
          {otherLang}
        </a>
      )}
      <Button href={kontaktHref} variant="primary" arrow={false} class="header-cta h-11 px-5">
        {t('cta')}
      </Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-2 flex h-12 w-12 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t('menu.open')}
      data-label-open={t('menu.open')}
      data-label-close={t('menu.close')}
    >
      <span class="menu-icon relative block h-3 w-6">
        <span class="absolute top-0 left-0 h-px w-full bg-current transition-transform duration-300"></span>
        <span class="absolute bottom-0 left-0 h-px w-full bg-current transition-transform duration-300"></span>
      </span>
    </button>
  </div>
</header>

<!-- Mobile-Menü: Vollbild in Graphite, Gruppen als Ziehharmonika -->
<div
  id="mobile-menu"
  class="pointer-events-none fixed inset-0 z-[var(--z-overlay)] bg-graphite text-paper opacity-0 transition-opacity duration-300 lg:hidden"
  tabindex="-1"
  hidden
>
  <div class="container-site flex h-full flex-col overflow-y-auto overscroll-contain pt-28 pb-10">
    <nav aria-label={t('nav.mobile')} class="shrink-0">
      <ul class="space-y-1">
        <li
          class="mobile-nav-item translate-y-4 opacity-0 transition-all duration-500 ease-[var(--ease-out-expo)]"
          style="transition-delay: 80ms"
        >
          <a
            href={home}
            class:list={[
              'mobile-nav-link font-display text-[2rem] leading-tight font-medium',
              path === home && 'is-current',
            ]}
          >
            {t('nav.home')}
          </a>
        </li>
        {nav.map((item, i) => (
          <li
            class="mobile-nav-item translate-y-4 opacity-0 transition-all duration-500 ease-[var(--ease-out-expo)]"
            style={`transition-delay: ${130 + i * 50}ms`}
          >
            {item.art === 'link' ? (
              <a
                href={item.href}
                class:list={[
                  'mobile-nav-link font-display text-[2rem] leading-tight font-medium',
                  isActive(item.href) && 'is-current',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ) : (
              <div class="mobil-gruppe" data-mobil-gruppe>
                <button
                  type="button"
                  class="mobil-knopf flex w-full items-center justify-between gap-4 py-1 text-left"
                  aria-expanded="false"
                  aria-controls={`mobil-${item.id}`}
                >
                  <span class="font-display text-[2rem] leading-tight font-medium">
                    {item.label}
                  </span>
                  <span class="mobil-plus relative block h-4 w-4 shrink-0" aria-hidden="true">
                    <span class="absolute top-1/2 left-0 h-px w-full -translate-y-1/2 bg-current"></span>
                    <span
                      class="mobil-plus-strich absolute top-0 left-1/2 h-full w-px -translate-x-1/2 bg-current transition-transform duration-300"
                    ></span>
                  </span>
                </button>
                <ul id={`mobil-${item.id}`} class="mobil-liste space-y-3 overflow-hidden pl-1" hidden>
                  {item.punkte.map((p) => (
                    <li>
                      <a
                        href={p.href}
                        class:list={[
                          'mobil-eintrag link-line text-body text-paper-muted',
                          isActive(p.href) && 'text-paper',
                        ]}
                        aria-current={isActive(p.href) ? 'page' : undefined}
                      >
                        {p.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-auto shrink-0 space-y-6 pt-12">
      <Button href={kontaktHref} variant="primary" class="w-full justify-center">
        {t('cta')}
      </Button>
      <div class="flex flex-col gap-1 text-small text-paper-muted">
        <a href={`tel:${SITE.contact.phone}`} class="link-line self-start">{SITE.contact.phoneDisplay}</a>
        <a href={`mailto:${SITE.contact.email}`} class="link-line self-start">{SITE.contact.email}</a>
        {showLangSwitch && (
          <a href={switchHref} class="link-line mt-3 self-start uppercase" aria-label={t('lang.switchAria')}>
            {otherLang === 'en' ? 'English' : 'Deutsch'}
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  /* Overlay-Header wird nach dem ersten Scroll fest und hell */
  #site-header[data-overlay].is-scrolled {
    background: var(--color-bg);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }

  .site-logo .logo-dark {
    display: none;
  }
  #site-header[data-overlay]:not(.is-scrolled) .site-logo .logo-light {
    display: none;
  }
  #site-header[data-overlay]:not(.is-scrolled) .site-logo .logo-dark {
    display: block;
  }
  :global(html.menu-open) #site-header .site-logo .logo-light {
    display: none;
  }
  :global(html.menu-open) #site-header .site-logo .logo-dark {
    display: block;
  }

  /* ── Klappmenü (Desktop) ─────────────────────────────────────
     Der Knopf trägt dieselbe wachsende Unterstreichung wie die
     übrigen Navigationslinks – nur auf den Text, nicht auf den Pfeil. */
  .menu-knopf-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.4s var(--ease-out-expo);
    padding-bottom: 2px;
  }
  .menu-gruppe:hover .menu-knopf-text,
  .menu-knopf:focus-visible .menu-knopf-text,
  .menu-knopf[aria-expanded='true'] .menu-knopf-text,
  .menu-knopf.is-current .menu-knopf-text {
    background-size: 100% 1px;
  }

  .menu-pfeil {
    transition: transform 0.3s var(--ease-out-expo);
  }
  .menu-knopf[aria-expanded='true'] .menu-pfeil {
    transform: rotate(180deg);
  }

  /* Auf-/Zublenden: leicht angehoben und weich eingeblendet. */
  .menu-panel {
    opacity: 0;
    transform: translate(-50%, -6px);
    transition:
      opacity 0.28s var(--ease-out-expo),
      transform 0.28s var(--ease-out-expo);
  }
  .menu-panel.is-open {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Die Einträge laufen gestaffelt nach – der Effekt, der ein Menü
     wertig wirken lässt, ohne den Nutzer aufzuhalten. */
  .menu-eintrag {
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s var(--ease-out-expo),
      transform 0.3s var(--ease-out-expo),
      background-color 0.2s ease;
    transition-delay: var(--eintrag-delay, 0ms);
  }
  .menu-panel.is-open .menu-eintrag {
    opacity: 1;
    transform: none;
  }
  .menu-eintrag:hover,
  .menu-eintrag:focus-visible {
    background: var(--color-stone);
  }
  .menu-eintrag.is-current {
    background: var(--color-stone);
  }

  /* Menü offen: Icon wird zum X */
  #menu-toggle[aria-expanded='true'] .menu-icon span:first-child {
    transform: translateY(5.5px) rotate(45deg);
  }
  #menu-toggle[aria-expanded='true'] .menu-icon span:last-child {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  .mobile-nav-link.is-current {
    background-image: linear-gradient(var(--color-oxide), var(--color-oxide));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 3px;
    padding-bottom: 6px;
    transition: background-size 0.5s var(--ease-out-expo);
    transition-delay: inherit;
  }
  #mobile-menu.is-open .mobile-nav-link.is-current {
    background-size: 100% 3px;
  }

  /* Ziehharmonika im Mobile-Menü */
  .mobil-knopf[aria-expanded='true'] .mobil-plus-strich {
    transform: translateX(-50%) scaleY(0);
  }
  .mobil-liste {
    padding-top: 0.75rem;
    padding-bottom: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-link.is-current {
      background-size: 100% 3px;
      transition: none;
    }
    .menu-panel,
    .menu-eintrag {
      transition: none;
    }
  }

  #mobile-menu.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  #mobile-menu.is-open .mobile-nav-item {
    transform: none;
    opacity: 1;
  }

  #mobile-menu:focus,
  #mobile-menu:focus-visible {
    outline: none;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
  :global(html.menu-open) #site-header,
  :global(html.menu-open) #site-header[data-overlay].is-scrolled {
    z-index: var(--z-modal);
    background: transparent;
    color: var(--color-paper);
    border-color: transparent;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Overlay-Header: fest + hell nach 24px Scroll
  if (header?.dataset.overlay) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // ── Klappmenüs im Desktop-Header ───────────────────────────────
  // Zeigegeräte öffnen beim Überfahren, Tastatur und Touch per Klick.
  // Ein kurzer Verzögerer beim Verlassen verhindert, dass das Menü
  // zuklappt, während die Maus die Lücke zum Panel überquert.
  const gruppen = Array.from(document.querySelectorAll<HTMLElement>('.menu-gruppe'));
  const feinzeiger = window.matchMedia('(hover: hover) and (pointer: fine)');

  gruppen.forEach((gruppe) => {
    const knopf = gruppe.querySelector<HTMLButtonElement>('.menu-knopf');
    const panel = gruppe.querySelector<HTMLElement>('.menu-panel');
    if (!knopf || !panel) return;
    let schliessTimer = 0;

    const setzen = (offen: boolean) => {
      window.clearTimeout(schliessTimer);
      knopf.setAttribute('aria-expanded', String(offen));
      if (offen) {
        gruppen.forEach((a) => {
          if (a !== gruppe) a.dispatchEvent(new CustomEvent('menu:zu'));
        });
        panel.hidden = false;
        requestAnimationFrame(() => panel.classList.add('is-open'));
      } else {
        panel.classList.remove('is-open');
        schliessTimer = window.setTimeout(() => {
          panel.hidden = true;
        }, 280);
      }
    };

    gruppe.addEventListener('menu:zu', () => setzen(false));

    knopf.addEventListener('click', () => {
      setzen(knopf.getAttribute('aria-expanded') !== 'true');
    });

    gruppe.addEventListener('mouseenter', () => {
      if (feinzeiger.matches) setzen(true);
    });
    gruppe.addEventListener('mouseleave', () => {
      if (!feinzeiger.matches) return;
      window.clearTimeout(schliessTimer);
      schliessTimer = window.setTimeout(() => setzen(false), 140);
    });

    // Tastatur: verlässt der Fokus die Gruppe, schließt das Menü.
    gruppe.addEventListener('focusout', (e) => {
      const ziel = e.relatedTarget as Node | null;
      if (!ziel || !gruppe.contains(ziel)) setzen(false);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const offen = document.querySelector<HTMLElement>('.menu-gruppe .menu-knopf[aria-expanded="true"]');
    if (offen) {
      offen.closest('.menu-gruppe')?.dispatchEvent(new CustomEvent('menu:zu'));
      offen.focus();
    }
  });

  document.addEventListener('click', (e) => {
    const ziel = e.target as Node;
    gruppen.forEach((gruppe) => {
      if (!gruppe.contains(ziel)) gruppe.dispatchEvent(new CustomEvent('menu:zu'));
    });
  });

  // ── Ziehharmonika im Mobile-Menü ───────────────────────────────
  document.querySelectorAll<HTMLElement>('[data-mobil-gruppe]').forEach((gruppe) => {
    const knopf = gruppe.querySelector<HTMLButtonElement>('.mobil-knopf');
    const liste = gruppe.querySelector<HTMLElement>('.mobil-liste');
    if (!knopf || !liste) return;
    knopf.addEventListener('click', () => {
      const offen = knopf.getAttribute('aria-expanded') === 'true';
      knopf.setAttribute('aria-expanded', String(!offen));
      liste.hidden = offen;
    });
  });

  // ── Mobile-Menü ────────────────────────────────────────────────
  if (toggle && menu) {
    const labelOpen = toggle.dataset.labelOpen || 'Menü öffnen';
    const labelClose = toggle.dataset.labelClose || 'Menü schließen';
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? labelClose : labelOpen);
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
        menu.focus({ preventScroll: true });
      } else {
        menu.classList.remove('is-open');
        window.setTimeout(() => {
          menu.hidden = true;
        }, 300);
        toggle.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>
