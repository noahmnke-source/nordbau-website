---
import { unsplashSrcset, unsplashWidth, isProjektBild, projektSrcset } from '@/lib/img';

interface Props {
  src: string;
  alt: string;
  /** sizes-Attribut, z. B. "(min-width: 1024px) 60vw, 100vw" */
  sizes?: string;
  /** Seitenverhältnis als Tailwind-Klasse, z. B. "aspect-[3/2]" */
  ratio?: string;
  eager?: boolean;
  /** Scroll-Reveal (Clip von unten) */
  reveal?: boolean;
  /** Ruhiger Zoom bei Hover (Elternteil braucht .group) */
  zoom?: boolean;
  /** Sanfter Scroll-Parallax: Geschwindigkeit (z. B. 0.06) oder false */
  parallax?: number | false;
  class?: string;
  caption?: string;
}

const {
  src,
  alt,
  sizes = '100vw',
  ratio = 'aspect-[3/2]',
  eager = false,
  reveal = true,
  zoom = false,
  parallax = false,
  class: className = '',
  caption,
} = Astro.props;

const isUnsplash = src.startsWith('https://images.unsplash.com/');
const isProjekt = isProjektBild(src);

// Unsplash-Stand-ins und eigene Projektfotos liefern beide ein srcset;
// lokale Einzelbilder ohne Varianten fallen auf den nackten src zurück.
const srcset = isUnsplash ? unsplashSrcset(src) : isProjekt ? projektSrcset(src) : undefined;
---

<figure
  class:list={[className, parallax !== false && 'parallax']}
  data-parallax={parallax !== false ? String(parallax) : undefined}
>
  <div class:list={['overflow-hidden bg-stone', ratio, reveal && 'reveal-media']}>
    <img
      src={isUnsplash ? unsplashWidth(src, 1600) : src}
      srcset={srcset}
      sizes={srcset ? sizes : undefined}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : undefined}
      class:list={['h-full w-full object-cover', zoom && 'img-zoom']}
    />
  </div>
  {caption && (
    <figcaption class="mt-3 text-caption text-muted">{caption}</figcaption>
  )}
</figure>
