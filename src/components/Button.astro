---
interface Props {
  href: string;
  /**
   * primary  – Oxide-Fläche, weißer Text (der eine CTA pro Viewport)
   * secondary – Ink-Hairline auf hellem Grund
   * inverted – für Graphite-Sektionen: Paper-Hairline, heller Text
   */
  variant?: 'primary' | 'secondary' | 'inverted';
  /** Pfeil rechts, nudged bei Hover */
  arrow?: boolean;
  class?: string;
}

const { href, variant = 'primary', arrow = true, class: className = '' } = Astro.props;

const base =
  'group/btn inline-flex h-12 items-center gap-3 px-6 text-small font-medium transition-colors duration-300';

const variants = {
  primary: 'bg-oxide text-white hover:bg-oxide-deep',
  secondary: 'border border-ink/30 text-ink hover:border-ink hover:bg-ink hover:text-paper',
  inverted: 'border border-paper/30 text-paper hover:border-paper hover:bg-paper hover:text-ink',
};
---

<a href={href} class:list={[base, variants[variant], className]}>
  <slot />
  {arrow && (
    <svg
      class="h-4 w-4 transition-transform duration-300 ease-[var(--ease-out-quart)] group-hover/btn:translate-x-1"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M1 8h13M9 3l5 5-5 5" />
    </svg>
  )}
</a>
