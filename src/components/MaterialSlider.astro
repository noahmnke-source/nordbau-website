---
/**
 * „Aufbau & Materialien" – Slider mit Wandschnitten (Holztafelbau).
 * Adaptiert von der Sektion „Structure and Materials We Use" auf treehouse-ks.eu.
 *
 * ── PLATZHALTER-BILDER ───────────────────────────────────────
 * Die Renderings unter public/wandaufbau/ stammen von treehouse-ks.eu und
 * sind nicht zur Weiternutzung lizenziert. Vor dem echten Launch durch eigene
 * Nordbau-Wandschnitte ersetzen (gleiche Dateinamen genügen).
 * ─────────────────────────────────────────────────────────────
 *
 * Der Track ist nativ horizontal scrollbar (funktioniert ohne JS); die Pfeile
 * sind Enhancement. Scroll-Snap, Tastatur-fokussierbar, reduced-motion-sicher.
 */
interface Props {
  /** zusätzliche Klassen für die Sektion (z. B. bg-stone) */
  class?: string;
}
const { class: className = '' } = Astro.props;

const slides = [
  { src: '/wandaufbau/aussenwand.webp', caption: 'Außenwand mit Holzfassade' },
  { src: '/wandaufbau/innenwand.webp', caption: 'Innenwand' },
  { src: '/wandaufbau/detail-aussen.webp', caption: 'Wandaufbau – Außenseite' },
  { src: '/wandaufbau/detail-innen.webp', caption: 'Wandaufbau – Innenseite' },
  { src: '/wandaufbau/osb-aussen.webp', caption: 'Beplankung außen (OSB)' },
  { src: '/wandaufbau/osb-innen.webp', caption: 'Beplankung innen (OSB)' },
  { src: '/wandaufbau/statische-wand.webp', caption: 'Tragende Wand' },
  { src: '/wandaufbau/massivholzwand.webp', caption: 'Massivholzwand' },
];
---

<section class:list={['material-slider py-(--spacing-section)', className]}>
  <div class="container-site">
    <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h2 class="reveal font-display text-display font-medium">Aufbau &amp; Materialien</h2>
        <p class="reveal prose-measure mt-6 text-body text-muted">
          Eine Nordbau-Wand ist kein massiver Klotz, sondern ein durchdachter Aufbau aus
          mehreren Schichten – von der Gipsfaserplatte innen über Ständerwerk und Dämmung
          bis zur Fassade. Tragende Bauteile fertigen wir aus Konstruktionsvollholz und
          Brettsperrholz (Cross-Laminated Timber, CLT); alle wesentlichen Materialien kommen
          mit Qualitätszertifikat. Zusammen ergeben sie eine hochgedämmte, luftdichte Hülle
          im Effizienzhaus-40-Standard.
        </p>
      </div>

      <!-- Pfeile (Enhancement; ohne JS lässt sich der Track direkt wischen/scrollen) -->
      <div class="flex gap-3 lg:col-span-4 lg:col-start-9 lg:justify-end">
        <button
          type="button"
          class="slider-prev flex h-12 w-12 items-center justify-center border border-ink/25 transition-colors hover:border-ink hover:bg-ink hover:text-paper"
          aria-label="Vorheriges Bild"
        >
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 8H2M7 3L2 8l5 5" /></svg>
        </button>
        <button
          type="button"
          class="slider-next flex h-12 w-12 items-center justify-center border border-ink/25 transition-colors hover:border-ink hover:bg-ink hover:text-paper"
          aria-label="Nächstes Bild"
        >
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" /></svg>
        </button>
      </div>
    </div>

    <div
      class="slider-track mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      tabindex="0"
      role="region"
      aria-label="Wandaufbau – Bildergalerie zum Durchblättern"
    >
      {slides.map((s) => (
        <figure class="slider-slide w-[78%] shrink-0 snap-start sm:w-[46%] lg:w-[31%]">
          <div class="flex aspect-[4/5] items-center justify-center border border-line bg-bg p-6">
            <img src={s.src} alt={`Wandschnitt: ${s.caption}`} loading="lazy" decoding="async" class="h-full w-full object-contain" />
          </div>
          <figcaption class="mt-3 text-caption text-muted">{s.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.material-slider').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('.slider-track');
    const slide = slider.querySelector<HTMLElement>('.slider-slide');
    const prev = slider.querySelector<HTMLButtonElement>('.slider-prev');
    const next = slider.querySelector<HTMLButtonElement>('.slider-next');
    if (!track || !slide || !prev || !next) return;

    const step = () => slide.getBoundingClientRect().width + 24; // gap-6 = 24px
    const scrollBy = (dir: number) =>
      track.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' });

    prev.addEventListener('click', () => scrollBy(-1));
    next.addEventListener('click', () => scrollBy(1));

    // Pfeile ausgrauen, wenn Anfang/Ende erreicht ist
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      prev.disabled = track.scrollLeft <= 0;
      next.disabled = track.scrollLeft >= max;
      prev.classList.toggle('opacity-30', prev.disabled);
      next.classList.toggle('opacity-30', next.disabled);
    };
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  });
</script>
