---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { SITE } from '@/config/site';
import { getLang, altPath, isBilingual, localize, useT } from '@/i18n';

interface Breadcrumb {
  name: string;
  href: string;
}

interface Props {
  /** Seitentitel ohne Suffix; Suffix wird automatisch angehängt */
  title: string;
  description: string;
  /** Voller Titel ohne Suffix (z. B. Startseite) */
  fullTitle?: boolean;
  ogImage?: string;
  /** Header startet transparent über einem dunklen Hero */
  heroOverlay?: boolean;
  breadcrumbs?: Breadcrumb[];
  /** Zusätzliche JSON-LD-Objekte (z. B. FAQPage) */
  jsonLd?: Record<string, unknown>[];
  noIndex?: boolean;
  /** Footer-Abschluss-CTA ausblenden (wenn die Seite bereits einen eigenen hat) */
  hideFooterCta?: boolean;
}

const {
  title,
  description,
  fullTitle = false,
  ogImage = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80',
  heroOverlay = false,
  breadcrumbs,
  jsonLd = [],
  noIndex = false,
  hideFooterCta = false,
} = Astro.props;

const lang = getLang(Astro.url.pathname);
const t = useT(lang);

const pageTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;

// Organisation als @graph mit WebSite-Knoten; Typwahl und Felder nach
// Google-Doku-Recherche (docs/research/jsonld.json). Kein aggregateRating
// (self-serving) und kein LocalBusiness ohne echte Standortadresse.
const organizationLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['HomeAndConstructionBusiness', 'GeneralContractor'],
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      legalName: SITE.legalName,
      alternateName: SITE.name,
      url: `${SITE.url}/`,
      logo: {
        '@type': 'ImageObject',
        '@id': `${SITE.url}/#logo`,
        url: `${SITE.url}/logo-on-light.png`,
        caption: SITE.legalName,
      },
      description:
        lang === 'en'
          ? 'Designs and builds turnkey, individually planned timber-frame prefab homes across Germany – to Efficiency House 40 standard and with a fixed-price guarantee.'
          : 'Plant und baut schlüsselfertige und individuell geplante Fertighäuser in Holztafelbauweise – bundesweit, im Effizienzhaus-40-Standard und mit Festpreisgarantie.',
      slogan: SITE.claim,
      foundingDate: String(SITE.foundingYear),
      vatID: SITE.legal.vatId,
      taxID: SITE.legal.taxNumber,
      telephone: SITE.contact.phone,
      email: SITE.contact.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.contact.street,
        postalCode: SITE.contact.zip,
        addressLocality: SITE.contact.city,
        addressCountry: 'DE',
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'sales',
          telephone: SITE.contact.phone,
          email: SITE.contact.email,
          availableLanguage: ['de', 'en'],
          areaServed: 'DE',
        },
      ],
      areaServed: {
        '@type': 'Country',
        name: 'Deutschland',
        sameAs: 'https://www.wikidata.org/wiki/Q183',
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: lang === 'en' ? 'Services' : 'Leistungen',
        itemListElement: [
          ['Schlüsselfertiges Fertighaus', 'Planung und Bau schlüsselfertiger Fertighäuser in Holztafelbauweise, bundesweit, mit Festpreisgarantie.'],
          ['Individuell geplantes Architektenhaus', 'Frei entworfene Ein- und Zweifamilienhäuser in Holztafelbauweise nach individueller Planung.'],
          ['Bungalow', 'Ebenerdige, barrierearme Häuser als Fertighaus.'],
          ['Mehrfamilienhaus', 'Mehrfamilienhäuser in Holztafelbauweise als Fertighaus.'],
          ['Tiny House', 'Kompakte Häuser im Effizienzhaus-40-Standard.'],
          ['Modulhaus', 'Werkseitig vorgefertigte, erweiterbare Modulhäuser.'],
          ['Hochbau', 'Schlüsselfertiger Hochbau für Wohn-, Büro-, Gewerbe- und öffentliche Bauten, als Nachunternehmer für Bauunternehmen.'],
          ['Rohbau', 'Rohbauarbeiten in Stahlbetonbauweise für Wohn-, Büro-, Gewerbe- und öffentliche Bauten, als Nachunternehmer für Bauunternehmen.'],
          ['Schlüsselfertigbau', 'Rohbau und sämtliche Ausbaugewerke aus einer Hand, auch unter medizinischen und brandschutztechnischen Auflagen.'],
          ['Tiefbau', 'Erd-, Gründungs- und Entwässerungsarbeiten, auch bei laufendem Betrieb.'],
        ].map(([name, beschreibung]) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name, description: beschreibung },
        })),
      },
      knowsAbout: [
        'Fertighaus',
        'Schlüsselfertiges Bauen',
        'Holztafelbau',
        'Effizienzhaus 40',
        'Individuelle Architektenhäuser',
        'KfW-Förderung',
        'Hochbau',
        'Rohbau',
        'Stahlbetonbau',
        'Schlüsselfertigbau',
        'Innenausbau',
        'Tiefbau',
        'Nachunternehmerleistungen',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      inLanguage: lang === 'en' ? 'en' : 'de-DE',
      publisher: { '@id': `${SITE.url}/#organization` },
    },
  ],
};

const breadcrumbLd = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('nav.home'), item: `${SITE.url}${localize('/', lang)}` },
        ...breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: crumb.name,
          item: new URL(crumb.href, SITE.url).href,
        })),
      ],
    }
  : null;

const allJsonLd = [organizationLd, breadcrumbLd, ...jsonLd].filter(Boolean);

// hreflang nur auf zweisprachigen Seiten (Impressum/Datenschutz/Ratgeber bleiben einsprachig).
const alternates = isBilingual(Astro.url.pathname)
  ? [
      { hreflang: 'de', href: new URL(altPath(Astro.url.pathname, 'de'), SITE.url).href },
      { hreflang: 'en', href: new URL(altPath(Astro.url.pathname, 'en'), SITE.url).href },
      { hreflang: 'x-default', href: new URL(altPath(Astro.url.pathname, 'de'), SITE.url).href },
    ]
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noIndex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#26221f" />

    <link rel="preload" href="/fonts/Boska-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Remote-Bilder (Unsplash-Stand-ins) früh verbinden – beschleunigt LCP -->
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'de_DE'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {allJsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <!-- Früh, damit Reveal-Startzustände nur mit JS greifen (kein FOUC, kein leerer Inhalt ohne JS) -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[var(--z-toast)] focus:bg-oxide focus:px-5 focus:py-3 focus:text-small focus:font-medium focus:text-white"
    >
      {t('skip')}
    </a>

    <Header overlay={heroOverlay} />

    <main id="inhalt">
      <slot />
    </main>

    <Footer showCta={!hideFooterCta} />

    <script>
      // Scroll-Reveals: sichtbarer Default, JS veredelt nur.
      const revealTargets = document.querySelectorAll('.reveal, .reveal-media');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion) {
        revealTargets.forEach((el) => el.classList.add('is-visible'));
      } else if (revealTargets.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        revealTargets.forEach((el) => observer.observe(el));
      }

      // Sanfter Scroll-Parallax auf ausgewählten Bildern.
      // Adaptiert von den Elementor-Motion-Effekten auf treehouse-ks.eu –
      // deutlich zurückgenommen, nur transform, reduced-motion-sicher.
      const parallaxEls = Array.from(
        document.querySelectorAll<HTMLElement>('[data-parallax]')
      );
      if (!reduceMotion && parallaxEls.length) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          for (const el of parallaxEls) {
            const rect = el.getBoundingClientRect();
            if (rect.bottom < -200 || rect.top > vh + 200) continue;
            const speed = parseFloat(el.dataset.parallax || '0') || 0;
            const centerOffset = rect.top + rect.height / 2 - vh / 2;
            const shift = -(centerOffset / vh) * speed * 100;
            el.style.setProperty('--parallax-y', `${shift.toFixed(1)}px`);
          }
          ticking = false;
        };
        const onScroll = () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      }
    </script>
    <ConsentBanner />
  </body>
</html>
